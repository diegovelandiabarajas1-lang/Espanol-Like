# ============================================================================
#  comparar/n.esl — las seis pruebas de la comparación entre lenguajes, en Ñ
#
#    node motor-exp/util/n-node.js c1en/comparar/n.esl DISPOSITIVO [ESCALA]
#        DISPOSITIVO: jit | nativo | gpu        ESCALA: normal | chica
#
#  Las mismas seis pruebas, con los MISMOS datos, que los programas de los otros
#  lenguajes de esta carpeta (ver LEEME.md): los datos salen de una fórmula, no
#  del azar, para que la «huella» (un resumen del resultado) se pueda comparar
#  entre lenguajes.
#
#    matmul    C = A·B, n×n            A[i,j] = ((7i + 3j) mód 13)/13 − 0.5
#                                       B[i,j] = ((5i + 11j) mód 17)/17 − 0.5
#    seno      sin(x), 2^24 números    x[i] = (i mód 1000)/1000
#    x*2+1     x·2 + 1
#    suma      Σx
#    softmax   por filas, 4096×1024    S[i,j] = ((3i + j) mód 50)/10
#    fft       2^20 números            los primeros 2^20 de x
#
#  Cada prueba: una vez para calentar y la mejor de 3. Los datos ya están en el
#  dispositivo y el resultado se queda allí (en la GPU, residente): lo mismo que
#  los demás, que sincronizan la GPU y no copian el resultado a la CPU.
#
#  Salida, una línea por prueba:  RES,prueba,tamaño,dispositivo,ms,huella,precision
# ============================================================================
usar paralelo, usarDispositivo, ceros, suma, por, senoA, softmax, fourier, absolutoA de "nen"

fijo a = argumentos()
var DISP = "nativo"
var ESCALA = "normal"
si longitud(a) > 0 { DISP = a[0] }
si longitud(a) > 1 { ESCALA = a[1] }
usarDispositivo(DISP)

fn llenarA(i, n, m) {
    var f = i // n
    var c = i % n
    m[i] = ((f * 7 + c * 3) % 13) / 13.0 - 0.5
}
fn llenarB(i, n, m) {
    var f = i // n
    var c = i % n
    m[i] = ((f * 5 + c * 11) % 17) / 17.0 - 0.5
}
fn llenarX(i, x) {
    x[i] = (i % 1000) / 1000.0
}
fn llenarS(i, k, s) {
    var f = i // k
    var c = i % k
    s[i] = ((f * 3 + c) % 50) / 10.0
}

fn medir(prueba: texto, tam: texto, f, h) {
    var r = f()
    var mejor = 1.0e300
    para k en rango(3) {
        var t0 = reloj()
        r = f()
        var t = reloj() - t0
        si t < mejor { mejor = t }
    }
    imprimir("RES," + prueba + "," + tam + "," + DISP + "," + texto(mejor) + "," + texto(h(r)) + ",f64")
}
fn sumar(r) { devolver suma(r) }

var NS = [1024, 2048]
var NV = 16777216
var SM = 4096
var SK = 1024
var NF = 1048576
si ESCALA == "chica" {
    NS = [128, 256]
    NV = 65536
    SM = 256
    NF = 16384
}

para n en NS {
    fijo A = ceros([n, n])
    fijo B = ceros([n, n])
    paralelo(n * n, llenarA, n, A)
    paralelo(n * n, llenarB, n, B)
    medir("matmul", texto(n), fn() { devolver por(A, B) }, sumar)
}
fijo x = ceros(NV)
paralelo(NV, llenarX, x)
medir("seno", texto(NV), fn() { devolver senoA(x) }, sumar)
medir("x*2+1", texto(NV), fn() { devolver x * 2 + 1 }, sumar)
medir("suma", texto(NV), fn() { devolver suma(x) }, fn(r) { devolver r })
fijo S = ceros([SM, SK])
paralelo(SM * SK, llenarS, SK, S)
medir("softmax", texto(SM) + "x" + texto(SK), fn() { devolver softmax(S) }, fn(r) { devolver suma(r * r) })
fijo xf = ceros(NF)
paralelo(NF, llenarX, xf)
medir("fft", texto(NF), fn() { devolver fourier(xf) }, fn(r) { devolver suma(absolutoA(r)) })
