usar fecha, fechaHora, aFecha, desdeMarca, anio, mes, dia, hora, minuto, segundo, diaSemana, trimestre, diaDelAnio, semana de "fecha"
usar nombreMes, nombreDia, mesCorto, diaCorto, sumarSegundos, sumarMinutos, sumarHoras, sumarDias, sumarSemanas, sumarMeses, sumarAnios de "fecha"
usar inicioDia, finDia, inicioSemana, finSemana, inicioMes, finMes, inicioAnio, finAnio de "fecha"
usar segundosEntre, minutosEntre, horasEntre, diasEntre, mesesEntre, aniosEntre, duracion de "fecha"
usar esBisiesto, diasDelMes, esFinDeSemana, esMismoDia, estaEntre, esAntesDe, esDespuesDe, deFecha, aIso, aMarca, hoy de "fecha"
usar debeSerMayor de "probar"

fn ident(v) { devolver v }
fijo f = fechaHora(2026, 9, 29, 14, 30, 5)
imprimir(f, fecha(2026, 2, 28), aIso(f), aMarca(f), tipo(f))
imprimir(anio(f), mes(f), dia(f), hora(f), minuto(f), segundo(f), diaSemana(f), trimestre(f), diaDelAnio(f), semana(f))
imprimir(nombreMes(f), nombreDia(f), mesCorto(f), diaCorto(f))
imprimir(sumarSegundos(f, 59), sumarMinutos(f, -45), sumarHoras(f, 10), sumarDias(f, 3), sumarSemanas(f, -2))
imprimir(sumarMeses(fecha(2026, 1, 31), 1), sumarMeses(fecha(2024, 1, 31), 1), sumarMeses(fecha(2026, 3, 15), -14), sumarAnios(fecha(2024, 2, 29), 1), sumarMeses(f, 25))
imprimir(inicioDia(f), finDia(f), inicioSemana(f), finSemana(f), inicioMes(f), finMes(f), inicioAnio(f), finAnio(f))
fijo g = fecha(2027, 3, 1)
imprimir(segundosEntre(f, g), minutosEntre(f, g), horasEntre(f, g), diasEntre(f, g), mesesEntre(f, g), aniosEntre(f, g), diasEntre(g, f))
imprimir(mesesEntre(fecha(2026, 1, 31), fecha(2026, 2, 28)), mesesEntre(fecha(2026, 3, 31), fecha(2026, 1, 31)), aniosEntre(fecha(1990, 6, 15), fecha(2026, 6, 14)), aniosEntre(fecha(1990, 6, 15), fecha(2026, 6, 15)))
imprimir(duracion(f, g), duracion(g, f))
imprimir(esBisiesto(fecha(2024, 1, 1)), esBisiesto(fecha(1900, 1, 1)), esBisiesto(fecha(2000, 1, 1)), diasDelMes(fecha(2024, 2, 1)), diasDelMes(fecha(2023, 2, 1)))
imprimir(esFinDeSemana(fecha(2026, 10, 17)), esFinDeSemana(fecha(2026, 10, 19)), esMismoDia(f, fecha(2026, 9, 29)), estaEntre(f, g, fecha(2026, 1, 1)), esAntesDe(f, g), esDespuesDe(f, g))
imprimir(deFecha(f), deFecha(f, "corta"), deFecha(f, "larga"), deFecha(f, "mes"), deFecha(f, "hora"), deFecha(f, "completa"))
imprimir(aFecha("2026-09-29"), aFecha("  2026-9-3 7:05 "), aFecha("2026-09-29T14:30:59"), aFecha("29/09/2026"), aFecha("1/2/2026 23:59:01"))
imprimir(desdeMarca(0), desdeMarca(-1), desdeMarca(1e12), desdeMarca(253402300799999), desdeMarca(1.5))
imprimir(fecha(50, 1, 1), fecha(0, 6, 15), fecha(100, 1, 1), fecha(1, 1, 1), fecha(-44, 3, 15), fecha(9999, 12, 31), fecha(10000, 1, 1))
imprimir(diaDelAnio(fecha(2024, 12, 31)), semana(fecha(2021, 1, 3)), semana(fecha(2020, 12, 31)), semana(fecha(2026, 1, 1)), semana(fecha(2026, 12, 31)), semana(fecha(2015, 12, 31)))
imprimir(sumarDias(fecha(1969, 12, 31), 1), diaSemana(fecha(1970, 1, 1)), diaSemana(fecha(1600, 2, 29)), fecha(1600, 2, 29), nombreDia(fecha(1492, 10, 12)))
imprimir(fechaHora(2026, 1, 1, 25, 61), fechaHora(2026, 1, 1, 0, 0, 0), fechaHora(2026, 1, 1, 0, 0, 1), sumarSegundos(fecha(2026, 1, 1), -1))
# comparar, ordenar, igualdad, claves
fijo xs = [g, f, fecha(2020, 1, 1), fecha(2026, 9, 29)]
imprimir(ordenar(xs), maximo(xs), minimo(xs), f < g, f >= g, f == fechaHora(2026, 9, 29, 14, 30, 5), f == g, f != g)
imprimir(contiene(xs, fecha(2020, 1, 1)), {f: "una", "x": g}, [f, [g]])
debeSerMayor(g, f)
intentar { debeSerMayor(f, g) } capturar (e) { imprimir(e.mensaje) }
intentar { var z = ident(f) < ident(3) } capturar (e) { imprimir(e.mensaje) }
intentar { fecha(2026, 2, 29) } capturar (e) { imprimir(e.mensaje) }
intentar { fecha(2026, 13, 1) } capturar (e) { imprimir(e.mensaje) }
intentar { fecha(2026, 4, 31) } capturar (e) { imprimir(e.mensaje) }
intentar { aFecha("mañana") } capturar (e) { imprimir(e.mensaje) }
intentar { aFecha("2026-02-30") } capturar (e) { imprimir(e.mensaje) }
intentar { deFecha(f, "rara") } capturar (e) { imprimir(e.mensaje) }
intentar { anio(ident("2026")) } capturar (e) { imprimir(e.mensaje) }
intentar { var w = ident(f) + ident(1) } capturar (e) { imprimir(e.mensaje) }
fijo h = hoy()
imprimir(tipo(h), hora(h), minuto(h), segundo(h))
fecha(2026, 2, 30)
