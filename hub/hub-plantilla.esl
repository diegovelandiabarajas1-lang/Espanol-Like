# ARCADE Ñ — el hub de juegos, escrito entero en Ñ.
# Este archivo es la PLANTILLA: generar-hub.esl reemplaza la línea del catálogo
# y deja hub.esl; construir-app.js convierte hub.esl en un solo hub.html que se
# abre con doble clic desde la carpeta de juegos. Los juegos siguen donde están.
usar estilo, alPasar, enPantalla, dentro, enMovimientoReducido de "estilo"
usar minusculas, recortar, sinAcentos, indiceDe de "texto"

fijo JUEGOS = []  # <<CATALOGO>>

# ─────────────────────────────────────────────── estado
var busqueda = ""
var categoria = "Todos"
var favoritos = recuperar("favoritos", [])
var recientes = recuperar("recientes", [])

fn categorias(): lista<texto> {
    var vistas = []
    para j en JUEGOS { si no contiene(vistas, j["categoria"]) { agregar(vistas, j["categoria"]) } }
    devolver vistas
}

fn normal(s: texto): texto { devolver minusculas(sinAcentos(s)) }

fn visibles(): lista<cualquiera> {
    fijo q = normal(recortar(busqueda))
    devolver filtrar(JUEGOS, fn(j) {
        si categoria == "Favoritos" y no contiene(favoritos, j["ruta"]) { devolver falso }
        si categoria != "Todos" y categoria != "Favoritos" y j["categoria"] != categoria { devolver falso }
        si q == "" { devolver cierto }
        devolver indiceDe(normal(j["titulo"]), q) >= 0 o indiceDe(normal(j["archivo"]), q) >= 0
    })
}

fn porRuta(ruta: texto): cualquiera {
    para j en JUEGOS { si j["ruta"] == ruta { devolver j } }
    devolver nulo
}

# ─────────────────────────────────────────────── acciones
fn escribe(ev) { busqueda = obtener(ev, "valor", "")  ver() }

fn elige(c: texto) { devolver fn() { categoria = c  ver() } }

fn alternarFavorito(j) {
    devolver fn() {
        si contiene(favoritos, j["ruta"]) { quitar(favoritos, j["ruta"]) } sino { agregar(favoritos, j["ruta"]) }
        guardar("favoritos", favoritos)
        ver()
    }
}

# Al pulsar «Jugar» solo se anota el reciente: NO se repinta, para que el
# enlace siga en la página y el navegador complete la navegación.
fn anotarReciente(j) {
    devolver fn(ev) {
        si contiene(recientes, j["ruta"]) { quitar(recientes, j["ruta"]) }
        insertar(recientes, 0, j["ruta"])
        mientras longitud(recientes) > 6 { quitarEn(recientes, 6) }
        guardar("recientes", recientes)
    }
}

# ─────────────────────────────────────────────── estilo
fijo NEON = "#19F2FF"
fijo ROSA = "#FF3EA5"
fijo FONDO = "#07070E"
fijo TARJETA = "#121223"
fijo TEXTO = "#EDEFFF"
fijo SUAVE = "#8E92B4"
fijo MONO = "ui-monospace, Consolas, 'Cascadia Mono', monospace"

fijo pagina = estilo({"fondo": FONDO, "color": TEXTO, "fontFamily": MONO, "minHeight": "100vh",
                      "relleno": [24, 16, 48, 16]})
fijo cabecera = estilo({"anchoMax": 1100, "margen": [0, "auto", 20, "auto"]})
fijo titulo = estilo({"tamano": 34, "grosor": 800, "letterSpacing": 4, "color": NEON,
                      "textShadow": "0 0 18px rgba(25,242,255,.55)", "margen": 0})
fijo lema = estilo({"color": SUAVE, "tamano": 13, "margen": [6, 0, 0, 0]})
fijo barra = estilo({"mostrar": "flex", "hueco": 10, "envolver": "wrap", "alinearItems": "center",
                     "margen": [18, 0, 0, 0]})
fijo caja = estilo({"fondo": TARJETA, "color": TEXTO, "borde": "1px solid #262747", "redondeo": 10,
                    "relleno": [10, 14], "tamano": 14, "fontFamily": MONO, "crecer": 1, "minWidth": 200,
                    "outline": "ninguno"},
    dentro("input", {"fondo": "transparente", "color": TEXTO, "borde": "ninguno", "ancho": "100%",
                     "fontFamily": MONO, "tamano": 14, "outline": "ninguno"}))
fijo chip = estilo({"fondo": "transparente", "color": SUAVE, "borde": "1px solid #262747", "redondeo": 999,
                    "relleno": [6, 14], "tamano": 12, "cursor": "pointer", "fontFamily": MONO,
                    "transicion": "all .15s"},
    alPasar({"color": NEON, "borderColor": NEON}),
    enMovimientoReducido({"transicion": "ninguna"}))
fijo chipActivo = estilo(chip, {"color": FONDO, "fondo": NEON, "borderColor": NEON, "grosor": 700},
    alPasar({"color": FONDO}))
fijo seccion = estilo({"anchoMax": 1100, "margen": [0, "auto"]})
fijo rotulo = estilo({"color": SUAVE, "tamano": 11, "letterSpacing": 3, "textTransform": "uppercase",
                      "margen": [22, 0, 10, 0]})
fijo rejilla = estilo({"mostrar": "grid", "gridTemplateColumns": "repeat(auto-fill, minmax(230px, 1fr))",
                       "hueco": 12})
fijo tarjeta = estilo({"fondo": TARJETA, "borde": "1px solid #262747", "redondeo": 14, "relleno": 14,
                       "mostrar": "flex", "flexDirection": "column", "hueco": 8, "minWidth": 0,
                       "transicion": "transform .15s, border-color .15s"},
    alPasar({"borderColor": NEON, "transform": "translateY(-2px)"}),
    enMovimientoReducido({"transicion": "ninguna"}))
fijo nombre = estilo({"tamano": 15, "grosor": 700, "lineHeight": 1.25, "overflowWrap": "anywhere"})
fijo meta = estilo({"color": SUAVE, "tamano": 11, "mostrar": "flex", "justificar": "space-between", "hueco": 8})
fijo etiquetaCat = estilo({"color": ROSA, "letterSpacing": 1})
fijo pie = estilo({"mostrar": "flex", "hueco": 8, "alinearItems": "center", "margen": [6, 0, 0, 0]})
fijo jugar = estilo({"fondo": NEON, "color": FONDO, "grosor": 800, "textDecoration": "none",
                     "relleno": [8, 14], "redondeo": 8, "tamano": 13, "letterSpacing": 1, "crecer": 1,
                     "textAlign": "center"},
    alPasar({"fondo": "#7FF8FF"}))
fijo estrella = estilo({"fondo": "transparente", "borde": "1px solid #262747", "color": SUAVE, "redondeo": 8,
                        "relleno": [6, 10], "cursor": "pointer", "tamano": 15, "lineHeight": 1},
    alPasar({"color": ROSA, "borderColor": ROSA}))
fijo estrellaOn = estilo(estrella, {"color": ROSA, "borderColor": ROSA})
fijo vacio = estilo({"color": SUAVE, "relleno": [40, 0], "textAlign": "center"})
fijo recienteFila = estilo({"mostrar": "flex", "hueco": 8, "envolver": "wrap"})
fijo recienteEnlace = estilo({"color": TEXTO, "fondo": TARJETA, "borde": "1px solid #262747", "redondeo": 8,
                              "relleno": [6, 12], "tamano": 12, "textDecoration": "none"},
    alPasar({"borderColor": ROSA, "color": ROSA}))

# ─────────────────────────────────────────────── componentes
fn chipDe(c: texto, cuantos: entero): nodo {
    var s = chip
    si c == categoria { s = chipActivo }
    devolver boton(c + " · " + texto(cuantos), elige(c), s)
}

fn tarjetaDe(j): nodo {
    fijo esFav = contiene(favoritos, j["ruta"])
    var sEstrella = estrella
    var marca = "☆"
    si esFav { sEstrella = estrellaOn  marca = "★" }
    devolver etiqueta("article", tarjeta,
        etiqueta("div", nombre, j["titulo"]),
        etiqueta("div", meta,
            etiqueta("span", etiquetaCat, j["categoria"]),
            etiqueta("span", j["archivo"])),
        etiqueta("div", pie,
            etiqueta("a", jugar, {"destino": j["ruta"], "alHacerClic": anotarReciente(j)}, "JUGAR ▶"),
            boton(marca, alternarFavorito(j), sEstrella, {"titulo": "Favorito"})))
}

fn recientesNodo(): nodo {
    fijo lista = filtrar(mapear(recientes, porRuta), fn(j) { devolver j != nulo })
    si longitud(lista) == 0 { devolver etiqueta("span") }
    devolver etiqueta("div",
        etiqueta("div", rotulo, "Seguir jugando"),
        etiqueta("div", recienteFila,
            mapear(lista, fn(j) {
                devolver etiqueta("a", recienteEnlace, {"destino": j["ruta"], "alHacerClic": anotarReciente(j)}, j["titulo"])
            })))
}

fn cuenta(c: texto): entero {
    si c == "Todos" { devolver longitud(JUEGOS) }
    si c == "Favoritos" { devolver longitud(favoritos) }
    devolver longitud(filtrar(JUEGOS, fn(j) { devolver j["categoria"] == c }))
}

# ─────────────────────────────────────────────── pintar
fn ver() {
    limpiarPagina()
    fijo lista = visibles()
    var cuerpo = etiqueta("div", vacio, "Nada coincide con «" + busqueda + "» en " + categoria + ".")
    si longitud(lista) > 0 { cuerpo = etiqueta("div", rejilla, mapear(lista, tarjetaDe)) }
    fijo todas = agregar(agregar(["Todos"], "Favoritos"), categorias())
    pintar(etiqueta("div", pagina,
        etiqueta("header", cabecera,
            etiqueta("h1", titulo, "ARCADE Ñ"),
            etiqueta("div", lema, texto(longitud(JUEGOS)) + " juegos · el hub está escrito en Ñ; los juegos, en lo que cada uno quiera"),
            etiqueta("div", barra,
                entrada("", nulo, {"clave": "buscar", "valor": busqueda, "pista": "buscar un juego…",
                                   "alEscribir": escribe}, caja),
                mapear(aplanar(todas), fn(c) { devolver chipDe(c, cuenta(c)) })),
            recientesNodo()),
        etiqueta("section", seccion,
            etiqueta("div", rotulo, categoria + " · " + texto(longitud(lista))),
            cuerpo)))
}

ver()
