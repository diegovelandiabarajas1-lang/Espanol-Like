# ECOSIM-5 · prototipo 0 · mercado cerrado con salarios y dividendos
# Todo el dinero va en CENTAVOS (entero): así la conservación es exacta.

fijo N_AG = 500
fijo N_BOT = 50
fijo N_EMP = 5
fijo ACC_POR_EMP = 1000            # 5 × 1000 = 5.000 acciones en el IPO
fijo DUENOS = N_AG + N_BOT          # dueño 0..499 = agente, 500..549 = bot
fijo NOMBRES = ["Agua", "Comida", "Tecnología", "Entretenimiento", "Random Co."]

# ── azar reproducible (Park–Miller: el producto cabe en 2^53) ──
var semilla = 20261012
fn azar(n: entero): entero {
  semilla = (semilla * 16807) % 2147483647
  devolver semilla % n
}

# ── estado ──
var agDinero: lista<entero> = []
var agHambre: lista<entero> = []
var agAburr: lista<entero> = []
var agCurio: lista<entero> = []
var agEmpleo: lista<entero> = []     # empresa donde trabaja, o -1
var botDinero: lista<entero> = []
var empDinero: lista<entero> = []
var empInv: lista<entero> = []
var empPrecio: lista<entero> = []
var empSalario: lista<entero> = []
var empPrecioAcc: lista<entero> = []
var tenencia: lista<lista<entero>> = []   # tenencia[empresa][dueño]
var producido = 0
var consumido = 0
var DINERO_0 = 0

fn iniciar() {
  para i en rango(N_AG) {
    agregar(agDinero, 20000 + azar(30000))
    agregar(agHambre, azar(60))
    agregar(agAburr, azar(60))
    agregar(agCurio, azar(60))
    agregar(agEmpleo, i % N_EMP)
  }
  para b en rango(N_BOT) { agregar(botDinero, 500000 + azar(500000)) }
  para e en rango(N_EMP) {
    agregar(empDinero, 2000000)
    agregar(empInv, 200)
    agregar(empPrecio, 800 + azar(800))
    agregar(empSalario, 60)
    agregar(empPrecioAcc, 5000)
    var fila: lista<entero> = []
    para d en rango(DUENOS) { agregar(fila, 0) }
    # IPO: cada acción va a un dueño al azar; nadie la "crea" después
    para k en rango(ACC_POR_EMP) {
      fijo d = azar(DUENOS)
      fila[d] = fila[d] + 1
    }
    agregar(tenencia, fila)
  }
  DINERO_0 = dineroTotal()
}

fn dineroTotal(): entero {
  var s = 0
  para x en agDinero { s += x }
  para x en botDinero { s += x }
  para x en empDinero { s += x }
  devolver s
}

# ── un consumidor compra lo que más urge ──
fn comprar(i: entero) {
  var e = 0
  var barra = 0
  si agHambre[i] >= agAburr[i] y agHambre[i] >= agCurio[i] {
    barra = 0
    e = si0(empPrecio[0] <= empPrecio[1])
  } sino {
    si agAburr[i] >= agCurio[i] { barra = 1
      e = 3 } sino { barra = 2
      e = 2 }
  }
  si azar(10) == 0 { e = 4 }                       # Random Co.: compra por impulso
  fijo urg = maximo(agHambre[i], agAburr[i], agCurio[i])
  si urg < 40 { devolver }
  si empInv[e] <= 0 o agDinero[i] < empPrecio[e] { devolver }
  agDinero[i] = agDinero[i] - empPrecio[e]
  empDinero[e] = empDinero[e] + empPrecio[e]
  empInv[e] = empInv[e] - 1
  consumido += 1
  si barra == 0 { agHambre[i] = maximo(0, agHambre[i] - 45) }
  sino { si barra == 1 { agAburr[i] = maximo(0, agAburr[i] - 45) } sino { agCurio[i] = maximo(0, agCurio[i] - 45) } }
}
fn si0(c: bool): entero { si c { devolver 0 } devolver 1 }

# ── empresas: producir, pagar salarios, ajustar precio ──
fn empresas(t: entero) {
  para e en rango(N_EMP) {
    var trabajadores = 0
    para i en rango(N_AG) {
      si agEmpleo[i] == e {
        si empDinero[e] >= empSalario[e] {
          empDinero[e] = empDinero[e] - empSalario[e]
          agDinero[i] = agDinero[i] + empSalario[e]
          trabajadores += 1
        } sino { agEmpleo[i] = -1 }               # sin caja: despide
      }
    }
    si t % 10 == 0 {
      empInv[e] = empInv[e] + trabajadores
      producido += trabajadores
    }
    si empInv[e] > 400 { empPrecio[e] = maximo(100, empPrecio[e] - 5) }
    si empInv[e] < 50 { empPrecio[e] = empPrecio[e] + 5 }
  }
  # recontratar desempleados en la empresa con más caja
  var mejor = 0
  para e en rango(N_EMP) { si empDinero[e] > empDinero[mejor] { mejor = e } }
  para i en rango(N_AG) { si agEmpleo[i] == -1 y empDinero[mejor] > 500000 { agEmpleo[i] = mejor } }
}

# ── dividendos: el residuo de la división se queda en la empresa ──
fn dividendos() {
  para e en rango(N_EMP) {
    fijo exceso = empDinero[e] - 1500000
    si exceso > 0 {
      fijo porAccion = (exceso // 2) // ACC_POR_EMP
      si porAccion > 0 {
        para d en rango(DUENOS) {
          fijo n = tenencia[e][d]
          si n > 0 {
            fijo pago = n * porAccion
            empDinero[e] = empDinero[e] - pago
            si d < N_AG { agDinero[d] = agDinero[d] + pago } sino { botDinero[d - N_AG] = botDinero[d - N_AG] + pago }
          }
        }
      }
    }
  }
}

# ── bolsa: subasta por empresa, toda compra tiene un vendedor real ──
fn bolsa() {
  para e en rango(N_EMP) {
    var compras: lista<entero> = []     # precio*1000 + bot
    var ventas: lista<entero> = []
    fijo ref = empPrecioAcc[e]
    para b en rango(N_BOT) {
      fijo lado = azar(3)
      fijo limite = maximo(1, ref + azar(ref // 5 + 1) - ref // 10)
      si lado == 0 y botDinero[b] >= limite { agregar(compras, limite * 1000 + b) }
      si lado == 1 y tenencia[e][N_AG + b] > 0 { agregar(ventas, limite * 1000 + b) }
    }
    compras = invertir(ordenar(compras))
    ventas = ordenar(ventas)
    var k = 0
    mientras k < longitud(compras) y k < longitud(ventas) {
      fijo pc = compras[k] // 1000
      fijo bc = compras[k] % 1000
      fijo pv = ventas[k] // 1000
      fijo bv = ventas[k] % 1000
      si pc < pv { romper }
      fijo p = (pc + pv) // 2
      si bc != bv y botDinero[bc] >= p {
        botDinero[bc] = botDinero[bc] - p
        botDinero[bv] = botDinero[bv] + p
        tenencia[e][N_AG + bv] = tenencia[e][N_AG + bv] - 1
        tenencia[e][N_AG + bc] = tenencia[e][N_AG + bc] + 1
        empPrecioAcc[e] = p
      }
      k += 1
    }
  }
}

# ── invariantes: si algo falla, el programa se detiene en ese tick ──
fn verificar(t: entero) {
  si dineroTotal() != DINERO_0 { lanzar error("tick " + texto(t) + ": dinero fantasma " + texto(dineroTotal() - DINERO_0)) }
  para e en rango(N_EMP) {
    var s = 0
    para d en rango(DUENOS) { s += tenencia[e][d] }
    si s != ACC_POR_EMP { lanzar error("tick " + texto(t) + ": acciones de " + NOMBRES[e] + " suman " + texto(s)) }
  }
  var inv = 0
  para e en rango(N_EMP) { inv += empInv[e] }
  si producido + 1000 - consumido != inv { lanzar error("tick " + texto(t) + ": bienes no cuadran") }
}

fn tick(t: entero) {
  para i en rango(N_AG) {
    agHambre[i] = minimo(100, agHambre[i] + 2)
    agAburr[i] = minimo(100, agAburr[i] + 1)
    agCurio[i] = minimo(100, agCurio[i] + 1)
  }
  fijo inicio = azar(N_AG)                       # orden rotado, reproducible
  para j en rango(N_AG) { comprar((inicio + j) % N_AG) }
  empresas(t)
  si t % 60 == 0 { dividendos() }
  bolsa()
  verificar(t)
}

fn correr(ticks: entero) {
  para t en rango(ticks) { tick(t) }
}

iniciar()
fijo TICKS = entero(argumentos()[0])
fijo t0 = reloj()
correr(TICKS)
fijo ms = reloj() - t0
imprimir("ticks: {TICKS} · {ms} ms · {ms / TICKS} ms por tick")
imprimir("dinero total: {dineroTotal()} = inicial {DINERO_0} · producido {producido} · consumido {consumido}")
para e en rango(N_EMP) { imprimir("  {NOMBRES[e]}: caja {empDinero[e]} · inventario {empInv[e]} · precio {empPrecio[e]} · acción {empPrecioAcc[e]}") }
