# Un módulo que envuelve raylib: por fuera son funciones en español, por dentro
# es FFI. Los dos caminos —módulos y código nativo— en un archivo.
#
# La biblioteca: N_RAYLIB si está puesta; si no, raylib.dll en Windows y
# libraylib.so en Linux, junto al programa (o al ejecutable empaquetado).
fn porDefecto(): texto {
    si entorno("OS", "") == "Windows_NT" { devolver "./raylib.dll" }
    devolver "./libraylib.so"
}
fijo RL = entorno("N_RAYLIB", porDefecto())
usar deCodigo de "texto"

estructuraNativa("Color", {"r": "natural8", "g": "natural8", "b": "natural8", "a": "natural8"})

fijo _abrir    = nativa(RL, "InitWindow", "nulo", ["entero", "entero", "texto"])
fijo _cerrar   = nativa(RL, "CloseWindow", "nulo", [])
fijo _debeCerrar = nativa(RL, "WindowShouldClose", "log", [])
fijo _fps      = nativa(RL, "SetTargetFPS", "nulo", ["entero"])
fijo _empezar  = nativa(RL, "BeginDrawing", "nulo", [])
fijo _terminar = nativa(RL, "EndDrawing", "nulo", [])
fijo _fondo    = nativa(RL, "ClearBackground", "nulo", ["Color"])
fijo _caja     = nativa(RL, "DrawRectangle", "nulo", ["entero","entero","entero","entero","Color"])
fijo _borde    = nativa(RL, "DrawRectangleLines", "nulo", ["entero","entero","entero","entero","Color"])
fijo _circulo  = nativa(RL, "DrawCircle", "nulo", ["entero","entero","real32","Color"])
fijo _linea    = nativa(RL, "DrawLine", "nulo", ["entero","entero","entero","entero","Color"])
fijo _texto    = nativa(RL, "DrawText", "nulo", ["texto","entero","entero","entero","Color"])
fijo _medir    = nativa(RL, "MeasureText", "entero", ["texto", "entero"])
fijo _captura  = nativa(RL, "TakeScreenshot", "nulo", ["texto"])
fijo _ratonX   = nativa(RL, "GetMouseX", "entero", [])
fijo _ratonY   = nativa(RL, "GetMouseY", "entero", [])
fijo _pulsado  = nativa(RL, "IsMouseButtonPressed", "log", ["entero"])
fijo _abajo    = nativa(RL, "IsMouseButtonDown", "log", ["entero"])
fijo _tecla    = nativa(RL, "GetKeyPressed", "entero", [])
fijo _letra    = nativa(RL, "GetCharPressed", "entero", [])
fijo _teclaAbajo = nativa(RL, "IsKeyDown", "log", ["entero"])

publico fn color(r: entero, g: entero, b: entero): dic { devolver {"r": r, "g": g, "b": b, "a": 255} }
publico fn abrir(ancho: entero, alto: entero, titulo: texto) {
    _abrir(ancho, alto, titulo)
    _fps(60)
}
publico fn cerrar() { _cerrar() }
# verdadero cuando el usuario cerró la ventana (la X o Escape)
publico fn debeCerrar(): bool { devolver _debeCerrar() }
publico fn medir(t: texto, tam: entero): entero { devolver _medir(t, tam) }
publico fn captura(ruta: texto) { _captura(ruta) }

# el ratón en este cuadro: posición, si se acaba de pulsar y si está apretado
publico fn raton(): dic {
    devolver {"x": _ratonX(), "y": _ratonY(), "clic": _pulsado(0), "abajo": _abajo(0)}
}
# la tecla pulsada en este cuadro (código de raylib; 0 si ninguna) y la letra escrita (0 si ninguna)
publico fn tecla(): entero { devolver _tecla() }
publico fn letra(): texto {
    fijo c = _letra()
    si c == 0 { devolver "" }
    devolver deCodigo(c)
}
publico fn teclaAbajo(codigo: entero): bool { devolver _teclaAbajo(codigo) }
# ¿está el punto dentro del rectángulo?
publico fn dentro(x: entero, y: entero, rx: entero, ry: entero, ancho: entero, alto: entero): bool {
    devolver x >= rx y x < rx + ancho y y >= ry y y < ry + alto
}

# un cuadro: «dibujo» recibe el pincel, un dic de funciones
publico fn pintar(dibujo) {
    _empezar()
    dibujo({"fondo": _fondo, "caja": _caja, "borde": _borde, "circulo": _circulo, "linea": _linea, "texto": _texto})
    _terminar()
}
