# En el motor C1EÑ, numerico y nen ya están abiertos: ni un «usar»
fijo f = "x^3 - 6x^2 + 11x - 6"
imprimir(derivarFormula(f, "x"), " · raíces ", resolverFormula(f + " = 0", "x"))
imprimir(integrar(funcion(x) { devolver exp(-x * x) }, 0, |INFINITO), " = ", raiz(|PI) / 2)
fijo A = arreglo([[2, 1], [1, 3]], "real")
imprimir(einstein("ii->", A), " ", autovaloresGeneral(A))
fijo dentro = arreglo([0], "entero")
fn tirar(i, dentro) {
  fijo x = azarHilo(7, i, 0)
  fijo y = azarHilo(7, i, 1)
  si x * x + y * y < 1.0 { sumarAtomico(dentro, 0, 1) }
}
paralelo(1000000, tirar, dentro)
imprimir("π ≈ ", 4.0 * elemento(dentro, 0) / 1000000, " en ", dispositivo())
