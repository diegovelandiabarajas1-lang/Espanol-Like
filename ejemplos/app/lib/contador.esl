# El modelo de la app, sin nada de ventana: un contador con historial. Es el
# archivo que se puede probar con «probar» sin abrir ninguna ventana.
var valor = 0
var historial: lista<entero> = []

publico fn actual(): entero { devolver valor }
publico fn sumar(n: entero) {
    valor = valor + n
    agregar(historial, valor)
    si longitud(historial) > 12 { quitarEn(historial, 0) }
}
publico fn reiniciar() {
    valor = 0
    historial = []
}
publico fn ultimos(): lista<entero> { devolver historial }
