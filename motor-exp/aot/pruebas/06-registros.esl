tipo Punto {
  x: real
  y: real = 0.0
}
fn Punto.mover(dx: real, dy: real) {
  yo.x = yo.x + dx
  yo.y = yo.y + dy
}
fn Punto.norma2(): real { devolver yo.x * yo.x + yo.y * yo.y }
var p = Punto(1.0)
p.mover(2.0, 3.0)
imprimir(p, p.norma2(), tipo(p), p == Punto(3.0, 3.0), p == {"x": 3, "y": 3})
fijo f = p.norma2
imprimir(f(), f)
fijo q = copiar(p)
q.x = 100.0
imprimir(p.x, q.x)
fn ident(v) { devolver v }
fijo pp = ident(p)
intentar { pp.z = 1 } capturar (e) { imprimir(e.mensaje) }
intentar { imprimir(pp.w) } capturar (e) { imprimir(e.mensaje) }
fijo d = {"uno": 1, "dos": 2}
d["tres"] = 3
borrar(d, "uno")
imprimir(d, claves(d), valores(d), pares(d), obtener(d, "x", "no"), longitud(d))
para k en claves(d) { imprimir(k, d[k]) }
