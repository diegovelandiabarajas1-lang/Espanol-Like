usar numero, decimales, moneda, porciento, porcientoCambio, signoMas, abreviar, ordinal, enLetras, romano, intervalo de "formato"
usar plural, listaLegible, mayusculaInicial, acortar, elipsis, alinearIzq, alinearDer, centrar, aAncho de "formato"
usar tamanoLegible, duracionLegible, tiempoReloj, tiempoRelativo, regla, barraTexto, minigrafico, marco, tablaTexto, columnas de "formato"
usar enRojo, enVerde, enAmarillo, enAzul, enGris, enNegrita, enTenue, enSubrayado, sinColor, separadores, monedaPorDefecto de "formato"

funcion ident(x) { devolver x }

# toFixed exacto: la mitad hacia arriba sobre el valor EXACTO del double
imprimir(decimales(0.5, 0), decimales(1.5, 0), decimales(2.5, 0), decimales(-2.5, 0), decimales(0.125, 2), decimales(0.375, 2))
imprimir(decimales(1.005, 2), decimales(1.045, 2), decimales(8.345, 2), decimales(0.1, 20), decimales(1e20, 2), decimales(123456789.987654321, 5))
imprimir(decimales(5e-324, 20), decimales(0.000001, 7), decimales(-0.0, 2), decimales(1e21, 2), decimales(2.0 ** 70, 0), decimales(3.14159, 2))
imprimir(numero(1234.5), numero(1000000), numero(-1234567.891), numero(0.1 + 0.2), numero(1e-7), numero(1.5e-7), numero(123), numero(-0.0))
imprimir(numero(|INFINITO), numero(|INFINITO - |INFINITO), numero(1e21), numero(1.5e22))
imprimir(moneda(1234567), moneda(9.5, "€", 2), moneda(-0.005, "$", 2), moneda(1234.5678))
imprimir(porciento(0.156), porciento(0.5), porciento(0.12345, 2), porciento(1 / 3))
imprimir(porcientoCambio(80.0, 90.0), porcientoCambio(100.0, 75.0), porcientoCambio(0, 0), porcientoCambio(0, 5), porcientoCambio(3, 3), porcientoCambio(-4, 2, 3))
imprimir(signoMas(3), signoMas(-3), signoMas(0), signoMas(2.25), signoMas(2.25, 1))
imprimir(abreviar(4500), abreviar(1234567), abreviar(999), abreviar(-25000), abreviar(9999999), abreviar(3.2e12), abreviar(1500.5), abreviar(12.75))
imprimir(ordinal(1), ordinal(3, cierto), ordinal(1234), ordinal(2.9))
imprimir(enLetras(0), enLetras(1), enLetras(15), enLetras(16), enLetras(21), enLetras(100), enLetras(101), enLetras(1250))
imprimir(enLetras(21000), enLetras(1000000), enLetras(21000000), enLetras(31000001), enLetras(1021000000), enLetras(-7))
imprimir(enLetras(999999999999999), enLetras(2000000000000), enLetras(1000000000000))
imprimir(romano(2026), romano(4), romano(49), romano(3999), romano(1))
imprimir(intervalo(3, 7), intervalo(1.5, 2.25), intervalo(1, 2, 2))

imprimir(plural(1, "factura"), plural(2, "factura"), plural(3, "lápiz"), plural(0, "error"), plural(2, "rubí"), plural(2.5, "kilo"))
imprimir(plural(2, "LÁPIZ"), plural(-1, "día"), plural(4, "mes", "meses"), plural(2, "CAFÉ"), plural(2, ""))
imprimir(listaLegible(["a", "b", "c"]), "|", listaLegible(["pan", "higos"]), "|", listaLegible(["agua", "hielo"]), "|", listaLegible(["x", "Iglesias"]))
imprimir(listaLegible([]), "|", listaLegible(["solo"]), "|", listaLegible([1, 2.5, "", nulo, cierto]), "|", listaLegible(["a", "b"], "o"))
imprimir(mayusculaInicial("hola mundo"), mayusculaInicial(""), mayusculaInicial("ñandú"), mayusculaInicial("ßx"))
imprimir(acortar("un texto bien largo", 10), acortar("corto", 10), acortar("un texto     largo", 10), acortar("abcdef", 0), acortar("abcdefgh", 5, "..."))
imprimir(elipsis("/muy/larga/ruta/archivo.txt", 14), elipsis("abc", 5), elipsis("abcdef", 1), elipsis("abcdef", 2), elipsis("abcdefgh", 5))
imprimir("[" + alinearIzq("ab", 5) + "]", "[" + alinearDer("7", 3) + "]", "[" + alinearDer(42, 6, "0") + "]", "[" + alinearIzq("x", 6, "-=") + "]")
imprimir("[" + centrar("ab", 6) + "]", "[" + centrar("abc", 6) + "]", "[" + centrar("largo", 2) + "]", "[" + aAncho("abc", 6) + "]", "[" + aAncho("abc", 6, "der") + "]")
imprimir("[" + aAncho("abcdefghij", 6) + "]", "[" + aAncho("x", 0) + "]", "[" + alinearIzq(enRojo("ok"), 5) + "]")
imprimir(tamanoLegible(0), tamanoLegible(512), tamanoLegible(1536000), tamanoLegible(1024), tamanoLegible(-5000), tamanoLegible(1e18), tamanoLegible(10239))
imprimir(duracionLegible(0), duracionLegible(999.5), duracionLegible(7505000), duracionLegible(90061000), duracionLegible(61000), duracionLegible(-3000))
imprimir(tiempoReloj(7531000), tiempoReloj(59000), tiempoReloj(-5), tiempoReloj(3600000))
imprimir(tiempoRelativo(1000), tiempoRelativo(-1000), tiempoRelativo(259200000), tiempoRelativo(-7200000), tiempoRelativo(60000), tiempoRelativo(4e10), tiempoRelativo(1e11))
imprimir(regla(20), regla(0), regla(7, "=-"), regla(3, ""))
imprimir(regla())
imprimir(barraTexto(7, 10), barraTexto(3, 0), barraTexto(15, 10, 5), barraTexto(-1, 10, 4), barraTexto(1, 3, 10))
imprimir(minigrafico([1, 5, 3, 9, 2]), minigrafico([4, 4, 4]), minigrafico([]), minigrafico([-1.5, 0, 2.25]))
imprimir(marco("hola"))
imprimir(marco("una línea\notra más larga", "aviso"))
imprimir(marco("x", "un título largo"))
fijo filas = [{"ciudad": "Girón", "ventas": 1200.5, "ok": cierto}, {"ciudad": "Bucaramanga", "ventas": 98, "nota": nulo}, {"ciudad": "Lebrija", "ventas": 1234567, "nota": "nueva"}]
imprimir(tablaTexto(filas))
imprimir(tablaTexto(filas, ["ventas", "ciudad"]))
imprimir(tablaTexto([]))
imprimir(columnas(["uno", "dos", "tres", "cuatro", "cinco", "seis", "siete"], 3))
imprimir(columnas([1, 22, 333], 5))
imprimir(columnas(["a", "b", "c", "d"]))
imprimir(enRojo("r") + enVerde("v") + enAmarillo("a") + enAzul("z") + enGris("g") + enNegrita("n") + enTenue("t") + enSubrayado("s"))
imprimir(sinColor(enRojo("rojo") + " y " + enNegrita("negrita")), sinColor("\u001b[1;31mx\u001b[0m\u001b[q"))
separadores(" ", ".")
imprimir(numero(1234567.25), moneda(1500))
monedaPorDefecto("€")
imprimir(moneda(1500), moneda(2.5))
separadores()
imprimir(numero(1234567.25), moneda(1500))
separadores(1, cierto)
imprimir(numero(1234567.25))
separadores()

intentar { tablaTexto([[1, 2]]) } capturar (e) { imprimir(e.mensaje) }
intentar { romano(4000) } capturar (e) { imprimir(e.mensaje) }
intentar { enLetras(ident(1e15)) } capturar (e) { imprimir(e.mensaje) }
intentar { minigrafico([1, "x"]) } capturar (e) { imprimir(e.mensaje) }
intentar { decimales(ident("x"), 2) } capturar (e) { imprimir(e.mensaje) }
intentar { columnas(5) } capturar (e) { imprimir(e.mensaje) }
