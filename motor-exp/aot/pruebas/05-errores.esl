intentar { lanzar error("se rompió", "miTipo") } capturar (e) { imprimir(e.tipo, e.mensaje, e.linea, e) }
intentar { lanzar "un texto" } capturar (e) { imprimir("capturé", e) }
intentar { var x = [1, 2][5] } capturar (e) { imprimir(e.mensaje) }
intentar { var y = {"a": 1}["b"] } capturar (e) { imprimir(e.mensaje) }
fn ident(v) { devolver v }
intentar { var z = "a" + ident(1) } capturar (e) { imprimir(e.mensaje) }
intentar { var w = ident(nulo)() } capturar (e) { imprimir(e.mensaje) }
fn profunda(n) {
    si n == 0 { lanzar error("desde abajo") }
    devolver profunda(n - 1)
}
intentar { profunda(50) } capturar (e) { imprimir("subió:", e.mensaje) }
fn ff(x) { devolver x * 2 }
fijo gg = ident(ff)
intentar { gg(1, 2) } capturar (e) { imprimir(e.mensaje) }
intentar { mapear([1, 2], fn(x) { lanzar error("dentro de mapear") }) } capturar (e) { imprimir(e.mensaje) }
fn sinFin(n) { devolver sinFin(n + 1) }
intentar { sinFin(0) } capturar (e) { imprimir(e.mensaje) }
var lista = []
intentar {
    agregar(lista, 1)
    intentar { lanzar error("interno") } capturar (e) { agregar(lista, e.mensaje) }
    agregar(lista, 2)
    lanzar error("externo")
} capturar (e) { agregar(lista, e.mensaje) }
imprimir(lista)
imprimir("y ahora uno sin capturar")
fn a1() { devolver b1() }
fn b1() { devolver 1 / 0 }
a1()
