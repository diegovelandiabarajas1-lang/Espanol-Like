fijo s = "Ñandú corría"
imprimir(s, longitud(s), s[0], s[-1], s + "!", "a" + "b" == "ab")
imprimir("lista: ${[1, "dos", 3.5]} dic: ${{"k": "v", "3": 1, 2: "x"}}")
imprimir([[1, [2, [3, [4, [5, [6]]]]]]], {"a": {"b": {"c": {"d": {"e": {"f": 1}}}}}})
imprimir("comillas \" y \\ y\ttab", ["x\"y", "con\nsalto"])
imprimir(contiene(s, "dú"), contiene([1, 2], 2), contiene({"a": 1}, "a"), contiene({"a": 1}, "b"))
usar mayusculas, minusculas, dividir, unir, reemplazar, recortar, lineas, palabras, titular, sinAcentos, ordenAlfabetico, subtexto, invertirTexto, aUrl, plantilla, envolver de "texto"
imprimir(mayusculas("ñandú straße ÿ"), minusculas("ÑANDÚ ΣΟΦΟΣ"), dividir("a,b,,c", ","), dividir("hola mundo"), unir([1, "b", 2.5], "-"))
imprimir(reemplazar("uno dos uno", "uno", "tres"), "[" + recortar("  x  ") + "]", lineas("a\r\nb\nc\rd"), palabras("  hola   mundo  "))
imprimir(titular("juan de la cruz y el mar"), sinAcentos("Martín Ñuñez ü"), ordenAlfabetico(["oso", "ñu", "nube", "Él", "el", "zapato", "ñandú"]))
imprimir(subtexto("murciélago", 4, 100), subtexto("abc", -2, 3), invertirTexto("hola"), aUrl("  Camión Año 2026!! "), plantilla("Hola \{nombre\}, \{n\} años", {"nombre": "Ana", "n": 30}))
imprimir(envolver("el veloz murciélago hindú comía feliz cardillo y kiwi", 12))
