fn sumar(a, b = 10) { devolver a + b }
imprimir(sumar(1), sumar(1, 2))
fn hacerContador() {
    var c = 0
    fijo inc = fn() { c = c + 1
        devolver c }
    fijo ver = fn() { devolver c }
    devolver [inc, ver]
}
fijo par = hacerContador()
par[0]()
par[0]()
imprimir(par[1](), par[0]())
fn fabricas() {
    var fs = []
    para i en rango(3) { agregar(fs, fn() { devolver i * 10 }) }
    devolver fs
}
imprimir(mapear(fabricas(), fn(f) { devolver f() }))
imprimir(filtrar([1, 2, 3, 4, 5, 6], fn(x) { devolver x % 2 == 0 }), reducir([1, 2, 3, 4], fn(a, b) { devolver a + b }, 0))
imprimir(ordenar([3, 1, 2]), ordenar(["b", "a", "c"]), ordenar([[2, "b"], [1, "a"], [2, "a"]], fn(p) { devolver p[0] }))
fn fact(n) {
    si n <= 1 { devolver 1 }
    devolver n * fact(n - 1)
}
imprimir(fact(20), fact(25))
var total = 0
var i = 0
mientras cierto {
    i = i + 1
    si i > 100 { romper }
    si i % 2 == 0 { continuar }
    total = total + i
}
imprimir(total)
repetir 3 { imprimir("vuelta") }
imprimir(sumar)
imprimir(imprimir)
