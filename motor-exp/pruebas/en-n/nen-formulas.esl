# Las pruebas del resolucionador de fórmulas de NEÑ, en Ñ.
#
# Casi nada se comprueba contra un texto escrito a mano: se comprueba con
# IDENTIDADES que tienen que salir exactas. Derivar lo integrado devuelve el
# integrando; las soluciones sustituidas en la ecuación dan 0 (cero exacto,
# también con radicales y con «i»); expandir lo factorizado devuelve lo
# expandido; y la fórmula simplificada vale lo mismo que la original en varios
# puntos, también con fórmulas generadas al azar. Donde sí hay texto esperado
# es porque la forma canónica es parte de la promesa (lo que imprime).

usar probar, grupo, correrPruebas, resumenPruebas, debeSer, debeSerCerca, debeSerCierto,
     debeSerFalso, debeFallarCon, debeTener, debeSerTipo, debeContener de "probar"
usar simplificarFormula, expandirFormula, factorizarFormula, derivarFormula, gradienteFormula,
     integrarFormula, resolverFormula, despejar, resolverSistemaFormulas, evaluarFormula,
     sustituirEnFormula, variablesDeFormula, formulaAFuncion, taylorFormula, limiteFormula,
     formulaALatex, formulaATexto de "nen"
usar azarEntre, semilla, elegir, absoluto, exp de "numerico"

# ¿f es idénticamente cero? Expandir primero: simplificar elige la forma más
# corta, y una diferencia que se anula puede no ser la más corta sin expandir.
fn esCero(f: texto): bool {
    devolver simplificarFormula(expandirFormula(f)) == "0"
}
fn mismas(f: texto, g: texto): bool {
    devolver esCero("(" + f + ") - (" + g + ")")
}
# Sustituye la solución s en la expresión e (que debe valer 0) y mira si se anula.
fn anula(e: texto, x: texto, s: texto): bool {
    devolver esCero(sustituirEnFormula(e, {x: s}))
}

grupo("lectura: la notación del papel", fn() {
    probar("las precedencias: -x^2 es -(x^2) y ^ asocia a la derecha", fn() {
        debeSer(evaluarFormula("-x^2", {"x": 3}), -9)
        debeSer(simplificarFormula("2^3^2"), "512")
        debeSer(simplificarFormula("-2^2"), "-4")
        debeSer(simplificarFormula("2*3 + 4^2/8"), "8")
    })
    probar("multiplicación implícita", fn() {
        debeSer(simplificarFormula("3x - x*3"), "0")
        debeSer(simplificarFormula("2(x + 1) - 2x"), "2")
        debeSer(simplificarFormula("x y - y*x"), "0")
        debeSer(simplificarFormula("(x + 1)(x - 1) - x^2"), "-1")
        # 1/2x es (1/2)·x: la implícita tiene la fuerza de «*» y «/»
        debeSer(simplificarFormula("1/2x"), "x/2")
    })
    probar("xy es una variable, no un producto", fn() {
        debeSer(variablesDeFormula("xy + x y"), ["x", "xy", "y"])
    })
    probar("decimales con punto y con coma pegada, como fracciones exactas", fn() {
        debeSer(simplificarFormula("0.1 + 0.2"), "3/10")
        debeSer(simplificarFormula("3,5x - 7x/2"), "0")
        debeSer(simplificarFormula("log(8; 2)"), "3")
        debeSer(simplificarFormula("log(8, 2)"), "3")
    })
    probar("constantes, funciones en español y sus alias", fn() {
        debeSer(simplificarFormula("sen(x) - seno(x) + sin(x)"), "seno(x)")
        debeSer(simplificarFormula("sqrt(x) - raiz(x)"), "0")
        debeSer(simplificarFormula("ln(e)"), "1")
        debeSerCerca(evaluarFormula("pi"), 3.141592653589793)
        debeSerCerca(evaluarFormula("π + e"), 5.859874482048838)
        debeSer(simplificarFormula("i^2"), "-1")
    })
    probar("log es el logaritmo natural, igual que «log» de numerico", fn() {
        debeSer(simplificarFormula("log(x) - ln(x)"), "0")
        debeSerCerca(evaluarFormula("log10(1000)"), 3, 0.000000001)
    })
    probar("notación de mano: ², ³, √, |x|, · y ×", fn() {
        debeSer(simplificarFormula("x² - x^2"), "0")
        debeSer(simplificarFormula("√(x+1) - raiz(x+1)"), "0")
        debeSer(simplificarFormula("|x - 3| - abs(x - 3)"), "0")
        debeSer(simplificarFormula("2·x × 3 − 6x"), "0")
        debeSer(simplificarFormula("x**3 - x^3"), "0")
        debeSer(simplificarFormula("∛8 + x¹⁰ - x^10"), "2")
    })
    probar("errores de sintaxis con la posición", fn() {
        debeFallarCon(fn() { simplificarFormula("x + * 2") }, "posición 5")
        debeFallarCon(fn() { simplificarFormula("(x + 1") }, "esperaba «)»")
        debeFallarCon(fn() { simplificarFormula("x + 1)") }, "sobra un «)»")
        debeFallarCon(fn() { simplificarFormula("seno x") }, "es una función")
        debeFallarCon(fn() { simplificarFormula("sinh(x)") }, "no conozco la función «sinh»")
        debeFallarCon(fn() { simplificarFormula("x $ 2") }, "no entiendo el carácter")
        debeFallarCon(fn() { simplificarFormula("1/0") }, "divide entre cero")
        debeFallarCon(fn() { simplificarFormula("x = 1") }, "es una ecuación")
        debeFallarCon(fn() { simplificarFormula("") }, "vacía")
    })
})

grupo("simplificar: forma canónica exacta", fn() {
    probar("aritmética racional exacta, sin decimales", fn() {
        debeSer(simplificarFormula("1/3 + 1/6"), "1/2")
        debeSer(simplificarFormula("2^100 - 2^99*2"), "0")
        debeSer(simplificarFormula("(2/3)^-2"), "9/4")
    })
    probar("términos semejantes y potencias de la misma base", fn() {
        debeSer(simplificarFormula("2x + 3x - x^2/x"), "4x")
        debeSer(simplificarFormula("x^2*x^3/x"), "x^4")
        debeSer(simplificarFormula("x + 0"), "x")
        debeSer(simplificarFormula("1*x^1"), "x")
        debeSer(simplificarFormula("e^x * e^(-x)"), "1")
        debeSer(simplificarFormula("3a*b - 2b*a"), "a*b")
    })
    probar("orden canónico: el mismo resultado escriba como se escriba", fn() {
        debeSer(simplificarFormula("1 + x^2 + 2x"), simplificarFormula("2x + x^2 + 1"))
        debeSer(simplificarFormula("1 + x^2 + 2x"), "x^2 + 2x + 1")
        debeSer(simplificarFormula("y*x*3"), "3x*y")
    })
    probar("radicales: se extraen cuadrados y se racionaliza", fn() {
        debeSer(simplificarFormula("raiz(8)"), "2*raiz(2)")
        debeSer(simplificarFormula("raiz(12)/raiz(3)"), "2")
        debeSer(simplificarFormula("1/raiz(2)"), "raiz(2)/2")
        debeSer(simplificarFormula("raiz(6)*raiz(2)"), "2*raiz(3)")
        debeSer(simplificarFormula("(-8)^(1/3)"), "-2")
        debeSer(simplificarFormula("raiz(-4)"), "2*i")
        debeSer(simplificarFormula("raiz(x)^2"), "x")
        debeSer(simplificarFormula("raiz(x^2)"), "abs(x)")
    })
    probar("fracciones algebraicas: se cancela el factor común", fn() {
        debeSer(simplificarFormula("(x^2 - 1)/(x - 1)"), "x + 1")
        debeSer(simplificarFormula("1/(x+1) + 1/(x-1) - 2x/(x^2-1)"), "0")
        debeSer(simplificarFormula("(x^3 - 1)/(x^2 - 1)"), "(x^2 + x + 1)/(x + 1)")
    })
    probar("valores exactos de la tabla trigonométrica", fn() {
        debeSer(simplificarFormula("seno(pi/6)"), "1/2")
        debeSer(simplificarFormula("coseno(pi)"), "-1")
        debeSer(simplificarFormula("tangente(pi/4)"), "1")
        debeSer(simplificarFormula("seno(pi/4)"), "raiz(2)/2")
        debeSer(simplificarFormula("coseno(5pi/3)"), "1/2")
        debeSer(simplificarFormula("arcoseno(1/2)"), "pi/6")
        debeSer(simplificarFormula("arcotangente(1)"), "pi/4")
        debeSer(simplificarFormula("seno(-x) + seno(x)"), "0")
    })
    probar("la identidad pitagórica y logaritmos con exponenciales", fn() {
        debeSer(simplificarFormula("seno(x)^2 + coseno(x)^2"), "1")
        debeSer(simplificarFormula("3seno(2x)^2 + 3coseno(2x)^2"), "3")
        debeSer(simplificarFormula("ln(e^(3x))"), "3x")
        debeSer(simplificarFormula("e^(ln(x))"), "x")
        debeSer(simplificarFormula("ln(8)/ln(2)"), "3")
    })
})

grupo("expandir y factorizar", fn() {
    probar("expandir productos y potencias enteras de sumas", fn() {
        debeSer(expandirFormula("(x + 1)^2"), "x^2 + 2x + 1")
        debeSer(expandirFormula("(a + b)(a - b)"), "a^2 - b^2")
        debeSer(expandirFormula("(x - 1)(x + 1)(x + 2)"), "x^3 + 2x^2 - x - 2")
        debeSer(expandirFormula("(1 + i)^2"), "2*i")
    })
    probar("simplificar(expandir(f) - f) = 0 para una batería", fn() {
        para f en ["(x + y)^5", "(2x - 3)^4 (x + 1)", "(a + b + c)^3", "(x^2 - x + 1)(x^2 + x + 1)", "(raiz(x) + 1)^2"] {
            debeSerCierto(esCero(expandirFormula(f) + " - (" + f + ")"))
        }
    })
    probar("factorizar con raíces racionales y factor común", fn() {
        debeSer(factorizarFormula("x^2 - 5x + 6"), "(x - 2)(x - 3)")
        debeSer(factorizarFormula("2x^2 - x - 1"), "(2x + 1)(x - 1)")
        debeSer(factorizarFormula("4x^2 - 12x + 9"), "(2x - 3)^2")
        debeSer(factorizarFormula("12x^3 - 2x^2 - 30x"), "2x(2x + 3)(3x - 5)")
        debeSer(factorizarFormula("x^2 - y^2"), "(x - y)(x + y)")
        debeSer(factorizarFormula("x^4 - 4"), "(x^2 - 2)(x^2 + 2)")
    })
    probar("lo que no se factoriza en racionales queda como está", fn() {
        debeSer(factorizarFormula("x^2 + 1"), "x^2 + 1")
        debeSer(factorizarFormula("x^2 - 2"), "x^2 - 2")
    })
    probar("expandir(factorizar(p)) devuelve p", fn() {
        para p en ["x^3 - 6x^2 + 11x - 6", "6x^4 - 5x^3 - 2x^2 + x", "x^5 - x", "8x^3 + 27", "x^3 y - x y^3"] {
            debeSerCierto(mismas(expandirFormula(factorizarFormula(p)), p))
        }
    })
})

grupo("derivar", fn() {
    probar("reglas conocidas", fn() {
        debeSer(derivarFormula("x^3 + seno(x)", "x"), "3x^2 + coseno(x)")
        debeSer(derivarFormula("ln(x)", "x"), "1/x")
        debeSer(derivarFormula("x*e^x", "x"), "x*e^x + e^x")
        debeSer(derivarFormula("arcotangente(2x)", "x"), "2/(4x^2 + 1)")
        debeSer(derivarFormula("2^x", "x"), "2^x*ln(2)")
        debeSer(derivarFormula("x^x", "x"), "x^x*(ln(x) + 1)")
    })
    probar("derivadas de orden n y parciales", fn() {
        debeSer(derivarFormula("x^5", "x", 3), "60x^2")
        debeSer(derivarFormula("seno(x)", "x", 4), "seno(x)")
        debeSer(derivarFormula("x^2 y + y^3", "y"), "x^2 + 3y^2")
        debeSer(gradienteFormula("x^2 y", ["x", "y"]), ["2x*y", "x^2"])
        debeSer(derivarFormula("a x^2", "b"), "0")
    })
    probar("la derivada coincide con la diferencia centrada", fn() {
        fijo f = "seno(x^2) * e^(x/3) / (1 + x^2)"
        fijo d = derivarFormula(f, "x")
        para x0 en [0.3, 1.1, -2.0] {
            fijo h = 0.000001
            fijo numerica = (evaluarFormula(f, {"x": x0 + h}) - evaluarFormula(f, {"x": x0 - h})) / (2.0 * h)
            debeSerCerca(evaluarFormula(d, {"x": x0}), numerica, 0.000001)
        }
    })
})

grupo("integrar", fn() {
    probar("derivar(integrar(f)) = f, exacto, para una batería", fn() {
        fijo bateria = ["3x^2", "x^3 + 2x - 1", "1/x", "1/(2x + 1)", "(3x - 1)^5", "e^(2x)", "seno(3x)",
            "coseno(x)", "tangente(x)", "ln(x)", "x*e^x", "x^2*seno(x)", "x*ln(x)", "1/(x^2 - 1)", "1/(x^2 + 1)",
            "(x + 1)/(x^2 + 2x + 5)", "1/(x^2 - 2)", "x/(x - 1)^2", "1/raiz(1 - x^2)", "2x*coseno(x^2)",
            "x*e^(x^2)", "seno(x)*coseno(x)", "ln(x)/x", "seno(x)^2", "2^x", "arcotangente(x)", "raiz(x)",
            "1/(x*ln(x))", "e^x*seno(x)", "x^2/(x^3 + 1)", "1/(x^3 - x)", "e^(-x)*x^2", "ln(x)^2", "1/coseno(2x)^2"]
        para f en bateria {
            fijo F = integrarFormula(f, "x")
            debeSerCierto(mismas(derivarFormula(F, "x"), f))
        }
    })
    probar("primitivas de referencia", fn() {
        debeSer(integrarFormula("3x^2", "x"), "x^3")
        debeSer(integrarFormula("1/x", "x"), "ln(abs(x))")
        debeSer(integrarFormula("1/(x^2 + 1)", "x"), "arcotangente(x)")
        debeSer(integrarFormula("a x", "x"), "a*x^2/2")
    })
    probar("integral definida exacta por Barrow", fn() {
        debeSer(integrarFormula("x^2", "x", 0, 3), "9")
        debeSer(integrarFormula("seno(x)", "x", 0, "pi"), "2")
        debeSer(integrarFormula("1/x", "x", 1, "e"), "1")
        debeSer(integrarFormula("1/(1 + x^2)", "x", 0, 1), "pi/4")
        debeSerCerca(evaluarFormula(integrarFormula("e^(-x)", "x", 0, 2)), 1.0 - exp(-2.0), 0.000000000001)
    })
    probar("se niega a cruzar una singularidad", fn() {
        debeFallarCon(fn() { integrarFormula("1/x", "x", -1, 1) }, "no es finita")
    })
    probar("si no sabe, lo dice y sugiere el numérico", fn() {
        debeFallarCon(fn() { integrarFormula("e^(x^2)", "x") }, "no sé integrar")
        debeFallarCon(fn() { integrarFormula("seno(x)/x", "x") }, "no sé integrar")
    })
})

grupo("resolver ecuaciones", fn() {
    probar("lineales y cuadráticas", fn() {
        debeSer(resolverFormula("2x + 3 = 7", "x"), ["2"])
        debeSer(resolverFormula("x^2 - 5x + 6 = 0", "x"), ["2", "3"])
        debeSer(resolverFormula("x^2 - 2 = 0", "x"), ["-raiz(2)", "raiz(2)"])
        debeSer(resolverFormula("x^2 + 1 = 0", "x"), ["-i", "i"])
        debeSer(resolverFormula("x^2 = x", "x"), ["0", "1"])
    })
    probar("las soluciones exactas sustituidas dan cero exacto", fn() {
        para e en ["x^2 + x + 1", "3x^2 - 2x - 1", "x^2 - 4x + 1", "x^3 - 6x^2 + 11x - 6", "x^4 - 5x^2 + 4",
                   "x^3 - 2", "x^4 - 2", "2x^2 + 3x + 5", "x^4 - 10x^2 + 1", "x^4 + 1"] {
            fijo sols = resolverFormula(e + " = 0", "x")
            debeSerCierto(longitud(sols) > 0)
            para s en sols {
                debeSerCierto(anula(e, "x", s))
            }
        }
    })
    probar("con coeficientes con letras", fn() {
        fijo s = resolverFormula("a x^2 + b x + c = 0", "x")
        debeTener(s, 2)
        para r en s {
            debeSerCierto(anula("a x^2 + b x + c", "x", r))
        }
        debeSerCierto(anula("a x + b - c", "x", resolverFormula("a x + b = c", "x")[0]))
    })
    probar("ecuaciones que se aíslan invirtiendo operaciones", fn() {
        debeSer(resolverFormula("e^x = 5", "x"), ["ln(5)"])
        debeSer(resolverFormula("2^x = 8", "x"), ["3"])
        debeSer(resolverFormula("ln(x) = 2", "x"), ["e^2"])
        debeSer(resolverFormula("seno(x) = 1/2", "x"), ["pi/6", "5pi/6"])
        debeSer(resolverFormula("raiz(x + 1) = 3", "x"), ["8"])
        debeSer(resolverFormula("abs(x - 2) = 5", "x"), ["-3", "7"])
        debeSer(resolverFormula("e^(2x) - 3e^x + 2 = 0", "x"), ["0", "ln(2)"])
    })
    probar("descarta las falsas y las que anulan el denominador", fn() {
        debeSer(resolverFormula("raiz(x) = -1", "x"), [])
        debeSer(resolverFormula("(x^2 - 1)/(x - 1) = 0", "x"), ["-1"])
    })
    probar("si no hay forma exacta, la numérica (como real)", fn() {
        fijo s = resolverFormula("x = coseno(x)", "x")
        debeTener(s, 1)
        debeSerTipo(s[0], "real")
        debeSerCerca(s[0], 0.7390851332151607, 0.000000001)
        fijo q = resolverFormula("x^5 - x - 1 = 0", "x")
        debeSerCerca(q[0], 1.1673039782614187, 0.000000001)
        debeTener(q, 5)
    })
    probar("despejar", fn() {
        debeSer(despejar("2y + x = 4", "y"), "y = -x/2 + 2")
        debeSer(despejar("x^2 + y^2 = r^2", "y"), "y = ±raiz(r^2 - x^2)")
        debeSer(despejar("v = d/t", "t"), "t = d/v")
        debeSer(despejar("F = m a", "a"), "a = F/m")
    })
    probar("identidades, contradicciones y variables que no están", fn() {
        debeFallarCon(fn() { resolverFormula("2(x + 1) = 2x + 2", "x") }, "se cumple siempre")
        debeSer(resolverFormula("x + 1 = x", "x"), [])
        debeFallarCon(fn() { resolverFormula("y^2 = 4", "x") }, "no tiene la variable «x»")
        debeFallarCon(fn() { resolverFormula("x = 1", "pi") }, "es una constante")
    })
})

grupo("sistemas lineales", fn() {
    probar("exacto, con fracciones", fn() {
        debeSer(resolverSistemaFormulas(["x + y = 3", "x - y = 1"], ["x", "y"]), {"x": "2", "y": "1"})
        debeSer(resolverSistemaFormulas(["x/2 + y/3 = 1", "x - y = 1/2"], ["x", "y"]), {"x": "7/5", "y": "9/10"})
        debeSer(resolverSistemaFormulas(["2x + y - z = 8", "-3x - y + 2z = -11", "-2x + y + 2z = -3"], ["x", "y", "z"]),
            {"x": "2", "y": "3", "z": "-1"})
    })
    probar("la solución cumple las ecuaciones (con letras)", fn() {
        fijo s = resolverSistemaFormulas(["a x + b y = p", "c x + d y = q"], ["x", "y"])
        debeSerCierto(esCero(sustituirEnFormula("a x + b y - p", {"x": s["x"], "y": s["y"]})))
        debeSerCierto(esCero(sustituirEnFormula("c x + d y - q", {"x": s["x"], "y": s["y"]})))
    })
    probar("incompatible, indeterminado y no lineal", fn() {
        debeFallarCon(fn() { resolverSistemaFormulas(["x + y = 1", "x + y = 2"], ["x", "y"]) }, "incompatible")
        debeFallarCon(fn() { resolverSistemaFormulas(["x + y = 1", "2x + 2y = 2"], ["x", "y"]) }, "indeterminado")
        debeFallarCon(fn() { resolverSistemaFormulas(["x y = 1", "x + y = 2"], ["x", "y"]) }, "no es lineal")
    })
})

grupo("evaluar, sustituir y funciones", fn() {
    probar("evaluar con valores", fn() {
        debeSer(evaluarFormula("x^2 + y", {"x": 2, "y": 3}), 7)
        debeSerCerca(evaluarFormula("raiz(2)"), 1.4142135623730951)
        debeSerCerca(evaluarFormula("x^(1/3)", {"x": -8}), -2)
        debeFallarCon(fn() { evaluarFormula("x + y", {"x": 1}) }, "falta el valor de la variable «y»")
        debeFallarCon(fn() { evaluarFormula("ln(x)", {"x": -1}) }, "no es un número real")
        debeFallarCon(fn() { evaluarFormula("2 + i") }, "unidad imaginaria")
    })
    probar("sustituir números (exactos) y fórmulas", fn() {
        debeSer(sustituirEnFormula("x^2 + 1", {"x": 0.5}), "5/4")
        debeSerCierto(mismas(sustituirEnFormula("x^2 + 1", {"x": "y + 1"}), "y^2 + 2y + 2"))
        debeSer(sustituirEnFormula("seno(x)", {"x": "pi/2"}), "1")
    })
    probar("variables en orden, sin constantes", fn() {
        debeSer(variablesDeFormula("a x^2 + b x + c"), ["a", "b", "c", "x"])
        debeSer(variablesDeFormula("2 pi r + e^i"), ["r"])
        debeSer(variablesDeFormula("y = m x + b"), ["b", "m", "x", "y"])
    })
    probar("formulaAFuncion da una función de Ñ de verdad", fn() {
        fijo g = formulaAFuncion("x^2 + 1", ["x"])
        debeSer(g(3), 10)
        debeSer(mapear([1, 2, 3], g), [2, 5, 10])
        fijo h = formulaAFuncion("x y + 1")
        debeSer(h(2, 5), 11)
        debeFallarCon(fn() { formulaAFuncion("x + z", ["x"]) }, "usa «z»")
        debeFallarCon(fn() { g(1, 2) }, "espera 1 argumento")
    })
    probar("la función compilada coincide con evaluarFormula", fn() {
        fijo f = "seno(x)*e^(-x/4) + raiz(abs(x))"
        fijo g = formulaAFuncion(f, ["x"])
        para x0 en [0.0, 0.5, -3.0, 7.25] {
            debeSerCerca(g(x0), evaluarFormula(f, {"x": x0}), 0.000000000001)
        }
    })
})

grupo("Taylor y límites", fn() {
    probar("series conocidas", fn() {
        debeSer(taylorFormula("exp(x)", "x", 0, 4), "1 + x + x^2/2 + x^3/6 + x^4/24")
        debeSer(taylorFormula("seno(x)", "x", 0, 7), "x - x^3/6 + x^5/120 - x^7/5040")
        debeSer(taylorFormula("1/(1 - x)", "x", 0, 3), "1 + x + x^2 + x^3")
        debeSer(taylorFormula("ln(x)", "x", 1, 3), "x - 1 - (x - 1)^2/2 + (x - 1)^3/3")
        debeSer(taylorFormula("tangente(x)", "x", 0, 5), "x + x^3/3 + 2x^5/15")
    })
    probar("el polinomio se acerca a la función cerca del punto", fn() {
        fijo p = taylorFormula("coseno(x)", "x", "pi", 8)
        debeSerCerca(evaluarFormula(p, {"x": 3.0}), evaluarFormula("coseno(x)", {"x": 3.0}), 0.0000000001)
    })
    probar("y se niega donde la función no es derivable", fn() {
        debeFallarCon(fn() { taylorFormula("ln(x)", "x", 0, 3) }, "no está definida")
    })
    probar("límites con 0/0, 0·∞ y en el infinito", fn() {
        debeSer(limiteFormula("seno(x)/x", "x", 0), "1")
        debeSer(limiteFormula("(x^2 - 1)/(x - 1)", "x", 1), "2")
        debeSer(limiteFormula("(1 - coseno(x))/x^2", "x", 0), "1/2")
        debeSer(limiteFormula("(e^x - 1)/x", "x", 0), "1")
        debeSer(limiteFormula("x ln(x)", "x", 0), "0")
        debeSer(limiteFormula("(raiz(x) - 2)/(x - 4)", "x", 4), "1/4")
        debeSer(limiteFormula("x^2 + 3", "x", 2), "7")
        debeSer(limiteFormula("1/x^2", "x", 0), "infinito")
        debeSer(limiteFormula("(2x^2 + 1)/(x^2 - 3)", "x", "infinito"), "2")
        debeSer(limiteFormula("x^3/(x + 1)", "x", "-infinito"), "infinito")
        debeFallarCon(fn() { limiteFormula("1/x", "x", 0) }, "el límite no existe")
    })
})

grupo("impresión", fn() {
    probar("LaTeX", fn() {
        debeSer(formulaALatex("x^2/2 + raiz(x)"), '\\frac{x^{2}}{2} + \\sqrt{x}')
        debeSer(formulaALatex("seno(x) = 1/2"), '\\sin\\left(x\\right) = \\frac{1}{2}')
    })
    probar("texto bonito, que también se vuelve a leer", fn() {
        debeSer(formulaATexto("3x^2 + raiz(2)*pi"), "3x² + √2·π")
        debeSer(formulaATexto("abs(x) - 1"), "|x| − 1")
        para f en ["x^10/3 + raiz(2)*pi - abs(x) + x^(1/3)", "(x + 1)^2/(2x)", "e^(-x^2)*seno(x)"] {
            debeSer(simplificarFormula(formulaATexto(f)), simplificarFormula(f))
        }
    })
    probar("la salida canónica se vuelve a leer igual", fn() {
        para f en ["(x + 1)^2/(2x)", "-(x + 1)", "raiz(x^2 + 1)*e^(-x)", "3x*y^2 - 2/(a*b)", "2^(1/3)*i - 1/2"] {
            fijo s = simplificarFormula(f)
            debeSer(simplificarFormula(s), s)
        }
    })
})

grupo("al azar: la forma simplificada vale lo mismo", fn() {
    # Fórmulas aleatorias de hasta tres niveles; para cada una, la simplificada,
    # la expandida y la factorizada tienen que valer lo mismo en tres puntos.
    fn hoja(): texto { devolver elegir(["x", "y", "2", "3", "1/2", "x", "-1", "0.25"]) }
    fn formula(n: entero): texto {
        si n == 0 { devolver hoja() }
        fijo k = azarEntre(0, 6)
        si k == 0 { devolver "(" + formula(n - 1) + ") + (" + formula(n - 1) + ")" }
        si k == 1 { devolver "(" + formula(n - 1) + ") - (" + formula(n - 1) + ")" }
        si k == 2 { devolver "(" + formula(n - 1) + ")*(" + formula(n - 1) + ")" }
        si k == 3 { devolver "(" + formula(n - 1) + ")/(" + formula(n - 1) + " + 5)" }
        si k == 4 { devolver "(" + formula(n - 1) + ")^" + elegir(["2", "3", "-1"]) }
        si k == 5 { devolver elegir(["seno", "coseno", "exp", "arcotangente"]) + "(" + formula(n - 1) + ")" }
        devolver hoja()
    }
    fn cerca(a: real, b: real): bool { devolver absoluto(a - b) <= 0.000001 * (1.0 + absoluto(a) + absoluto(b)) }
    probar("120 fórmulas aleatorias", fn() {
        semilla(2026)
        var buenas = 0
        var comparadas = 0
        para k en rango(120) {
            fijo f = formula(3)
            # Las que dividen entre cero al leerse o no son reales en el
            # punto se saltan: lo que se compara son valores.
            var fs: lista = []
            var ok = verdadero
            intentar {
                fs = [simplificarFormula(f), expandirFormula(f), factorizarFormula(f)]
            } capturar {
                ok = falso
            }
            si ok {
                para p en [[0.7, 1.3], [2.1, -0.4], [-1.7, 0.9]] {
                    # Los valores se calculan dentro de «intentar» y se
                    # comparan FUERA: un fallo de afirmación capturado ahí
                    # dentro pasaría desapercibido.
                    var vs: lista = []
                    intentar {
                        vs = [evaluarFormula(f, {"x": p[0], "y": p[1]})]
                        para g en fs { vs = vs + [evaluarFormula(g, {"x": p[0], "y": p[1]})] }
                    } capturar { vs = [] }
                    para v en vs { debeSerCierto(cerca(v, vs[0])) }
                    si longitud(vs) > 0 { comparadas = comparadas + 1 }
                }
                buenas = buenas + 1
            }
        }
        debeSerCierto(buenas > 100)
        debeSerCierto(comparadas > 200)
    })
    probar("simplificar(expandir(f) - f) = 0 para fórmulas polinómicas al azar", fn() {
        semilla(7)
        para k en rango(40) {
            fijo f = "(" + texto(azarEntre(-3, 3)) + "x + " + texto(azarEntre(-3, 3)) + "y)^" + texto(azarEntre(1, 4)) +
                     " * (x - " + texto(azarEntre(-3, 3)) + ")"
            debeSerCierto(esCero(expandirFormula(f) + " - (" + f + ")"))
        }
    })
})

var r: dic = correrPruebas()
imprimir("")
imprimir(resumenPruebas())
