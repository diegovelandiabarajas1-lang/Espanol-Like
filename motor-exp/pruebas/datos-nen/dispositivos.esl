# (motor-exp N2) Lo mismo en jit y en el dispositivo que se pida (nativo o gpu).
# Cada prueba se calcula dos veces: una con usarDispositivo("jit") y otra con el
# dispositivo de la línea de órdenes, y se comparan. Las exactas, número a número
# con ==; las que usan seno, exp… (la biblioteca matemática de cada sitio
# redondea a su manera), a 1e-14 relativo. La salida es una línea por prueba.
usar usarDispositivo, dispositivo, azarArreglo, semilla, aListaA, reparto de "nen"
usar senoA, expA, raizA, reluA, redondearA, potenciaA, softmax, sumaEje, mediaEje, normaEje, maximoEje de "nen"
usar por, multLotes, transpuesta, fourier, fourierInversa, espectro, convolucion de "nen"
usar suma, media, varianza, desviacion, parteReal, parteImaginaria, absolutoA, absoluto, maximoDe, copia de "nen"

fijo D = argumentos()[0]

fn mismo(a, b) -> bool {
    si tipo(a) != "arreglo" { devolver a == b }
    si tipo(b) != "arreglo" { devolver falso }
    devolver aListaA(parteReal(a)) == aListaA(parteReal(b)) y aListaA(parteImaginaria(a)) == aListaA(parteImaginaria(b))
}
fn cerca(a, b) -> bool {
    si tipo(a) != "arreglo" { devolver absoluto(a - b) <= 1.0e-14 * maximo(1.0, absoluto(a)) }
    fijo d = maximoEje(absolutoA(a - b))
    devolver d <= 1.0e-14 * maximo(1.0, maximoEje(absolutoA(a)))
}
fn exacta(nombre: texto, f) {
    usarDispositivo("jit")
    fijo r1 = f()
    usarDispositivo(D)
    fijo r2 = f()
    imprimir(nombre + ": " + texto(mismo(r1, r2)))
}
fn aprox(nombre: texto, f) {
    usarDispositivo("jit")
    fijo r1 = f()
    usarDispositivo(D)
    fijo r2 = f()
    imprimir(nombre + ": " + texto(cerca(r1, r2)))
}

semilla(7)
fijo x = azarArreglo([300000]) * 4 - 2
fijo y = azarArreglo([300000])
fijo M = azarArreglo([600, 700])
fijo A = azarArreglo([130, 170])
fijo B = azarArreglo([170, 90])
fijo L1 = azarArreglo([3, 70, 80])
fijo L2 = azarArreglo([3, 80, 60])
fijo pot2 = reparto(0.0, 1.0, 65536)
fijo nopot = azarArreglo([50000])

exacta("x * 2 + 1", fn() { devolver x * 2 + 1 })
exacta("2 - x / 3", fn() { devolver 2 - x / 3 })
exacta("x * y - y", fn() { devolver x * y - y })
exacta("x / (y + 1)", fn() { devolver x / (y + 1) })
exacta("suma", fn() { devolver suma(x) })
exacta("media", fn() { devolver media(y) })
exacta("varianza", fn() { devolver varianza(x) })
exacta("desviacion", fn() { devolver desviacion(y) })
exacta("reluA", fn() { devolver reluA(x) })
exacta("redondearA", fn() { devolver redondearA(x, 3) })
exacta("raizA", fn() { devolver raizA(y) })
exacta("sumaEje 1", fn() { devolver sumaEje(M, 1) })
exacta("sumaEje 0", fn() { devolver sumaEje(M, 0) })
exacta("mediaEje", fn() { devolver mediaEje(M) })
exacta("maximoEje", fn() { devolver maximoEje(M, 1) })
exacta("normaEje", fn() { devolver normaEje(M, 1) })
exacta("por", fn() { devolver por(A, B) })
exacta("por grande", fn() { devolver por(M, transpuesta(M)) })
exacta("multLotes", fn() { devolver multLotes(L1, L2) })
exacta("fourier 2^16", fn() { devolver fourier(pot2) })
exacta("fourierInversa 2^16", fn() { devolver fourierInversa(fourier(pot2)) })
exacta("espectro", fn() { devolver espectro(pot2) })
exacta("fourier 50000", fn() { devolver fourier(nopot) })
exacta("convolucion", fn() { devolver convolucion(nopot, pot2) })
aprox("senoA", fn() { devolver senoA(x) })
aprox("expA", fn() { devolver expA(x) })
aprox("potenciaA", fn() { devolver potenciaA(y, 2.5) })
aprox("softmax", fn() { devolver softmax(M) })
aprox("cadena", fn() { devolver suma(expA(senoA(x)) * 2 + 1) })

# lo que sale de la GPU tiene que poder leerse y cambiarse desde la CPU
usarDispositivo(D)
fijo z = x * 2 + 1
fijo w = copia(z)
z[0] = 100.0
imprimir("leer y escribir: " + texto(z[0] == 100.0 y w[0] != 100.0))
fijo z2 = z * 1
imprimir("escribir en la CPU y volver: " + texto(z2[0] == 100.0))

# dividir entre cero sigue siendo un error, también en el núcleo
intentar { fijo q = x / (y * 0) } capturar (e) { imprimir("entre cero: " + e.mensaje) }
intentar { fijo q = 1 / (y * 0) } capturar (e) { imprimir("uno entre cero: " + e.mensaje) }
intentar { fijo q = x / 0 } capturar (e) { imprimir("arreglo entre 0: " + e.mensaje) }
imprimir("fin en " + dispositivo())
