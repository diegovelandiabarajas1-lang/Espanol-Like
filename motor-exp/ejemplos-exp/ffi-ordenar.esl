# C haciendo las cuentas sobre un arreglo de Ñ, sin copiarlo.
#   gcc -shared -fPIC -O2 -o libordenar.so ffi-ordenar.c
#   node motor-exp/util/n-node.js ffi-ordenar.esl ./libordenar.so
usar tipoNativo de "nativo"
usar arreglo de "numerico"
fijo LIB = argumentos()[0]

# Las firmas, tal como están en el .c. Lo marcado _Out_ no se pasa: se devuelve.
fijo estadisticas = nativa(LIB, "void estadisticas(const double *a, int n, _Out_ double *media, _Out_ double *desv)")
tipoNativo("int Antes(double, double)")
fijo ordenarC = nativa(LIB, "void ordenar(double *a, int n, Antes *antes)")

var notas = arreglo([3.5, 4.8, 2.9, 4.1, 3.9, 5.0])
fijo [media, desv] = estadisticas(notas, 6)
imprimir("media", redondear(media, 2), "desviación", redondear(desv, 2))

# El criterio de orden lo escribe Ñ y lo llama C.
ordenarC(notas, 6, funcion(a, b) { devolver si a > b entonces 1 sino 0 })
imprimir("de mayor a menor:", notas)
usar redondear de "numerico"
