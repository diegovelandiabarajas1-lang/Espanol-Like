# Una pequeña API de tareas en Ñ, guardada en un archivo JSON.
#   node motor-exp/util/n-node.js motor-exp/ejemplos-exp/servidor-tareas.esl
# y luego, en el navegador:  http://127.0.0.1:8080/tareas
#   POST /tareas con el texto de la tarea en el cuerpo  → la crea
#   POST /tareas/3/hecha                                → la marca
usar servir, respuesta, unirRuta, carpetaActual de "sistema"
usar dividir de "texto"

fijo ARCHIVO = unirRuta(carpetaActual(), "tareas.json")
var tareas = []
si existeArchivo(ARCHIVO) { tareas = deJson(leerTexto(ARCHIVO)) }
fn guardar() { escribirTexto(ARCHIVO, aJson(tareas, cierto)) }

fn atender(p) {
  fijo partes = dividir(p["ruta"], "/")
  si p["ruta"] == "/" {
    var lis = ""
    para t en tareas { lis = lis + "<li>" + (si t["hecha"] entonces "✔ " sino "") + t["texto"] + "</li>" }
    devolver "<h1>Tareas</h1><ul>" + lis + "</ul>"
  }
  si p["ruta"] == "/tareas" y p["metodo"] == "GET" { devolver tareas }
  si p["ruta"] == "/tareas" y p["metodo"] == "POST" {
    si p["cuerpo"] == "" { devolver respuesta(400, "el cuerpo es el texto de la tarea") }
    fijo t = {"id": longitud(tareas) + 1, "texto": p["cuerpo"], "hecha": falso}
    agregar(tareas, t)
    guardar()
    devolver respuesta(201, t)
  }
  si longitud(partes) == 4 y partes[1] == "tareas" y partes[3] == "hecha" y p["metodo"] == "POST" {
    para t en tareas { si texto(t["id"]) == partes[2] {
        t["hecha"] = cierto
        guardar()
        devolver t } }
    devolver respuesta(404, "no hay tarea " + partes[2])
  }
  devolver respuesta(404, "no está: " + p["ruta"])
}

servir(8080, atender)
imprimir("escuchando en http://127.0.0.1:8080 · Ctrl+C para parar")
