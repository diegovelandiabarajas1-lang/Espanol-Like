# ECOSIM-5 · versión 1 · mercado cerrado con salarios, dividendos, bancos y reseñas
#
# Uso (desde D:\ProyectosJS):
#   node motor/util/n-node.js ecosim/ecosim.esl [ticks] [semilla]
# Un tick = un segundo simulado. Por defecto 7200 ticks (2 horas).
# Deja la serie de tiempo en ecosim/salida.csv (una fila por minuto simulado).
#
# Las tres masas que no pueden aparecer ni desaparecer:
#   · DINERO   en centavos, entero. Solo se crea en el tick 0. Toda transferencia
#              pasa por «transferir», que mueve también las reservas del banco.
#   · ACCIONES 1000 por empresa, emitidas en el IPO. Una compra en bolsa siempre
#              tiene un vendedor real: nunca se le compra a la empresa.
#   · BIENES   producido = consumido + inventario, siempre.
#
# Todo el azar sale de «h(tick, quien, canal)», un hash sin estado: el mismo
# programa con la misma semilla da lo mismo en cualquier máquina, y la versión
# para GPU puede reproducirlo hilo por hilo sin compartir un generador.

# ─────────────────────────────────────────────── tamaño y parámetros
fijo N_AG = 5000                    # compradores (también trabajan y pueden invertir)
fijo N_INV = 500                    # inversores bot
fijo N_NICHO = 5
fijo POR_NICHO = 5
fijo N_EMP = N_NICHO * POR_NICHO    # 25 empresas
fijo N_BANCO = 3
fijo ACC = 1000                     # acciones por empresa
fijo TENEDORES = N_AG + N_INV       # cuentas 0..N_AG-1 agentes, luego inversores
fijo C_EMP = TENEDORES              # cuentas de las empresas empiezan aquí
fijo N_CTA = TENEDORES + N_EMP
fijo M0 = 1000000000                # 10 M de monedas = 1.000 M de centavos
fijo CREDITO = falso                # interruptor: los bancos aún no prestan
fijo VERIFICAR_CADA = 60            # verificación completa cada minuto simulado
fijo NICHOS = ["Agua", "Comida", "Tecnología", "Entretenimiento", "Random"]
fijo PRECIO_BASE = [800, 1200, 3000, 1500, 1000]
fijo SALARIO_HORA = 6000            # centavos por hora por trabajador
fijo P = 94906249                   # primo con P*P < 2^53: el hash cabe en un real

var SEMILLA = 20261012

# ─────────────────────────────────────────────── azar sin estado
fn h(a: entero, b: entero, c: entero): entero {
  var x = (a * 7919 + b * 104729 + c * 1299709 + SEMILLA) % P
  x = (x * x + 12345) % P
  x = (x * x + 54321) % P
  devolver x
}

# ─────────────────────────────────────────────── estado
var saldo: lista<entero> = []         # una cuenta por agente, inversor y empresa
var bancoDe: lista<entero> = []
var reservas: lista<entero> = []      # 100 %: cada banco guarda lo depositado
var porBanco: lista<entero> = []      # para verificar: depósitos sumados por banco

var hambre: lista<entero> = []        # barras 0..10000
var aburr: lista<entero> = []
var curio: lista<entero> = []
var empleo: lista<entero> = []        # empresa o -1
var eleccion: lista<entero> = []      # empresa elegida este tick o -1

var nicho: lista<entero> = []
var precio: lista<entero> = []
var inv: lista<entero> = []
var progreso: lista<entero> = []
var trab: lista<entero> = []
var calidad: lista<entero> = []       # oculta, 1..5
var estrellas: lista<entero> = []     # suma de estrellas × 100
var resenas: lista<entero> = []
var pendEst: lista<entero> = []       # reseñas de este tick: se aplican al final
var pendRes: lista<entero> = []
var ventasHora: lista<entero> = []
var pz: lista<entero> = []          # puntaje de cada empresa, una vez por tick
var precioAcc: lista<entero> = []
var precioAccAnt: lista<entero> = []
var divUltimo: lista<entero> = []     # último dividendo por acción
var tenencia: lista<lista<entero>> = []

var producido = 0
var consumido = 0
var csv = "tick,desempleo,indice_bolsa,dinero_agentes,dinero_inversores,dinero_empresas,precio_agua,precio_comida,precio_tec,precio_entret,precio_random,estrellas_medias,operaciones_bolsa\n"
var operaciones = 0

# ─────────────────────────────────────────────── dinero: la única puerta
fn transferir(de: entero, a: entero, monto: entero): bool {
  si monto <= 0 o saldo[de] < monto { devolver falso }
  saldo[de] = saldo[de] - monto
  saldo[a] = saldo[a] + monto
  fijo bd = bancoDe[de]
  fijo ba = bancoDe[a]
  si bd != ba {
    reservas[bd] = reservas[bd] - monto
    reservas[ba] = reservas[ba] + monto
  }
  devolver cierto
}

# ─────────────────────────────────────────────── tick 0
fn iniciar() {
  para b en rango(N_BANCO) { agregar(reservas, 0)
    agregar(porBanco, 0) }
  # el dinero se reparte UNA vez: 40 % agentes, 30 % inversores, 30 % empresas
  fijo porAg = (M0 * 4 // 10) // N_AG
  fijo porInv = (M0 * 3 // 10) // N_INV
  para c en rango(N_CTA) {
    var s = 0
    si c < N_AG { s = porAg } sino si c < TENEDORES { s = porInv }
    agregar(saldo, s)
    agregar(bancoDe, h(0, c, 1) % N_BANCO)
  }
  # lo que no cupo en las divisiones enteras va a las empresas: nada se pierde
  var repartido = 0
  para c en rango(TENEDORES) { repartido += saldo[c] }
  fijo paraEmp = M0 - repartido
  para e en rango(N_EMP) {
    saldo[C_EMP + e] = paraEmp // N_EMP
    si e == 0 { saldo[C_EMP] = saldo[C_EMP] + paraEmp % N_EMP }
  }
  para c en rango(N_CTA) { reservas[bancoDe[c]] = reservas[bancoDe[c]] + saldo[c] }

  para i en rango(N_AG) {
    agregar(hambre, h(0, i, 2) % 4000)
    agregar(aburr, h(0, i, 3) % 4000)
    agregar(curio, h(0, i, 4) % 4000)
    agregar(empleo, -1)
    agregar(eleccion, -1)
  }
  para e en rango(N_EMP) {
    fijo n = e // POR_NICHO
    agregar(nicho, n)
    agregar(precio, PRECIO_BASE[n] + h(0, e, 5) % (PRECIO_BASE[n] // 2))
    agregar(inv, 300)
    agregar(progreso, 0)
    agregar(trab, 0)
    fijo q = 1 + h(0, e, 6) % 5
    agregar(calidad, q)
    # reseñas preestablecidas: 20 reseñas que NO tienen por qué coincidir con la calidad
    fijo fama = 1 + h(0, e, 7) % 5
    agregar(estrellas, 20 * fama * 100)
    agregar(resenas, 20)
    agregar(pendEst, 0)
    agregar(pendRes, 0)
    agregar(ventasHora, 0)
    agregar(precioAcc, 5000)
    agregar(precioAccAnt, 5000)
    agregar(divUltimo, 0)
    agregar(pz, 0)
    var fila: lista<entero> = []
    para d en rango(TENEDORES) { agregar(fila, 0) }
    para k en rango(ACC) {
      fijo d = h(0, e * ACC + k, 8) % TENEDORES
      fila[d] = fila[d] + 1
    }
    agregar(tenencia, fila)
  }
  producido = 300 * N_EMP
  # todos empiezan empleados, repartidos entre las 25 empresas
  para i en rango(N_AG) {
    empleo[i] = i % N_EMP
    trab[i % N_EMP] = trab[i % N_EMP] + 1
  }
}

# ─────────────────────────────────────────────── consumidores
fn puntaje(e: entero): entero {
  # reputación (estrellas medias × 100, de 100 a 500) frente a precio
  devolver (estrellas[e] // resenas[e]) * 4 - precio[e]
}

# Fase 1: cada agente decide qué quiere, con los precios y reseñas del inicio
# del tick. Nadie ve lo que eligió otro: así es paralelizable.
fn elegir(t: entero) {
  para e en rango(N_EMP) { pz[e] = puntaje(e) }
  # alias locales y «si» en vez de minimo(): bajo el JIT, una lista local y una
  # comparación cuestan menos de la mitad que una global y una llamada
  fijo H = hambre
  fijo A = aburr
  fijo C = curio
  fijo E = eleccion
  fijo Z = pz
  para i en rango(N_AG) {
    var hh = H[i] + 3
    si hh > 10000 { hh = 10000 }
    H[i] = hh
    var aa = A[i] + 2
    si aa > 10000 { aa = 10000 }
    A[i] = aa
    var cc = C[i] + 1
    si cc > 10000 { cc = 10000 }
    C[i] = cc
    var n = -1
    si hh >= 4000 y hh >= aa y hh >= cc {
      n = (t + i) % 2                           # agua o comida, alternando
    } sino si aa >= 4000 y aa >= cc {
      n = 3
    } sino si cc >= 4000 {
      n = 2
    } sino si (t + i * 7) % 3000 == 0 {
      n = 4                                     # Random: compra por impulso, una vez cada 50 min
    }
    si n < 0 {
      E[i] = -1
    } sino {
      # dos candidatas al azar del nicho; gana la de mejor puntaje
      fijo r = h(t, i, 12)
      fijo a = n * POR_NICHO + r % POR_NICHO
      fijo b = n * POR_NICHO + (r // POR_NICHO) % POR_NICHO
      si Z[a] >= Z[b] { E[i] = a } sino { E[i] = b }
    }
  }
}

# Fase 2: asignación. Se recorre en un orden rotado que cambia cada tick; el
# primero que llega a un estante vacío se queda sin comprar. En GPU esto es una
# suma de prefijos por empresa en el mismo orden: mismo resultado.
fn asignar(t: entero) {
  fijo inicio = h(t, 0, 14) % N_AG
  fijo E = eleccion
  para j en rango(N_AG) {
    var i = inicio + j
    si i >= N_AG { i = i - N_AG }
    fijo e = E[i]
    si e >= 0 y inv[e] > 0 {
      si transferir(i, C_EMP + e, precio[e]) {
        inv[e] = inv[e] - 1
        consumido += 1
        ventasHora[e] = ventasHora[e] + 1
        fijo n = nicho[e]
        si n <= 1 { hambre[i] = hambre[i] - 4500
          si hambre[i] < 0 { hambre[i] = 0 } }
        sino si n == 3 { aburr[i] = aburr[i] - 4500
          si aburr[i] < 0 { aburr[i] = 0 } }
        sino si n == 2 { curio[i] = curio[i] - 4500
          si curio[i] < 0 { curio[i] = 0 } }
        # una compra de cada diez deja reseña: calidad ± 1
        si h(t, i, 15) % 10 == 0 {
          fijo est = maximo(1, minimo(5, calidad[e] + h(t, i, 16) % 3 - 1))
          pendEst[e] = pendEst[e] + est * 100
          pendRes[e] = pendRes[e] + 1
        }
      }
    }
  }
  para e en rango(N_EMP) {
    estrellas[e] = estrellas[e] + pendEst[e]
    resenas[e] = resenas[e] + pendRes[e]
    pendEst[e] = 0
    pendRes[e] = 0
  }
}

# ─────────────────────────────────────────────── empresas
fn producir() {
  para e en rango(N_EMP) {
    # 4,8 unidades por trabajador y hora
    progreso[e] = progreso[e] + trab[e] * 48
    fijo u = progreso[e] // 36000
    progreso[e] = progreso[e] % 36000
    inv[e] = inv[e] + u
    producido += u
  }
}

# Cada hora: salarios, precio y plantilla según inventario frente a ventas
fn cadaHora() {
  para i en rango(N_AG) {
    fijo e = empleo[i]
    si e >= 0 {
      si no transferir(C_EMP + e, i, SALARIO_HORA) {
        empleo[i] = -1                            # sin caja para pagar: despide
        trab[e] = trab[e] - 1
      }
    }
  }
  para e en rango(N_EMP) {
    fijo v = maximo(1, ventasHora[e])
    si inv[e] > 2 * v { precio[e] = maximo(100, precio[e] * 98 // 100) }
    si inv[e] < v // 2 { precio[e] = precio[e] * 102 // 100 + 1 }
    # demasiado inventario: despide un 5 %; poco y con caja: contrata
    si inv[e] > 3 * v y trab[e] > 0 {
      var quitar = maximo(1, trab[e] // 20)
      para i en rango(N_AG) {
        si quitar > 0 y empleo[i] == e { empleo[i] = -1
          trab[e] = trab[e] - 1
          quitar -= 1 }
      }
    }
    si inv[e] < v y saldo[C_EMP + e] > (trab[e] + 10) * SALARIO_HORA * 2 {
      var poner = 10
      para i en rango(N_AG) {
        si poner > 0 y empleo[i] == -1 { empleo[i] = e
          trab[e] = trab[e] + 1
          poner -= 1 }
      }
    }
    ventasHora[e] = 0
  }
}

# Cada 10 minutos: dividendos. Se reparte la mitad de lo que sobra por encima de
# dos horas de nómina; el resto de la división entera se queda en la empresa.
fn dividendos() {
  para e en rango(N_EMP) {
    fijo reserva = (trab[e] + 10) * SALARIO_HORA * 2
    fijo exceso = saldo[C_EMP + e] - reserva
    divUltimo[e] = 0
    si exceso > 0 {
      fijo porAccion = (exceso // 2) // ACC
      si porAccion > 0 {
        divUltimo[e] = porAccion
        fijo fila = tenencia[e]
        para d en rango(TENEDORES) {
          si fila[d] > 0 { transferir(C_EMP + e, d, fila[d] * porAccion) }
        }
      }
    }
  }
}

# ─────────────────────────────────────────────── bolsa: subasta de cierre cada minuto
# Órdenes de una acción cada una, codificadas como precio*10000 + tenedor.
# Precio único de casación: el de la última pareja que cruza. Todos los que
# casan pagan ese precio; toda compra tiene un vendedor que sí tiene la acción.
fn bolsa(t: entero) {
  # Un solo recorrido de inversores y otro de agentes arma los 25 libros de
  # órdenes; cada participante mira una sola empresa por sesión.
  var compras: lista<lista<entero>> = []
  var ventas: lista<lista<entero>> = []
  var valor: lista<entero> = []
  para e en rango(N_EMP) {
    agregar(compras, [])
    agregar(ventas, [])
    # valor fundamental: el último dividendo como si se repitiera 30 veces
    si divUltimo[e] > 0 { agregar(valor, divUltimo[e] * 30) } sino { agregar(valor, precioAcc[e]) }
  }
  para k en rango(N_INV) {
    fijo d = N_AG + k
    fijo r = h(t, d, 20)
    fijo e = r % N_EMP
    fijo p = precioAcc[e]
    fijo estilo = k % 3
    var lado = -1
    si estilo == 0 {                                   # fundamental
      si p * 10 < valor[e] * 9 { lado = 0 } sino si p * 10 > valor[e] * 11 { lado = 1 }
    } sino si estilo == 1 {                            # sigue la tendencia
      si p > precioAccAnt[e] { lado = 0 } sino si p < precioAccAnt[e] { lado = 1 }
    } sino { lado = (r // N_EMP) % 2 }                 # ruido
    fijo cant = 1 + (r // 50) % 5
    fijo ajuste = (r // 250) % 4
    si lado == 0 {
      fijo lim = p * (100 + ajuste) // 100 + 1
      si saldo[d] >= lim * cant { para q en rango(cant) { agregar(compras[e], lim * 10000 + d) } }
    } sino si lado == 1 y tenencia[e][d] > 0 {
      fijo lim = maximo(1, p * (100 - ajuste) // 100)
      para q en rango(minimo(cant, tenencia[e][d])) { agregar(ventas[e], lim * 10000 + d) }
    }
  }
  # agentes: uno de cada veinte va a la bolsa; vende si se quedó sin liquidez,
  # compra si le sobra
  para i en rango(N_AG) {
    fijo r = h(t, i, 24)
    si r % 20 == 0 {
      fijo e = (r // 20) % N_EMP
      fijo p = precioAcc[e]
      si saldo[i] < SALARIO_HORA y tenencia[e][i] > 0 {
        agregar(ventas[e], maximo(1, p * 95 // 100) * 10000 + i)
      } sino si saldo[i] > 40 * SALARIO_HORA {
        agregar(compras[e], (p * 101 // 100 + 1) * 10000 + i)
      }
    }
  }
  para e en rango(N_EMP) { casar(e, compras[e], ventas[e]) }
}

# Subasta de una empresa. Órdenes de una acción cada una, codificadas como
# precio*10000 + tenedor. Precio único: el punto medio de la última pareja que
# cruza. Todos los que casan pagan ese precio; toda compra tiene un vendedor que
# sí tiene la acción, y si el comprador ya no tiene el dinero, esa pareja no se hace.
fn casar(e: entero, libroC: lista<entero>, libroV: lista<entero>) {
  fijo c: lista<entero> = invertir(ordenar(libroC))
  fijo v: lista<entero> = ordenar(libroV)
  fijo fila = tenencia[e]
  var k = 0
  fijo maxk = minimo(longitud(c), longitud(v))
  mientras k < maxk y c[k] // 10000 >= v[k] // 10000 { k += 1 }
  precioAccAnt[e] = precioAcc[e]
  si k > 0 {
    fijo pc = (c[k - 1] // 10000 + v[k - 1] // 10000) // 2
    para j en rango(k) {
      fijo comprador = c[j] % 10000
      fijo vendedor = v[j] % 10000
      si comprador != vendedor y fila[vendedor] > 0 {
        si transferir(comprador, vendedor, pc) {
          fila[vendedor] = fila[vendedor] - 1
          fila[comprador] = fila[comprador] + 1
          operaciones += 1
        }
      }
    }
    precioAcc[e] = pc
  }
}

# ─────────────────────────────────────────────── invariantes
# El JIT de Ñ no compila funciones que contienen «lanzar». Por eso el cálculo
# va en «revisar», que sí se compila y devuelve un código, y solo el aviso vive
# en «verificar». Con el «lanzar» dentro del bucle, esto corría 50 veces más lento.
fn revisar(): entero {
  fijo S = saldo
  fijo B = bancoDe
  var total = 0
  para b en rango(N_BANCO) { porBanco[b] = 0 }
  para c en rango(N_CTA) {
    si S[c] < 0 { devolver 1 }
    total += S[c]
    porBanco[B[c]] = porBanco[B[c]] + S[c]
  }
  si total != M0 { devolver 2 }
  para b en rango(N_BANCO) { si porBanco[b] != reservas[b] { devolver 3 } }
  para e en rango(N_EMP) {
    fijo fila = tenencia[e]
    var s = 0
    para d en rango(TENEDORES) { s += fila[d] }
    si s != ACC { devolver 4 }
  }
  var enEstante = 0
  para e en rango(N_EMP) { enEstante += inv[e] }
  si producido != consumido + enEstante { devolver 5 }
  devolver 0
}

fn verificar(t: entero) {
  fijo r = revisar()
  si r == 1 { lanzar error("tick {t}: una cuenta quedó en negativo") }
  si r == 2 { lanzar error("tick {t}: dinero fantasma: el total ya no es {M0} centavos") }
  si r == 3 { lanzar error("tick {t}: las reservas de un banco no cuadran con sus depósitos") }
  si r == 4 { lanzar error("tick {t}: una empresa ya no tiene exactamente {ACC} acciones") }
  si r == 5 { lanzar error("tick {t}: bienes que no cuadran: producido ≠ consumido + inventario") }
}

# ─────────────────────────────────────────────── serie de tiempo
fn fila(t: entero) {
  var parados = 0
  para i en rango(N_AG) { si empleo[i] < 0 { parados += 1 } }
  var indice = 0
  para e en rango(N_EMP) { indice += precioAcc[e] }
  var dAg = 0
  para c en rango(N_AG) { dAg += saldo[c] }
  var dInv = 0
  para c en rango(N_INV) { dInv += saldo[N_AG + c] }
  var dEmp = 0
  para e en rango(N_EMP) { dEmp += saldo[C_EMP + e] }
  var linea = "{t},{parados},{indice // N_EMP},{dAg},{dInv},{dEmp}"
  para n en rango(N_NICHO) {
    var s = 0
    para k en rango(POR_NICHO) { s += precio[n * POR_NICHO + k] }
    linea = linea + ",{s // POR_NICHO}"
  }
  var est = 0
  para e en rango(N_EMP) { est += estrellas[e] // resenas[e] }
  csv = csv + linea + ",{est // N_EMP},{operaciones}\n"
}

fn tick(t: entero) {
  elegir(t)
  asignar(t)
  producir()
  si t % 60 == 0 { bolsa(t) }
  si t % 3600 == 3599 { cadaHora() }
  si t % 600 == 599 { dividendos() }
  si t % VERIFICAR_CADA == 0 { verificar(t) }
  si t % 60 == 0 { fila(t) }
}

fn correr(ticks: entero) {
  para t en rango(ticks) { tick(t) }
  verificar(ticks)
}

# ─────────────────────────────────────────────── principal
var TICKS = 7200
fijo args = argumentos()
si longitud(args) > 0 { TICKS = entero(args[0]) }
si longitud(args) > 1 { SEMILLA = entero(args[1]) }

iniciar()
verificar(0)
fijo t0 = reloj()
correr(TICKS)
fijo ms = reloj() - t0
escribirTexto("ecosim/salida.csv", csv)

imprimir("ECOSIM-5 · {N_AG} compradores · {N_INV} inversores · {N_EMP} empresas · semilla {SEMILLA}")
imprimir("{TICKS} ticks en {entero(ms)} ms · {ms / TICKS} ms por tick")
imprimir("invariantes: dinero {M0} centavos ✓ · {N_EMP * ACC} acciones ✓ · bienes ✓ (producido {producido}, consumido {consumido})")
var parados = 0
para i en rango(N_AG) { si empleo[i] < 0 { parados += 1 } }
imprimir("desempleo {parados} de {N_AG} · operaciones en bolsa {operaciones}")
para n en rango(N_NICHO) {
  imprimir("  {NICHOS[n]}")
  para k en rango(POR_NICHO) {
    fijo e = n * POR_NICHO + k
    imprimir("    #{e}  caja {saldo[C_EMP + e] // 100} · precio {precio[e]} · inv {inv[e]} · trab {trab[e]} · ★{estrellas[e] // resenas[e]} (calidad {calidad[e]}) · acción {precioAcc[e]}")
  }
}
