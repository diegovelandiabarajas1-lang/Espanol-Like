fijo guerraFF = ent(TOTAL_F * N_FAC)
fijo comercioFF = ent(TOTAL_F * N_FAC)
# religiones
fijo relig = ent(TOTAL_R * 4)
# por economía — lo de la v2
fijo producido = ent(N_ECO)
fijo consumido = ent(N_ECO)
fijo destruido = ent(N_ECO)
fijo enMaquinas = ent(N_ECO)
fijo dinero0 = ent(N_ECO)
fijo accVivas = ent(N_ECO)
fijo quiebras = ent(N_ECO)
