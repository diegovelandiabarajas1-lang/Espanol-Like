fijo rumorE = ent(TOTAL_E)                    # [37] cuántos creen que va mal
fijo trab0 = ent(TOTAL_E)                     # foto de las plantillas para contratar
# v3.1 (g3/progreso.esl)
fijo sueldo = ent(TOTAL_E)                    # [16] sueldo de un trabajador normal, por hora
fijo tecE = ent(TOTAL_E)                      # [78] productividad propia (100 = 1×)
fijo dueno = ent(TOTAL_E)                     # [39] persona dueña (−1: de inversores o de un club)
fijo cajaF = ent(TOTAL_E)                     # foto de la caja para investigar
fijo rinde = ent(TOTAL_H)                     # [22] rendimiento de cada persona (80 = normal)
