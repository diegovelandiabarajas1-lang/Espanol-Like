# ECOSIM-G · Monte Carlo de economías en GPU, con C1EÑ · versión 2: con TODAS las mecánicas
#
# Uso (desde D:\ProyectosJS, con el perfil C1EÑ):
#   node motor/util/n-node.js --c1en ecosim/ecosim-g.esl [economias] [ticks] [compradores] [semilla] [salida.csv|-] [empresasPorSector] [credito]
# Por defecto: 10 economías · 7200 ticks (2 h a un tick por segundo) · 2000 compradores
# por economía · 6 empresas por sector (30, hasta 48) · crédito 1 (0 para comparar sin bancos).
# En Kaggle, con las dos T4: 1000 economías, 500 por GPU (c1en/kaggle-ecosim-g.ipynb).
#
# LA IDEA: una economía es un «mundo». Mil economías con mil semillas distintas,
# avanzando a la vez, son mil historias posibles de la misma economía. Al final se
# pregunta en cuántas hubo crisis, cuántas empresas quebraron, cómo se repartió la
# riqueza. Eso es el Monte Carlo: no una corrida, sino la distribución.
#
# LAS MECÁNICAS (las mismas de ecosim5.esl, la versión de CPU, puestas en núcleos):
#   · COMPRADORES con hambre, aburrimiento y curiosidad, estrellas y reseñas, y
#     COLCHÓN: lo que no es agua ni comida solo se compra con 20 veces su precio.
#     Riqueza inicial desigual (Pareto), para compradores e inversores.
#   · EMPRESAS que producen, pagan nómina, ajustan precio y plantilla, invierten
#     en MÁQUINAS (se las compran a las empresas de tecnología: dinero y bienes
#     reales) y las máquinas suben la productividad; QUIEBRAN con dos horas malas
#     seguidas (ganancia ≤ 1 % de su mejor hora) o si no pagan la nómina, tras
#     2 h de gracia; la liquidación paga al banco, reparte la caja, cancela las
#     acciones y destruye inventario y máquinas.
#   · ACCIONISTAS (inversores) de tres estilos —valor, tendencia, azar— en una
#     bolsa con subasta por empresa cada minuto, tesorería que emite contra las
#     subidas, EUFORIA y PÁNICO (si el índice subió o cayó > 10 % en la última
#     hora, el azar se sesga), dividendos cada 10 min.
#   · BANCOS (3 por economía) con contabilidad de doble entrada: un préstamo CREA
#     un depósito y una deuda; pagarlo lo DESTRUYE. Lo fijo es la BASE MONETARIA:
#       depósitos de todos = base monetaria + préstamos vivos
#       reservas de un banco = sus depósitos − sus préstamos
#       deuda de todos los deudores = préstamos de todos los bancos
#     ENCAJE del 10 %: el banco presta mientras sus reservas cubran el 10 % de sus
#     depósitos (cupo por hora). Si los pagos de sus clientes a otros bancos dejan
#     sus reservas en negativo, hay CRISIS DE LIQUIDEZ: no presta y llama a sus
#     deudores. Quién pide: inversores que compran a MARGEN (hasta el 50 % del
#     valor de su cartera), empresas sin caja para la nómina, clubes para fundar.
#     LLAMADA DE MARGEN al 70 %: venta forzosa de toda la cartera y lo cobrado paga
#     la deuda; si no queda nada, el banco CASTIGA el préstamo contra su capital.
#     Un saldo que queda en negativo tras la bolsa es un SOBREGIRO: se convierte en
#     deuda con el banco en ese momento. Intereses: 0,2 % por hora.
#   · CLUBES de compañeros de trabajo, emergentes: cada comprador tiene VOLUNTAD
#     (0–99). Los más decididos fundan un club en su empresa; los demás se unen con
#     probabilidad que crece con su voluntad y aportan según ella. Las
#     PARTICIPACIONES se compran al valor del club (efectivo + acciones − deuda);
#     el socio que se queda sin dinero retira su parte, y si el club no tiene
#     efectivo cobra solo lo que haya (CORRIDA). El club invierte en la empresa
#     que más gana por hora frente a su precio y vende las que pierden. Con
#     100.000 monedas en efectivo, o 140.000 en acciones (el banco presta los
#     100.000 contra ellas), el club FUNDA una empresa en el sector que más gana.
#     Los 20 inversores más ricos también fundan juntos si llegan al capital.
#
# CÓMO ENTRA EN LA GPU: todo el estado vive en arreglos PLANOS de tamaño
# economías × N. El hilo h es el agente (h % N_AG) de la economía (h // N_AG), y
# cada fase del tick es un «paralelo» sobre todos los agentes de todas las
# economías a la vez. Nada se comparte entre economías: cada una lee y escribe
# solo su tramo. Lo que es secuencial por naturaleza (una subasta, la nómina de una
# empresa, fundar) se hace con UN HILO POR EMPRESA o POR ECONOMÍA. Los arreglos se
# quedan RESIDENTES en la GPU entre un núcleo y el siguiente; solo bajan a la CPU
# los que el programa lee (el CSV cada 10 minutos).
#
# LAS MASAS, POR ECONOMÍA, verificadas cada minuto en la GPU con sumas atómicas:
# dinero (depósitos − préstamos = base), deudas = préstamos, acciones (ACC por
# empresa activa, entre tesorería, inversores y clubes), bienes (producido =
# consumido + inventario + destruido + máquinas) y participaciones (la suma de las
# de los socios es la del club).
#
# EL ESTANTE LIMITADO: cuando 3.000 agentes quieren 500 unidades, en GPU no hay
# «el primero que llega». Se cuenta la demanda con sumarAtomico y cada agente
# compra si azarHilo(...) < inventario / demanda: una lotería determinista que no
# depende del orden de los hilos. La lotería puede vender unas unidades de más:
# el inventario queda en negativo (un pedido pendiente) y se repone al producir.
#
# EL AZAR es azarHilo(semilla, hilo, canal), puro: la economía k usa la semilla
# base + k, así que cada mundo es distinto y todos reproducibles, en cualquier
# dispositivo, al bit.
#
# OJO: los arreglos enteros son de 32 bits (como en Ñ), así que el dinero de UNA
# economía debe caber en 2^31 centavos ≈ 21 millones de monedas. Con 10.000
# compradores van unos 16 millones; no subas estas cifras sin bajar otras.

# ─────────────────────────────────────────────── tamaño
fijo ARGS = argumentos()
fn arg(i: entero, defecto: entero): entero {
  si longitud(ARGS) > i { devolver entero(ARGS[i]) }
  devolver defecto
}
fijo N_ECO = arg(0, 10)
fijo TICKS = arg(1, 7200)
fijo N_AG = arg(2, 2000)
fijo SEMILLA = arg(3, 20261013)
var RUTA_CSV = "ecosim/salida-g.csv"
si longitud(ARGS) > 4 y ARGS[4] != "-" { RUTA_CSV = ARGS[4] }
fijo POR_SECTOR = arg(5, 6)                  # empresas por sector al empezar
fijo CREDITO = arg(6, 1)                     # 1 con bancos que prestan, 0 sin crédito

fijo N_SECTOR = 5                            # 0 agua · 1 comida · 2 tecnología · 3 ocio · 4 lujo
fijo N_INI = N_SECTOR * POR_SECTOR          # 30 empresas al empezar (con 6 por sector)
fijo N_EMP = N_INI + N_INI * 3 // 5          # espacios: las que nacen ocupan los libres (48 con 30)
fijo ACC = 2000                              # acciones por empresa (a 100 monedas: 200.000 de capital)
fijo N_INV = 100                             # inversores por economía
fijo N_BANCO = 3                             # bancos por economía
fijo DINERO_AG = 100000                      # 1.000 monedas por comprador de media, en centavos
fijo DINERO_INV = 1600000                    # 16.000 por inversor de media
fijo DINERO_EMP = 20000000                   # 200.000 por empresa: 100 monedas por acción, igual que la salida a bolsa
fijo CAPITAL_BANCO = 2000000                 # 20.000 monedas de capital propio por banco
fijo SALARIO = 6000                          # por hora
fijo PRECIO_ACC0 = 10000                     # 100 monedas
fijo FUNDAR = 10000000                       # 100.000 monedas para fundar
fijo FUNDAR_ACC = FUNDAR * 7 // 5            # …o 280.000 en acciones, con préstamo del banco
fijo N_FUNDADORES = 20                       # inversores que se juntan para fundar
fijo GRACIA = 7200
fijo ENCAJE = 10                             # % de los depósitos que el banco guarda en reservas
fijo MARGEN_PRESTAMO = 50                    # se presta hasta el 50 % del valor de la cartera…
fijo MARGEN_LLAMADA = 70                     # …y si la deuda pasa el 70 %, venta forzosa
fijo INTERES = 2                             # 0,2 % por hora (por mil)
fijo TOTAL_H = N_ECO * N_AG                  # hilos por fase de agentes
fijo TOTAL_E = N_ECO * N_EMP                 # hilos por fase de empresas (y de clubes: un club por espacio de empresa)
fijo TOTAL_I = N_ECO * N_INV
fijo TOTAL_B = N_ECO * N_BANCO
fijo TEN = 1 + N_INV + N_EMP                 # tenedores por empresa: tesorería, inversores, clubes

# ─────────────────────────────────────────────── estado plano
# compradores: economías × N_AG
fijo saldo = ceros([TOTAL_H], "entero")
fijo hambre = ceros([TOTAL_H], "entero")
fijo aburr = ceros([TOTAL_H], "entero")
fijo curio = ceros([TOTAL_H], "entero")
fijo empleo = ceros([TOTAL_H], "entero")      # empresa (0..N_EMP-1) o -1
fijo eleccion = ceros([TOTAL_H], "entero")    # empresa elegida o -1
fijo compro = ceros([TOTAL_H], "entero")      # 1 si compró este tick
fijo voluntad = ceros([TOTAL_H], "entero")    # 0..99, rasgo fijo
fijo clubDe = ceros([TOTAL_H], "entero")      # club (espacio de empresa) o -1
fijo partic = ceros([TOTAL_H], "entero")      # participaciones en su club
fijo retira = ceros([TOTAL_H], "entero")      # monto que pidió retirar esta hora
# inversores: economías × N_INV
fijo saldoInv = ceros([TOTAL_I], "entero")
fijo deudaInv = ceros([TOTAL_I], "entero")
fijo carteraInv = ceros([TOTAL_I], "entero")  # valor de sus acciones al cierre de la hora
fijo forzadoInv = ceros([TOTAL_I], "entero")  # 1 = llamada de margen: vende todo
fijo aporte = ceros([TOTAL_I], "entero")      # trabajo de «fundar»
# empresas: economías × N_EMP
fijo activa = ceros([TOTAL_E], "entero")
fijo sector = ceros([TOTAL_E], "entero")
fijo caja = ceros([TOTAL_E], "entero")
fijo deudaEmp = ceros([TOTAL_E], "entero")
fijo precio = ceros([TOTAL_E], "entero")
fijo inv = ceros([TOTAL_E], "entero")
fijo progreso = ceros([TOTAL_E], "entero")
fijo trab = ceros([TOTAL_E], "entero")
fijo maquinas = ceros([TOTAL_E], "entero")
fijo demanda = ceros([TOTAL_E], "entero")     # agentes que la eligieron este tick
fijo ventas = ceros([TOTAL_E], "entero")      # unidades vendidas este tick
fijo ventasHora = ceros([TOTAL_E], "entero")
fijo ingresosHora = ceros([TOTAL_E], "entero")
fijo salariosHora = ceros([TOTAL_E], "entero")
fijo ganHora = ceros([TOTAL_E], "entero")
fijo ganMax = ceros([TOTAL_E], "entero")
fijo horasMalas = ceros([TOTAL_E], "entero")
fijo sinNomina = ceros([TOTAL_E], "entero")   # horas seguidas sin poder pagar la nómina entera
fijo nacida = ceros([TOTAL_E], "entero")
fijo fundadaPor = ceros([TOTAL_E], "entero")  # 0 inicial · 1 inversores · 2 club
fijo precioAcc = ceros([TOTAL_E], "entero")
fijo precioAccH = ceros([TOTAL_E], "entero")  # precio al cierre de la hora anterior (para los seguidores de tendencia)
fijo calidad = ceros([TOTAL_E], "entero")
fijo estrellas = ceros([TOTAL_E], "entero")   # suma × 100
fijo resenas = ceros([TOTAL_E], "entero")
fijo divPorAcc = ceros([TOTAL_E], "entero")
# clubes: uno posible por espacio de empresa (nace entre sus trabajadores)
fijo clubExiste = ceros([TOTAL_E], "entero")
fijo saldoClub = ceros([TOTAL_E], "entero")
fijo deudaClub = ceros([TOTAL_E], "entero")
fijo particTotal = ceros([TOTAL_E], "entero")
fijo valorPart = ceros([TOTAL_E], "entero")   # centavos por participación, al cierre de la hora
fijo carteraClub = ceros([TOTAL_E], "entero")
fijo objetivoClub = ceros([TOTAL_E], "entero") # empresa en la que invierte esta hora, o -1
fijo forzadoClub = ceros([TOTAL_E], "entero")
fijo candidatos = ceros([TOTAL_E], "entero")
fijo demandaRetiro = ceros([TOTAL_E], "entero")
fijo factorRetiro = ceros([TOTAL_E], "entero") # por millón: 1000000 = cobran todo
fijo clubFundadas = ceros([TOTAL_E], "entero")
fijo sumaPart = ceros([TOTAL_E], "entero")
# bancos: economías × N_BANCO
fijo prestamos = ceros([TOTAL_B], "entero")   # préstamos vivos de cada banco
fijo capBanco = ceros([TOTAL_B], "entero")    # cuenta propia del banco (un depósito en sí mismo)
fijo reservasB = ceros([TOTAL_B], "entero")   # depósitos − préstamos, al último cierre
fijo cupo = ceros([TOTAL_B], "entero")        # cuánto puede prestar esta hora
fijo sumaDepBanco = ceros([TOTAL_B], "entero")
# tenencia de acciones: economías × N_EMP × TEN
fijo tenencia = ceros([TOTAL_E * TEN], "entero")
# por economía
fijo producido = ceros([N_ECO], "entero")
fijo consumido = ceros([N_ECO], "entero")
fijo destruido = ceros([N_ECO], "entero")
fijo enMaquinas = ceros([N_ECO], "entero")
fijo dinero0 = ceros([N_ECO], "entero")       # la base monetaria
fijo accVivas = ceros([N_ECO], "entero")
fijo quiebras = ceros([N_ECO], "entero")
fijo fundadas = ceros([N_ECO], "entero")
fijo fundadasClub = ceros([N_ECO], "entero")
fijo paro = ceros([N_ECO], "entero")
fijo indiceBolsa = ceros([N_ECO], "entero")
fijo nActivas = ceros([N_ECO], "entero")
fijo paroMax = ceros([N_ECO], "entero")
fijo caidaMax = ceros([N_ECO], "entero")      # mayor caída del índice en una hora, en %
fijo indiceHace1h = ceros([N_ECO], "entero")
fijo sesgo = ceros([N_ECO], "entero")         # euforia (+20) o pánico (−20), en centésimas
fijo fallo = ceros([N_ECO], "entero")         # código de invariante rota, 0 si todo bien
fijo iliquidez = ceros([N_ECO], "entero")     # horas-banco con reservas negativas
fijo llamadas = ceros([N_ECO], "entero")      # llamadas de margen
fijo castigos = ceros([N_ECO], "entero")      # préstamos castigados (centavos)
fijo sobregiros = ceros([N_ECO], "entero")
fijo corridas = ceros([N_ECO], "entero")
fijo nClubs = ceros([N_ECO], "entero")
fijo socios = ceros([N_ECO], "entero")
fijo prestamosVivos = ceros([N_ECO], "entero")
# escalares de trabajo (arreglos para poder sumar atómicamente)
fijo sumaDinero = ceros([N_ECO], "entero")
fijo sumaDeuda = ceros([N_ECO], "entero")
fijo sumaAcc = ceros([TOTAL_E], "entero")

# ─────────────────────────────────────────────── tick 0, en paralelo
# Pareto: riqueza = media × 0,4 × (1/(1−u))^(2/3), topada en 12 veces la media
# (escrito dentro de cada núcleo: un núcleo no puede llamar a otra función de Ñ).
fn iniciarAgente(h: entero, saldo, hambre, aburr, curio, empleo, voluntad, clubDe, partic, s: entero, nAg: entero, nIni: entero, dineroAg: entero) {
  fijo k = h // nAg
  fijo i = h % nAg
  fijo u = azarHilo(s + k, i, 1) * 0.999
  var w = dineroAg * 4 // 10
  var f = 1.0 / (1.0 - u)
  f = exp(log(f) * 0.6667)
  var r = entero(piso(w * f))
  si r > dineroAg * 12 { r = dineroAg * 12 }
  saldo[h] = r
  hambre[h] = entero(piso(azarHilo(s + k, i, 2) * 4000))
  aburr[h] = entero(piso(azarHilo(s + k, i, 3) * 4000))
  curio[h] = entero(piso(azarHilo(s + k, i, 4) * 4000))
  voluntad[h] = entero(piso(azarHilo(s + k, i, 5) * 100))
  empleo[h] = i % nIni
  clubDe[h] = -1
  partic[h] = 0
}
fn iniciarInversor(h: entero, saldoInv, s: entero, nInv: entero, dineroInv: entero) {
  fijo k = h // nInv
  fijo q = h % nInv
  fijo u = azarHilo(s + k, 500 + q, 1) * 0.999
  var w = dineroInv * 4 // 10
  var f = 1.0 / (1.0 - u)
  f = exp(log(f) * 0.6667)
  var r = entero(piso(w * f))
  si r > dineroInv * 12 { r = dineroInv * 12 }
  saldoInv[h] = r
}
fn iniciarBanco(h: entero, capBanco, capital: entero) { capBanco[h] = capital }
fn iniciarEmpresa(h: entero, activa, sector, caja, precio, inv, trab, precioAcc, calidad, estrellas, resenas, nacida, objetivoClub, s: entero, nEmp: entero, nIni: entero, porSector: entero, nAg: entero, dineroEmp: entero) {
  fijo k = h // nEmp
  fijo e = h % nEmp
  objetivoClub[h] = -1
  si e < nIni {
    activa[h] = 1
    fijo sec = e // porSector
    sector[h] = sec
    caja[h] = dineroEmp
    var base = 800
    si sec == 1 { base = 1200 }
    si sec == 2 { base = 3000 }
    si sec == 3 { base = 1500 }
    si sec == 4 { base = 1000 }
    precio[h] = base + entero(piso(azarHilo(s + k, 1000 + e, 5) * (base // 2)))
    inv[h] = nAg * 4 // (5 * nIni) + 50
    trab[h] = nAg // nIni
    si e < nAg % nIni { trab[h] = trab[h] + 1 }
    precioAcc[h] = 10000
    calidad[h] = 1 + entero(piso(azarHilo(s + k, 1000 + e, 6) * 5))
    estrellas[h] = 20 * (1 + entero(piso(azarHilo(s + k, 1000 + e, 7) * 5))) * 100
    resenas[h] = 20
  } sino {
    activa[h] = 0
    resenas[h] = 1
  }
  nacida[h] = 0
}
# IPO: cada acción se asigna a un inversor al azar; el hilo es (economía, empresa, acción)
fn repartirAcciones(h: entero, tenencia, activa, s: entero, nEmp: entero, acc: entero, ten: entero, nInv: entero) {
  fijo ke = h // acc                 # índice plano de la empresa
  si activa[ke] == 1 {
    fijo k = ke // nEmp
    fijo a = h % acc
    fijo quien = 1 + entero(piso(azarHilo(s + k, 2000 + ke % nEmp, 8 + a) * nInv))
    sumarAtomico(tenencia, ke * ten + quien, 1)
  }
}

# ─────────────────────────────────────────────── fases del tick
# 1. cada agente decide qué quiere: barras, sector, dos candidatas, gana la mejor
fn elegir(h: entero, hambre, aburr, curio, eleccion, saldo, activa, precio, estrellas, resenas, sector, demanda, t: entero, s: entero, nAg: entero, nEmp: entero, porSector: entero) {
  fijo k = h // nAg
  fijo i = h % nAg
  var hh = hambre[h] + 3
  si hh > 10000 { hh = 10000 }
  hambre[h] = hh
  var aa = aburr[h] + 2
  si aa > 10000 { aa = 10000 }
  aburr[h] = aa
  var cc = curio[h] + 1
  si cc > 10000 { cc = 10000 }
  curio[h] = cc
  var sec = -1
  si hh >= 4000 y hh >= aa y hh >= cc { sec = (t + i) % 2 }
  sino si aa >= 4000 y aa >= cc { sec = 3 }
  sino si cc >= 4000 { sec = 2 }
  sino si (t + i * 7) % 3000 == 0 { sec = 4 }
  eleccion[h] = -1
  si sec >= 0 {
    # dos candidatas al azar entre las activas del sector (hasta 6 intentos)
    fijo base = k * nEmp
    var mejor = -1
    var mejorPz = 0
    var intento = 0
    mientras intento < 6 {
      fijo e = base + entero(piso(azarHilo(s + k, h, 20 + intento + 7 * (t % 11)) * nEmp))
      si activa[e] == 1 y sector[e] == sec {
        fijo pz = (estrellas[e] // resenas[e]) * 4 - precio[e]
        si mejor < 0 o pz > mejorPz {
          mejor = e
          mejorPz = pz
        }
      }
      intento = intento + 1
    }
    si mejor >= 0 {
      # lo que no es agua ni comida exige colchón
      si sec < 2 o saldo[h] >= precio[mejor] * 20 {
        eleccion[h] = mejor
        sumarAtomico(demanda, mejor, 1)
      }
    }
  }
}
# 2. lotería: si la demanda supera el inventario, compra una fracción; el dinero
#    y las unidades se mueven con atómicos
fn comprar(h: entero, eleccion, saldo, caja, inv, demanda, ventas, compro, precio, hambre, aburr, curio, sector, estrellas, resenas, calidad, consumido, t: entero, s: entero, nAg: entero) {
  compro[h] = 0
  fijo e = eleccion[h]
  si e >= 0 {
    fijo k = h // nAg
    fijo pr = precio[e]
    si saldo[h] >= pr {
      fijo d = demanda[e]
      fijo stock = inv[e]
      var puede = 1
      si d > stock {
        si azarHilo(s + k, h, 30 + t % 5) * d >= stock { puede = 0 }
      }
      si puede == 1 {
        saldo[h] = saldo[h] - pr
        sumarAtomico(caja, e, pr)
        sumarAtomico(ventas, e, 1)
        sumarAtomico(consumido, k, 1)
        compro[h] = 1
        fijo sec = sector[e]
        si sec <= 1 { hambre[h] = hambre[h] - 4500 }
        sino si sec == 3 { aburr[h] = aburr[h] - 4500 }
        sino si sec == 2 { curio[h] = curio[h] - 4500 }
        si hambre[h] < 0 { hambre[h] = 0 }
        si aburr[h] < 0 { aburr[h] = 0 }
        si curio[h] < 0 { curio[h] = 0 }
        si azarHilo(s + k, h, 40 + t % 3) < 0.1 {
          var est = calidad[e] + entero(piso(azarHilo(s + k, h, 50) * 3)) - 1
          si est < 1 { est = 1 }
          si est > 5 { est = 5 }
          sumarAtomico(estrellas, e, est * 100)
          sumarAtomico(resenas, e, 1)
        }
      }
    }
  }
}
# 2b. se descuenta del inventario lo vendido (puede quedar en negativo: un pedido
#     pendiente que se sirve al producir)
fn cerrarVentas(h: entero, inv, ventas, ventasHora, ingresosHora, precio, demanda, activa) {
  si activa[h] == 1 {
    inv[h] = inv[h] - ventas[h]
    ventasHora[h] = ventasHora[h] + ventas[h]
    ingresosHora[h] = ingresosHora[h] + ventas[h] * precio[h]
  }
  demanda[h] = 0
}
# 3. producir: 4,8 unidades por trabajador y hora, y cada máquina añade un 10 %
#    (hasta triplicar)
fn producir(h: entero, activa, progreso, trab, inv, maquinas, producido, nEmp: entero) {
  si activa[h] == 1 {
    var m: entero = maquinas[h]
    si m > 20 { m = 20 }
    progreso[h] = progreso[h] + trab[h] * 48 * (10 + m) // 10
    fijo u = progreso[h] // 36000
    progreso[h] = progreso[h] % 36000
    inv[h] = inv[h] + u
    sumarAtomico(producido, h // nEmp, u)
  }
}
# 4. cada hora: salarios. Un hilo por EMPRESA recorre a los agentes de su
#    economía y paga a los suyos mientras la caja alcance; si no alcanza y el banco
#    tiene cupo, pide prestado lo que falta; al que ni así alcanza lo despide.
fn pagarSalarios(h: entero, activa, empleo, saldo, caja, salariosHora, deudaEmp, prestamos, cupo, sinNomina, trab, nAg: entero, nEmp: entero, nBanco: entero, salario: entero, credito: entero) {
  si activa[h] == 1 {
    fijo k = h // nEmp
    fijo e = h % nEmp
    fijo kb = k * nBanco + e % nBanco
    fijo base = k * nAg
    # lo que falta para la nómina entera, si el banco lo presta
    fijo nomina = trab[h] * salario
    si credito == 1 y caja[h] < nomina {
      fijo falta = nomina - caja[h]
      fijo c: entero = cupo[kb]
      si falta <= c {
        caja[h] = caja[h] + falta
        deudaEmp[h] = deudaEmp[h] + falta
        sumarAtomico(prestamos, kb, falta)
        sumarAtomico(cupo, kb, 0 - falta)
      }
    }
    var despedidos = 0
    para i en rango(nAg) {
      si empleo[base + i] == e {
        si caja[h] >= salario {
          caja[h] = caja[h] - salario
          saldo[base + i] = saldo[base + i] + salario
          salariosHora[h] = salariosHora[h] + salario
        } sino {
          empleo[base + i] = -1
          despedidos = despedidos + 1
        }
      }
    }
    si despedidos > 0 { sinNomina[h] = sinNomina[h] + 1 } sino { sinNomina[h] = 0 }
  }
}
# 5. cada hora: la empresa ajusta precio, mide su hora, paga deuda e invierte en máquinas
fn cerrarHora(h: entero, activa, ventasHora, ingresosHora, salariosHora, ganHora, ganMax, horasMalas, inv, precio, trab, caja, deudaEmp, prestamos, nacida, t: entero, gracia: entero, nEmp: entero, nBanco: entero, salario: entero) {
  si activa[h] == 1 {
    var v: entero = ventasHora[h]
    si v < 1 { v = 1 }
    ganHora[h] = ingresosHora[h] - salariosHora[h]
    si ganHora[h] > ganMax[h] { ganMax[h] = ganHora[h] }
    si ingresosHora[h] < salariosHora[h] { precio[h] = precio[h] * 103 // 100 + 1 }
    sino si inv[h] > 2 * v {
      precio[h] = precio[h] * 98 // 100
      si precio[h] < 100 { precio[h] = 100 }
    }
    sino si inv[h] < v // 2 { precio[h] = precio[h] * 102 // 100 + 1 }
    si t - nacida[h] >= gracia {
      si ganMax[h] > 0 y ganHora[h] * 100 <= ganMax[h] { horasMalas[h] = horasMalas[h] + 1 } sino { horasMalas[h] = 0 }
    }
    # paga deuda con lo que sobra de dos nóminas
    fijo d: entero = deudaEmp[h]
    si d > 0 {
      fijo reserva = trab[h] * salario * 2
      var pago: entero = caja[h] - reserva
      si pago > d { pago = d }
      si pago > 0 {
        caja[h] = caja[h] - pago
        deudaEmp[h] = d - pago
        sumarAtomico(prestamos, (h // nEmp) * nBanco + (h % nEmp) % nBanco, 0 - pago)
      }
    }
    ventasHora[h] = 0
    ingresosHora[h] = 0
    salariosHora[h] = 0
  }
}
# 5b. máquinas: con caja de sobra (4 nóminas) y sin deuda, compra una máquina a una
#     empresa de tecnología con inventario; vale 20 unidades de su producto. El
#     dinero y el bien se mueven con atómicos (la tecnológica puede quedar en
#     negativo de inventario: pedido pendiente).
fn invertirMaquinas(h: entero, activa, sector, caja, deudaEmp, trab, inv, precio, maquinas, ventasHora, ingresosHora, enMaquinas, t: entero, s: entero, nEmp: entero, salario: entero) {
  si activa[h] == 1 y deudaEmp[h] == 0 y maquinas[h] < 20 {
    fijo k = h // nEmp
    fijo e = h % nEmp
    fijo reserva = trab[h] * salario * 4
    var intento = 0
    var hecho = 0
    mientras intento < 4 y hecho == 0 {
      fijo te = k * nEmp + entero(piso(azarHilo(s + k, 6000 + e, 90 + intento + t % 7) * nEmp))
      si te != h y activa[te] == 1 y sector[te] == 2 y inv[te] > 0 {
        fijo p = precio[te] * 20
        si caja[h] >= reserva + p {
          # la propia caja también con atómico: una tecnológica puede estar comprando
          # una máquina mientras otra le paga la suya (en la T4 salió dinero fantasma)
          sumarAtomico(caja, h, 0 - p)
          sumarAtomico(caja, te, p)
          sumarAtomico(inv, te, 0 - 1)
          sumarAtomico(ventasHora, te, 1)
          sumarAtomico(ingresosHora, te, p)
          sumarAtomico(enMaquinas, k, 1)
          maquinas[h] = maquinas[h] + 1
          hecho = 1
        }
      }
      intento = intento + 1
    }
  }
}
# 6. recontar plantilla y desempleo (un hilo por agente)
fn recontar(h: entero, empleo, trab, paro, nAg: entero, nEmp: entero) {
  fijo k = h // nAg
  fijo e = empleo[h]
  si e >= 0 { sumarAtomico(trab, k * nEmp + e, 1) } sino { sumarAtomico(paro, k, 1) }
}
fn aCero(h: entero, a) { a[h] = 0 }
# 7. contratar: el desempleado busca una empresa activa con caja de sobra
fn contratar(h: entero, empleo, activa, caja, trab, t: entero, s: entero, nAg: entero, nEmp: entero, salario: entero) {
  si empleo[h] < 0 {
    fijo k = h // nAg
    var intento = 0
    mientras intento < 4 y empleo[h] < 0 {
      fijo e: entero = entero(piso(azarHilo(s + k, h, 60 + intento + t % 13) * nEmp))
      fijo ke = k * nEmp + e
      si activa[ke] == 1 y caja[ke] > (trab[ke] + 1) * salario * 4 {
        empleo[h] = e
        sumarAtomico(trab, ke, 1)
      }
      intento = intento + 1
    }
  }
}
# 8. dividendos cada 10 min: la mitad de la ganancia de la hora, por acción en circulación
fn dividendos(h: entero, activa, caja, ganHora, tenencia, trab, divPorAcc, deudaEmp, nEmp: entero, ten: entero, acc: entero, salario: entero) {
  divPorAcc[h] = 0
  si activa[h] == 1 y deudaEmp[h] == 0 {
    fijo circulan = acc - tenencia[h * ten]
    fijo reserva = trab[h] * salario * 2
    var reparto = ganHora[h] // 12          # la ganancia por hora, prorrateada a 10 min, mitad
    si reparto > caja[h] - reserva { reparto = caja[h] - reserva }
    si reparto > 0 y circulan > 0 {
      fijo porAcc = reparto // circulan
      si porAcc > 0 {
        divPorAcc[h] = porAcc
        caja[h] = caja[h] - porAcc * circulan
      }
    }
  }
}
fn cobrarDividendos(h: entero, saldoInv, tenencia, divPorAcc, nInv: entero, nEmp: entero, ten: entero) {
  fijo k = h // nInv
  fijo q = h % nInv
  var total = 0
  para e en rango(nEmp) {
    fijo ke = k * nEmp + e
    total = total + tenencia[ke * ten + 1 + q] * divPorAcc[ke]
  }
  saldoInv[h] = saldoInv[h] + total
}
fn cobrarDividendosClub(h: entero, saldoClub, clubExiste, tenencia, divPorAcc, nInv: entero, nEmp: entero, ten: entero) {
  si clubExiste[h] == 1 {
    fijo k = h // nEmp
    fijo c = h % nEmp
    var total = 0
    para e en rango(nEmp) {
      fijo ke = k * nEmp + e
      total = total + tenencia[ke * ten + 1 + nInv + c] * divPorAcc[ke]
    }
    saldoClub[h] = saldoClub[h] + total
  }
}
# 9. quiebra: dos horas malas seguidas, o dos horas sin nómina. Paga al banco con la
#    caja (el resto se castiga), destruye inventario y máquinas, reparte lo que
#    queda por acción y cancela las acciones. Un hilo por empresa.
fn quebrar(h: entero, activa, horasMalas, sinNomina, inv, maquinas, destruido, enMaquinas, caja, deudaEmp, prestamos, capBanco, castigos, tenencia, divPorAcc, precioAcc, trab, quiebras, accVivas, nEmp: entero, nBanco: entero, ten: entero, acc: entero) {
  divPorAcc[h] = 0
  si activa[h] == 1 y (horasMalas[h] >= 2 o sinNomina[h] >= 2) {
    fijo k = h // nEmp
    fijo kb = k * nBanco + (h % nEmp) % nBanco
    activa[h] = 0
    sumarAtomico(destruido, k, inv[h] + maquinas[h])
    sumarAtomico(enMaquinas, k, 0 - maquinas[h])
    inv[h] = 0
    maquinas[h] = 0
    # primero el banco
    fijo d: entero = deudaEmp[h]
    si d > 0 {
      var pago = d
      si pago > caja[h] { pago = caja[h] }
      si pago < 0 { pago = 0 }
      caja[h] = caja[h] - pago
      sumarAtomico(prestamos, kb, 0 - pago)
      fijo resto = d - pago
      si resto > 0 {
        # castigo: el banco pierde el préstamo contra su propio capital
        sumarAtomico(prestamos, kb, 0 - resto)
        sumarAtomico(capBanco, kb, 0 - resto)
        sumarAtomico(castigos, k, resto)
      }
      deudaEmp[h] = 0
    }
    fijo circulan = acc - tenencia[h * ten]
    si circulan > 0 y caja[h] > 0 {
      divPorAcc[h] = caja[h] // circulan           # liquidación: todo lo que hay
      caja[h] = caja[h] - divPorAcc[h] * circulan
    }
    # el residuo no se destruye: se queda en la cuenta de la empresa cerrada
    precioAcc[h] = 0
    sumarAtomico(quiebras, k, 1)
    sumarAtomico(accVivas, k, 0 - acc)
    trab[h] = 0
  }
}
fn cancelarAcciones(h: entero, tenencia, activa, precioAcc, ten: entero) {
  # h recorre economías × empresas × tenedores
  fijo ke = h // ten
  si activa[ke] == 0 y precioAcc[ke] == 0 { tenencia[h] = 0 }
}
fn despedir(h: entero, empleo, activa, nAg: entero, nEmp: entero) {
  fijo e = empleo[h]
  si e >= 0 {
    si activa[(h // nAg) * nEmp + e] == 0 { empleo[h] = -1 }
  }
}
# 10a. fundar entre inversores: los N_FUNDADORES más ricos ponen hasta la mitad de su
#      dinero; si llegan al capital y «quieren» (una de cada tres horas), fundan en el
#      sector con más ganancia y se reparten las acciones a prorrata. Un hilo por economía.
fn fundarInversores(k: entero, saldoInv, activa, sector, ganHora, caja, precioAcc, nacida, fundadaPor, tenencia, fundadas, accVivas, aporte, t: entero, s: entero, nInv: entero, nEmp: entero, nIni: entero, nSector: entero, ten: entero, acc: entero, fundarCon: entero, nFund: entero) {
  var juntan = 0
  para q en rango(nInv) { aporte[k * nInv + q] = 0 }
  para ronda en rango(nFund) {
    var rico = -1
    var masRico = 0
    para q en rango(nInv) {
      fijo hq = k * nInv + q
      si aporte[hq] == 0 y saldoInv[hq] > masRico {
        masRico = saldoInv[hq]
        rico = hq
      }
    }
    si rico >= 0 {
      aporte[rico] = masRico // 2
      juntan = juntan + masRico // 2
    }
  }
  fijo voluntad = azarHilo(s + k, 4000 + t // 3600, 71)
  si juntan >= fundarCon y voluntad < 0.34 {
    var hueco = -1
    para e en rango(nEmp) {
      fijo ke = k * nEmp + e
      si hueco < 0 y e >= nIni y activa[ke] == 0 y nacida[ke] == 0 y precioAcc[ke] == 0 { hueco = ke }
    }
    var mejorS = -1
    var mejorG = 0
    para sec en rango(nSector) {
      var g = 0
      var n = 0
      para e en rango(nEmp) {
        fijo ke = k * nEmp + e
        si activa[ke] == 1 y sector[ke] == sec {
          g = g + ganHora[ke]
          n = n + 1
        }
      }
      var media = 1000000000
      si n > 0 { media = g // n }
      si media > mejorG {
        mejorG = media
        mejorS = sec
      }
    }
    si hueco >= 0 y mejorS >= 0 {
      var puesto = 0
      var repartidas = 0
      para q en rango(nInv) {
        fijo hq = k * nInv + q
        si aporte[hq] > 0 {
          fijo ap: entero = aporte[hq]
          var pone: entero = ap * fundarCon // juntan
          si puesto + pone > fundarCon { pone = fundarCon - puesto }
          saldoInv[hq] = saldoInv[hq] - pone
          puesto = puesto + pone
          fijo recibe: entero = pone * acc // fundarCon
          tenencia[hueco * ten + 1 + q] = recibe
          repartidas = repartidas + recibe
          aporte[hq] = pone
        }
      }
      para q en rango(nInv) {
        fijo hq = k * nInv + q
        si aporte[hq] > 0 y puesto < fundarCon {
          saldoInv[hq] = saldoInv[hq] - (fundarCon - puesto)
          puesto = fundarCon
        }
      }
      tenencia[hueco * ten] = acc - repartidas      # las acciones sin dueño quedan en tesorería
      activa[hueco] = 1
      sector[hueco] = mejorS
      caja[hueco] = fundarCon
      nacida[hueco] = t                           # «nacer» termina de armarla
      precioAcc[hueco] = fundarCon // acc
      fundadaPor[hueco] = 1
      fundadas[k] = fundadas[k] + 1
      accVivas[k] = accVivas[k] + acc
    }
  }
}
# 10b. fundar por un club: el primer club con el efectivo, o con acciones por 7/5 del
#      capital y un banco con cupo (pide el capital contra ellas). Todas las acciones
#      son del club. Un hilo por economía, una fundación por hora como mucho.
fn fundarClub(k: entero, clubExiste, saldoClub, deudaClub, carteraClub, cupo, prestamos, activa, sector, ganHora, caja, precioAcc, nacida, fundadaPor, tenencia, fundadas, fundadasClub, clubFundadas, accVivas, t: entero, s: entero, nInv: entero, nEmp: entero, nIni: entero, nSector: entero, nBanco: entero, ten: entero, acc: entero, fundarCon: entero, fundarAcc: entero, credito: entero) {
  var quien = -1
  var conPrestamo = 0
  para c en rango(nEmp) {
    fijo kc = k * nEmp + c
    si quien < 0 y clubExiste[kc] == 1 {
      si saldoClub[kc] >= fundarCon { quien = kc }
      sino si credito == 1 y deudaClub[kc] == 0 y carteraClub[kc] >= fundarAcc {
        fijo kb = k * nBanco + c % nBanco
        si cupo[kb] >= fundarCon {
          quien = kc
          conPrestamo = 1
        }
      }
    }
  }
  si quien >= 0 {
    var hueco = -1
    para e en rango(nEmp) {
      fijo ke = k * nEmp + e
      si hueco < 0 y e >= nIni y activa[ke] == 0 y nacida[ke] == 0 y precioAcc[ke] == 0 { hueco = ke }
    }
    var mejorS = -1
    var mejorG = 0
    para sec en rango(nSector) {
      var g = 0
      var n = 0
      para e en rango(nEmp) {
        fijo ke = k * nEmp + e
        si activa[ke] == 1 y sector[ke] == sec {
          g = g + ganHora[ke]
          n = n + 1
        }
      }
      var media = 1000000000
      si n > 0 { media = g // n }
      si media > mejorG {
        mejorG = media
        mejorS = sec
      }
    }
    si hueco >= 0 y mejorS >= 0 {
      fijo c = quien % nEmp
      si conPrestamo == 1 {
        fijo kb = k * nBanco + c % nBanco
        saldoClub[quien] = saldoClub[quien] + fundarCon
        deudaClub[quien] = deudaClub[quien] + fundarCon
        prestamos[kb] = prestamos[kb] + fundarCon
        cupo[kb] = cupo[kb] - fundarCon
      }
      saldoClub[quien] = saldoClub[quien] - fundarCon
      tenencia[hueco * ten + 1 + nInv + c] = acc
      activa[hueco] = 1
      sector[hueco] = mejorS
      caja[hueco] = fundarCon
      nacida[hueco] = t                           # «nacer» termina de armarla
      precioAcc[hueco] = fundarCon // acc
      fundadaPor[hueco] = 2
      fundadas[k] = fundadas[k] + 1
      fundadasClub[k] = fundadasClub[k] + 1
      clubFundadas[quien] = clubFundadas[quien] + 1
      accVivas[k] = accVivas[k] + acc
    }
  }
}
# 10c. nacer: termina de armar la empresa fundada esta hora (un hilo por empresa;
#      las dos formas de fundar dejan activa, sector, caja, precioAcc y nacida = t)
fn nacer(h: entero, activa, nacida, sector, precio, inv, trab, maquinas, calidad, estrellas, resenas, horasMalas, sinNomina, ganMax, t: entero, s: entero, nEmp: entero) {
  si activa[h] == 1 y nacida[h] == t y t > 0 {
    fijo k = h // nEmp
    fijo sec = sector[h]
    var base = 800
    si sec == 1 { base = 1200 }
    si sec == 2 { base = 3000 }
    si sec == 3 { base = 1500 }
    si sec == 4 { base = 1000 }
    precio[h] = base
    inv[h] = 0
    trab[h] = 0
    maquinas[h] = 0
    calidad[h] = 1 + entero(piso(azarHilo(s + k, 3000 + h % nEmp, 70 + t // 3600 % 29) * 5))
    estrellas[h] = 5 * 300
    resenas[h] = 5
    horasMalas[h] = 0
    sinNomina[h] = 0
    ganMax[h] = 0
  }
}
# 11. bolsa: subasta de precio único por empresa, UN HILO POR EMPRESA (secuencial
#     dentro, paralela entre empresas y economías). Las empresas de una economía
#     tocan a los MISMOS inversores y clubes a la vez, así que su dinero se mueve
#     con sumarAtomico. Las acciones de cada empresa son solo de su hilo.
#     Tenedores: inversores (valor / tendencia / azar, con margen y llamadas) y
#     clubes (compran su objetivo, venden las que pierden). El precio se mueve con
#     el desequilibrio y las acciones cambian de mano al precio de cierre.
fn bolsa(h: entero, activa, precioAcc, precioAccH, tenencia, saldoInv, deudaInv, carteraInv, forzadoInv, divPorAcc, ganHora, caja, trab, clubExiste, saldoClub, objetivoClub, forzadoClub, cupo, sesgo, nActivas, t: entero, s: entero, nEmp: entero, nInv: entero, nBanco: entero, ten: entero, acc: entero, salario: entero, margen: entero, credito: entero) {
  si activa[h] == 1 {
    fijo k = h // nEmp
    fijo p: entero = precioAcc[h]
    fijo pH: entero = precioAccH[h]
    # valor fundamental: caja por acción, menos los salarios que debe esta hora,
    # más 40 horas de la ganancia actual
    fijo cj: entero = caja[h]
    fijo gh: entero = ganHora[h]
    fijo tr: entero = trab[h]
    var valor: entero = (cj - tr * salario + gh * 40) // acc
    si valor < 1 { valor = 1 }
    fijo sg: entero = sesgo[k]
    fijo umbral = 0.5 + sg / 100.0          # euforia: más compran al azar; pánico: menos
    # el presupuesto de un inversor se reparte entre todas las empresas activas: en
    # cada subasta se juega 1–5 % de su dinero dividido por el número de empresas
    var nAct: entero = nActivas[k]
    si nAct < 1 { nAct = 1 }
    fijo r3 = azarHilo(s + k, 5500 + h % nEmp, 120 + t % 17)   # ¿sesión en la que actúan los clubes?
    var compras = 0
    var ventas = 0
    fijo tes: entero = tenencia[h * ten]
    var ofertaTes: entero = 0
    # ── inversores: lado y cantidad
    para q en rango(nInv) {
      fijo hq = k * nInv + q
      fijo r = azarHilo(s + k, 5000 + h % nEmp + 97 * q, 80 + t % 17)
      fijo r2 = azarHilo(s + k, 5000 + h % nEmp + 97 * q, 100 + t % 17)
      fijo estilo = q % 3
      var lado = -1
      si forzadoInv[hq] == 1 { lado = 2 }
      sino si estilo == 0 {
        si p * 10 < valor * 9 { lado = 0 } sino si p * 10 > valor * 11 { lado = 1 }
      } sino si estilo == 1 {
        # sigue la tendencia del precio: compra si subió más de un 2 % desde el
        # cierre de la hora anterior, vende si bajó más de un 2 %; actúa 1 de
        # cada 6 sesiones. Son los que inflan burbujas y las pinchan.
        si r2 < 0.17 y pH > 0 {
          si p * 100 > pH * 102 { lado = 0 } sino si p * 100 < pH * 98 { lado = 1 }
        }
      } sino {
        si r < umbral { lado = 0 } sino { lado = 1 }
      }
      si lado == 0 {
        fijo dinero: entero = saldoInv[hq]
        var presupuesto = dinero
        si credito == 1 {
          # a margen: hasta el 50 % de la cartera menos lo que ya debe, si su banco tiene cupo
          fijo kb = k * nBanco + q % nBanco
          fijo cart: entero = carteraInv[hq]
          fijo deu: entero = deudaInv[hq]
          var cred = cart * margen // 100 - deu
          si cred < 0 { cred = 0 }
          si cupo[kb] <= 0 { cred = 0 }
          presupuesto = dinero + cred
        }
        var pp = p
        si pp < 1 { pp = 1 }
        si presupuesto > 0 { compras = compras + (presupuesto * (1 + entero(piso(r * 5))) // 100 // nAct) // pp }
      } sino si lado == 1 {
        fijo tengo: entero = tenencia[h * ten + 1 + q]
        ventas = ventas + tengo * (1 + entero(piso(r * 5))) // 100
      } sino si lado == 2 {
        ventas = ventas + tenencia[h * ten + 1 + q]       # llamada de margen: todo
      }
    }
    # ── clubes: compran su objetivo con el 10 % del efectivo, venden el 5 % de las que pierden
    para c en rango(nEmp) {
      fijo kc = k * nEmp + c
      si clubExiste[kc] == 1 {
        fijo tengoC: entero = tenencia[h * ten + 1 + nInv + c]
        si forzadoClub[kc] == 1 { ventas = ventas + tengoC }
        sino si r3 < 0.17 {
          si objetivoClub[kc] == h {
            fijo ef: entero = saldoClub[kc]
            var pp = p
            si pp < 1 { pp = 1 }
            si ef > 0 { compras = compras + (ef // 20) // pp }
          } sino si gh < 0 y tengoC > 0 {
            ventas = ventas + tengoC // 20
          }
        }
      }
    }
    # la tesorería sale a vender solo cuando hay más compras que ventas, y cubre
    # como mucho la mitad del exceso: así la emisión frena las subidas sin hundir
    # el precio cuando nadie compra
    si compras > ventas {
      ofertaTes = (compras - ventas) // 2
      si ofertaTes > tes // 50 { ofertaTes = tes // 50 }
      si ofertaTes > tes { ofertaTes = tes }
      ventas = ventas + ofertaTes
    }
    # precio nuevo según el desequilibrio, acotado al ±0,5 % por sesión (60 sesiones
    # por hora: hasta ±35 % en una hora si todos empujan al mismo lado)
    var pNuevo = p
    si compras + ventas > 0 {
      fijo deseq = (compras - ventas) * 100 // (compras + ventas)   # -100..100
      pNuevo = p + p * deseq // 20000
      si pNuevo < 1 { pNuevo = 1 }
    }
    var cruzan = compras
    si ventas < cruzan { cruzan = ventas }
    si cruzan > 0 {
      # PRIMERO los compradores: cada uno toma su parte de lo cruzado en proporción a
      # lo que quería, mientras le alcance el presupuesto, y paga. DESPUÉS los
      # vendedores entregan exactamente lo comprado: tesorería primero, luego
      # inversores y clubes. Así nunca se paga una acción que nadie recibió (antes la
      # tesorería recompraba lo sobrante y su caja podía quedar en negativo).
      var porRepartir = cruzan
      var cmp = compras
      si cmp < 1 { cmp = 1 }
      para q en rango(nInv) {
        fijo hq = k * nInv + q
        fijo r = azarHilo(s + k, 5000 + h % nEmp + 97 * q, 80 + t % 17)
        fijo r2 = azarHilo(s + k, 5000 + h % nEmp + 97 * q, 100 + t % 17)
        fijo estilo = q % 3
        var compra = 0
        si forzadoInv[hq] == 0 {
          si estilo == 0 y p * 10 < valor * 9 { compra = 1 }
          si estilo == 1 y r2 < 0.17 y pH > 0 y p * 100 > pH * 102 { compra = 1 }
          si estilo == 2 y r < umbral { compra = 1 }
        }
        si compra == 1 y porRepartir > 0 {
          var pp = p
          si pp < 1 { pp = 1 }
          fijo dinero: entero = saldoInv[hq]
          var presupuesto = dinero
          si credito == 1 {
            fijo kb = k * nBanco + q % nBanco
            fijo cart: entero = carteraInv[hq]
            fijo deu: entero = deudaInv[hq]
            var cred = cart * margen // 100 - deu
            si cred < 0 { cred = 0 }
            si cupo[kb] <= 0 { cred = 0 }
            presupuesto = dinero + cred
          }
          si presupuesto > 0 {
            fijo quiere: entero = (presupuesto * (1 + entero(piso(r * 5))) // 100 // nAct) // pp
            var c = quiere * cruzan // cmp
            si c > porRepartir { c = porRepartir }
            si c * pNuevo > presupuesto { c = presupuesto // pNuevo }
            si c > 0 {
              tenencia[h * ten + 1 + q] = tenencia[h * ten + 1 + q] + c
              sumarAtomico(saldoInv, hq, 0 - c * pNuevo)   # si queda en negativo es un sobregiro: deuda, al cierre de la sesión
              porRepartir = porRepartir - c
            }
          }
        }
      }
      para c en rango(nEmp) {
        fijo kc = k * nEmp + c
        si clubExiste[kc] == 1 y forzadoClub[kc] == 0 y r3 < 0.17 y objetivoClub[kc] == h y porRepartir > 0 {
          fijo ef: entero = saldoClub[kc]
          var pp = p
          si pp < 1 { pp = 1 }
          si ef > 0 {
            fijo quiere: entero = (ef // 20) // pp
            var cc = quiere * cruzan // cmp
            si cc > porRepartir { cc = porRepartir }
            si cc * pNuevo > ef { cc = ef // pNuevo }
            si cc > 0 {
              tenencia[h * ten + 1 + nInv + c] = tenencia[h * ten + 1 + nInv + c] + cc
              sumarAtomico(saldoClub, kc, 0 - cc * pNuevo)
              porRepartir = porRepartir - cc
            }
          }
        }
      }
      # lo que de verdad se compró es lo que los vendedores entregan
      var quedan = cruzan - porRepartir
      var deTes = ofertaTes
      si quedan < deTes { deTes = quedan }
      tenencia[h * ten] = tenencia[h * ten] - deTes
      caja[h] = caja[h] + deTes * pNuevo
      quedan = quedan - deTes
      para q en rango(nInv) {
        fijo hq = k * nInv + q
        fijo r = azarHilo(s + k, 5000 + h % nEmp + 97 * q, 80 + t % 17)
        fijo r2 = azarHilo(s + k, 5000 + h % nEmp + 97 * q, 100 + t % 17)
        fijo estilo = q % 3
        var vende = 0
        si forzadoInv[hq] == 1 { vende = 2 }
        sino {
          si estilo == 0 y p * 10 > valor * 11 { vende = 1 }
          si estilo == 1 y r2 < 0.17 y pH > 0 y p * 100 < pH * 98 { vende = 1 }
          si estilo == 2 y r >= umbral { vende = 1 }
        }
        si vende > 0 y quedan > 0 {
          fijo tengo: entero = tenencia[h * ten + 1 + q]
          var v: entero = tengo
          si vende == 1 { v = tengo * (1 + entero(piso(r * 5))) // 100 }
          si v > quedan { v = quedan }
          si v > 0 {
            tenencia[h * ten + 1 + q] = tengo - v
            sumarAtomico(saldoInv, hq, v * pNuevo)
            quedan = quedan - v
          }
        }
      }
      para c en rango(nEmp) {
        fijo kc = k * nEmp + c
        si clubExiste[kc] == 1 y quedan > 0 {
          fijo tengoC: entero = tenencia[h * ten + 1 + nInv + c]
          var v: entero = 0
          si forzadoClub[kc] == 1 { v = tengoC }
          sino si r3 < 0.17 y objetivoClub[kc] != h y gh < 0 { v = tengoC // 20 }
          si v > quedan { v = quedan }
          si v > 0 {
            tenencia[h * ten + 1 + nInv + c] = tengoC - v
            sumarAtomico(saldoClub, kc, v * pNuevo)
            quedan = quedan - v
          }
        }
      }
      # no debería quedar nada (los vendedores ofrecieron al menos lo cruzado); si
      # queda, lo entrega la tesorería y la invariante de acciones lo delataría
      si quedan > 0 {
        tenencia[h * ten] = tenencia[h * ten] - quedan
        caja[h] = caja[h] + quedan * pNuevo
      }
    }
    precioAcc[h] = pNuevo
  }
}
# 11b. tras la sesión: un saldo negativo es un sobregiro y se convierte en deuda con
#      el banco (crea el depósito que faltaba). Un hilo por inversor.
fn sobregirar(h: entero, saldoInv, deudaInv, prestamos, sobregiros, nInv: entero, nBanco: entero) {
  fijo sal: entero = saldoInv[h]
  si sal < 0 {
    fijo k = h // nInv
    fijo kb = k * nBanco + (h % nInv) % nBanco
    deudaInv[h] = deudaInv[h] - sal
    sumarAtomico(prestamos, kb, 0 - sal)
    sumarAtomico(sobregiros, k, 1)
    saldoInv[h] = 0
  }
}
fn sobregirarClub(h: entero, saldoClub, deudaClub, prestamos, sobregiros, clubExiste, nEmp: entero, nBanco: entero) {
  fijo sal: entero = saldoClub[h]
  si clubExiste[h] == 1 y sal < 0 {
    fijo k = h // nEmp
    fijo kb = k * nBanco + (h % nEmp) % nBanco
    deudaClub[h] = deudaClub[h] - sal
    sumarAtomico(prestamos, kb, 0 - sal)
    sumarAtomico(sobregiros, k, 1)
    saldoClub[h] = 0
  }
}
# 11c. cada hora los inversores CONSUMEN: gastan hasta el 5 % de su efectivo en una
#      empresa de lujo (sector 4) o de ocio (3) con inventario. Así el dinero de los
#      dividendos vuelve a la economía real (cajas → salarios → compradores).
fn consumirInv(h: entero, saldoInv, activa, sector, inv, caja, precio, ventasHora, ingresosHora, consumido, t: entero, s: entero, nInv: entero, nEmp: entero) {
  fijo k = h // nInv
  fijo q = h % nInv
  fijo sal: entero = saldoInv[h]
  si sal > 0 {
    var intento = 0
    var hecho = 0
    mientras intento < 4 y hecho == 0 {
      fijo e = k * nEmp + entero(piso(azarHilo(s + k, 7000 + q, 130 + intento + t // 3600 % 11) * nEmp))
      si activa[e] == 1 y sector[e] >= 3 y inv[e] > 0 {
        fijo pr: entero = precio[e]
        var u = (sal // 20) // pr
        si u > 50 { u = 50 }
        si u > 0 {
          saldoInv[h] = sal - u * pr
          sumarAtomico(caja, e, u * pr)
          sumarAtomico(inv, e, 0 - u)
          sumarAtomico(ventasHora, e, u)
          sumarAtomico(ingresosHora, e, u * pr)
          sumarAtomico(consumido, k, u)
          hecho = 1
        }
      }
      intento = intento + 1
    }
  }
}
# 12. cada hora, los deudores: valoran su cartera, pagan intereses (0,2 %) y deuda con
#     el efectivo, y si la deuda pasa el 70 % de la cartera —o su banco está en crisis
#     de liquidez— quedan en llamada de margen (venden todo en la próxima sesión). El
#     que ya no tiene nada y debe: el banco castiga el préstamo contra su capital.
fn cerrarDeudorInv(h: entero, saldoInv, deudaInv, carteraInv, forzadoInv, tenencia, precioAcc, activa, prestamos, capBanco, reservasB, llamadas, castigos, nInv: entero, nEmp: entero, nBanco: entero, ten: entero, interes: entero, llamada: entero) {
  fijo k = h // nInv
  fijo q = h % nInv
  fijo kb = k * nBanco + q % nBanco
  var cart = 0
  para e en rango(nEmp) {
    fijo ke = k * nEmp + e
    si activa[ke] == 1 { cart = cart + tenencia[ke * ten + 1 + q] * precioAcc[ke] }
  }
  carteraInv[h] = cart
  forzadoInv[h] = 0
  fijo d: entero = deudaInv[h]
  si d > 0 {
    # intereses: se pagan del efectivo o se suman a la deuda (el banco se los acredita)
    fijo i = d * interes // 1000
    si saldoInv[h] >= i {
      saldoInv[h] = saldoInv[h] - i
      sumarAtomico(capBanco, kb, i)
    } sino {
      deudaInv[h] = deudaInv[h] + i
      sumarAtomico(prestamos, kb, i)
      sumarAtomico(capBanco, kb, i)
    }
    # paga deuda con la mitad del efectivo
    fijo salI: entero = saldoInv[h]
    var pago: entero = salI // 2
    si pago > deudaInv[h] { pago = deudaInv[h] }
    si pago > 0 {
      saldoInv[h] = saldoInv[h] - pago
      deudaInv[h] = deudaInv[h] - pago
      sumarAtomico(prestamos, kb, 0 - pago)
    }
    fijo d2: entero = deudaInv[h]
    si d2 > 0 {
      si cart == 0 y saldoInv[h] == 0 {
        sumarAtomico(prestamos, kb, 0 - d2)
        sumarAtomico(capBanco, kb, 0 - d2)
        sumarAtomico(castigos, k, d2)
        deudaInv[h] = 0
      } sino si d2 * 100 > cart * llamada o reservasB[kb] < 0 {
        forzadoInv[h] = 1
        sumarAtomico(llamadas, k, 1)
      }
    }
  }
}
fn cerrarDeudorClub(h: entero, clubExiste, saldoClub, deudaClub, carteraClub, forzadoClub, tenencia, precioAcc, activa, prestamos, capBanco, reservasB, llamadas, castigos, nInv: entero, nEmp: entero, nBanco: entero, ten: entero, interes: entero, llamada: entero) {
  forzadoClub[h] = 0
  si clubExiste[h] == 1 {
    fijo k = h // nEmp
    fijo c = h % nEmp
    fijo kb = k * nBanco + c % nBanco
    var cart = 0
    para e en rango(nEmp) {
      fijo ke = k * nEmp + e
      si activa[ke] == 1 { cart = cart + tenencia[ke * ten + 1 + nInv + c] * precioAcc[ke] }
    }
    carteraClub[h] = cart
    fijo d: entero = deudaClub[h]
    si d > 0 {
      fijo i = d * interes // 1000
      si saldoClub[h] >= i {
        saldoClub[h] = saldoClub[h] - i
        sumarAtomico(capBanco, kb, i)
      } sino {
        deudaClub[h] = deudaClub[h] + i
        sumarAtomico(prestamos, kb, i)
        sumarAtomico(capBanco, kb, i)
      }
      fijo salC: entero = saldoClub[h]
      var pago: entero = salC // 2
      si pago > deudaClub[h] { pago = deudaClub[h] }
      si pago > 0 {
        saldoClub[h] = saldoClub[h] - pago
        deudaClub[h] = deudaClub[h] - pago
        sumarAtomico(prestamos, kb, 0 - pago)
      }
      fijo d2: entero = deudaClub[h]
      si d2 > 0 {
        si cart == 0 y saldoClub[h] == 0 {
          sumarAtomico(prestamos, kb, 0 - d2)
          sumarAtomico(capBanco, kb, 0 - d2)
          sumarAtomico(castigos, k, d2)
          deudaClub[h] = 0
        } sino si d2 * 100 > cart * llamada o reservasB[kb] < 0 {
          forzadoClub[h] = 1
          sumarAtomico(llamadas, k, 1)
        }
      }
    }
  }
}
# 13. los bancos, cada hora: reservas = depósitos − préstamos (ya sumadas en la
#     verificación); el cupo de la hora es lo que sobra del encaje; reservas en
#     negativo son una crisis de liquidez (no presta). Un hilo por banco.
fn cerrarBanco(h: entero, reservasB, sumaDepBanco, prestamos, cupo, iliquidez, nBanco: entero, encaje: entero, credito: entero) {
  fijo dep: entero = sumaDepBanco[h]
  fijo pr: entero = prestamos[h]
  fijo res = dep - pr
  reservasB[h] = res
  var c = res - dep * encaje // 100
  si c < 0 { c = 0 }
  si credito == 0 { c = 0 }
  cupo[h] = c
  si res < 0 { sumarAtomico(iliquidez, h // nBanco, 1) }
}
# 14. los clubes, cada hora
# 14a. valor por participación: (efectivo + cartera − deuda) / participaciones; sin
#      participaciones, 100 centavos
fn valorarClub(h: entero, clubExiste, saldoClub, carteraClub, deudaClub, particTotal, valorPart, objetivoClub, activa, ganHora, precioAcc, nEmp: entero) {
  objetivoClub[h] = -1
  si clubExiste[h] == 1 {
    fijo pt: entero = particTotal[h]
    var v: entero = saldoClub[h] + carteraClub[h] - deudaClub[h]
    si v < 1 { v = 1 }
    si pt > 0 { valorPart[h] = v // pt } sino { valorPart[h] = 100 }
    si valorPart[h] < 1 { valorPart[h] = 1 }
    # objetivo: la empresa activa con más ganancia por hora frente a su precio
    fijo k = h // nEmp
    var mejor = -1
    var mejorR = 0
    para e en rango(nEmp) {
      fijo ke = k * nEmp + e
      si activa[ke] == 1 y ganHora[ke] > 0 y precioAcc[ke] > 0 {
        fijo gk: entero = ganHora[ke]
        fijo pk: entero = precioAcc[ke]
        fijo r = gk * 10000 // pk
        si r > mejorR {
          mejorR = r
          mejor = ke
        }
      }
    }
    objetivoClub[h] = mejor
  }
}
# 14b. candidatos a fundar: trabajadores decididos (voluntad ≥ 90) sin club en una
#      empresa sin club
fn candidatosClub(h: entero, empleo, clubDe, voluntad, clubExiste, activa, candidatos, nAg: entero, nEmp: entero) {
  fijo e = empleo[h]
  si e >= 0 y clubDe[h] < 0 y voluntad[h] >= 90 {
    fijo ke = (h // nAg) * nEmp + e
    si activa[ke] == 1 y clubExiste[ke] == 0 { sumarAtomico(candidatos, ke, 1) }
  }
}
fn nacerClub(h: entero, candidatos, clubExiste, activa, saldoClub, deudaClub, particTotal, valorPart, nClubs, nEmp: entero) {
  si candidatos[h] > 0 y clubExiste[h] == 0 y activa[h] == 1 {
    clubExiste[h] = 1
    saldoClub[h] = 0
    deudaClub[h] = 0
    particTotal[h] = 0
    valorPart[h] = 100
    sumarAtomico(nClubs, h // nEmp, 1)
  }
  candidatos[h] = 0
}
# 14c. unirse o aportar: el trabajador de una empresa con club, con probabilidad
#      voluntad/300 por hora, pone saldo × voluntad / 200 y recibe participaciones al
#      valor del club (lo que no da para una participación entera no se mueve)
fn aportarClub(h: entero, empleo, clubDe, partic, saldo, voluntad, clubExiste, saldoClub, particTotal, valorPart, socios, t: entero, s: entero, nAg: entero, nEmp: entero, salario: entero) {
  fijo e = empleo[h]
  si e >= 0 {
    fijo k = h // nAg
    fijo ke = k * nEmp + e
    si clubExiste[ke] == 1 y (clubDe[h] < 0 o clubDe[h] == ke) {
      fijo vo: entero = voluntad[h]
      fijo r = azarHilo(s + k, h, 110 + t // 3600 % 7)
      si r * 300 < vo y saldo[h] > salario * 2 {
        fijo sal: entero = saldo[h]
        fijo ap = sal * vo // 200
        fijo vp: entero = valorPart[ke]
        fijo parts = ap // vp
        si parts > 0 {
          fijo pago = parts * vp
          saldo[h] = sal - pago
          sumarAtomico(saldoClub, ke, pago)
          sumarAtomico(particTotal, ke, parts)
          si clubDe[h] < 0 {
            clubDe[h] = ke
            sumarAtomico(socios, k, 1)
          }
          partic[h] = partic[h] + parts
        }
      }
    }
  }
}
# 14d. retiros: el socio sin dinero (menos de medio salario) pide su parte
fn pedirRetiro(h: entero, clubDe, partic, saldo, valorPart, demandaRetiro, retira, salario: entero) {
  retira[h] = 0
  fijo c = clubDe[h]
  si c >= 0 y saldo[h] < salario // 2 y partic[h] > 0 {
    fijo pa: entero = partic[h]
    fijo vp: entero = valorPart[c]
    fijo monto = pa * vp
    retira[h] = monto
    sumarAtomico(demandaRetiro, c, monto)
  }
}
#      el club paga lo pedido si tiene efectivo; si no, a prorrata de lo que hay (corrida)
fn atenderRetiros(h: entero, clubExiste, saldoClub, demandaRetiro, factorRetiro, corridas, nEmp: entero) {
  factorRetiro[h] = 1000000
  fijo dem: entero = demandaRetiro[h]
  si clubExiste[h] == 1 y dem > 0 {
    fijo ef: entero = saldoClub[h]
    si ef < dem {
      var f = 0
      si ef > 0 { f = ef * 1000000 // dem }
      factorRetiro[h] = f
      sumarAtomico(corridas, h // nEmp, 1)
    }
  }
  demandaRetiro[h] = 0
}
fn cobrarRetiro(h: entero, clubDe, partic, saldo, retira, saldoClub, particTotal, factorRetiro, socios, nAg: entero) {
  fijo c = clubDe[h]
  fijo monto: entero = retira[h]
  si c >= 0 y monto > 0 {
    fijo f: entero = factorRetiro[c]
    fijo cobra = monto * f // 1000000
    saldo[h] = saldo[h] + cobra
    sumarAtomico(saldoClub, c, 0 - cobra)
    sumarAtomico(particTotal, c, 0 - partic[h])
    partic[h] = 0
    clubDe[h] = -1
    sumarAtomico(socios, h // nAg, 0 - 1)
    retira[h] = 0
  }
}
# 15. verificación por economía
fn sumarDineroAg(h: entero, saldo, sumaDinero, sumaDepBanco, nAg: entero, nBanco: entero) {
  fijo k = h // nAg
  sumarAtomico(sumaDinero, k, saldo[h])
  sumarAtomico(sumaDepBanco, k * nBanco + (h % nAg) % nBanco, saldo[h])
}
fn sumarDineroInv(h: entero, saldoInv, deudaInv, sumaDinero, sumaDeuda, sumaDepBanco, nInv: entero, nBanco: entero) {
  fijo k = h // nInv
  sumarAtomico(sumaDinero, k, saldoInv[h])
  sumarAtomico(sumaDeuda, k, deudaInv[h])
  sumarAtomico(sumaDepBanco, k * nBanco + (h % nInv) % nBanco, saldoInv[h])
}
fn sumarDineroEmp(h: entero, caja, deudaEmp, saldoClub, deudaClub, sumaDinero, sumaDeuda, sumaDepBanco, nEmp: entero, nBanco: entero) {
  fijo k = h // nEmp
  fijo kb = k * nBanco + (h % nEmp) % nBanco
  sumarAtomico(sumaDinero, k, caja[h] + saldoClub[h])
  sumarAtomico(sumaDeuda, k, deudaEmp[h] + deudaClub[h])
  sumarAtomico(sumaDepBanco, kb, caja[h] + saldoClub[h])
}
fn sumarDineroBanco(h: entero, capBanco, prestamos, sumaDinero, sumaDepBanco, prestamosVivos, nBanco: entero) {
  fijo k = h // nBanco
  sumarAtomico(sumaDinero, k, capBanco[h])
  sumarAtomico(sumaDepBanco, h, capBanco[h])
  sumarAtomico(prestamosVivos, k, prestamos[h])
}
fn sumarTenencia(h: entero, tenencia, sumaAcc, ten: entero) { sumarAtomico(sumaAcc, h // ten, tenencia[h]) }
fn sumarPartic(h: entero, clubDe, partic, sumaPart) {
  fijo c = clubDe[h]
  si c >= 0 { sumarAtomico(sumaPart, c, partic[h]) }
}
fn verificar(k: entero, sumaDinero, sumaDeuda, prestamosVivos, dinero0, sumaAcc, activa, accVivas, inv, producido, consumido, destruido, enMaquinas, sumaPart, particTotal, clubExiste, fallo, nEmp: entero, acc: entero) {
  # depósitos − préstamos vivos = base monetaria; deudas = préstamos
  fijo dep: entero = sumaDinero[k]
  fijo pr: entero = prestamosVivos[k]
  si dep - pr != dinero0[k] { fallo[k] = 2 }
  si sumaDeuda[k] != pr { fallo[k] = 3 }
  var vivas = 0
  var enEstante = 0
  para e en rango(nEmp) {
    fijo ke = k * nEmp + e
    si activa[ke] == 1 {
      si sumaAcc[ke] != acc { fallo[k] = 4 }
      vivas = vivas + acc
    } sino {
      si sumaAcc[ke] != 0 { fallo[k] = 4 }
    }
    enEstante = enEstante + inv[ke]
    si clubExiste[ke] == 1 y sumaPart[ke] != particTotal[ke] { fallo[k] = 6 }
  }
  si vivas != accVivas[k] { fallo[k] = 4 }
  si producido[k] != consumido[k] + enEstante + destruido[k] + enMaquinas[k] { fallo[k] = 5 }
}
fn medir(k: entero, activa, precioAcc, indiceBolsa, nActivas, indiceHace1h, caidaMax, paro, paroMax, nEmp: entero) {
  var suma = 0
  var n = 0
  para e en rango(nEmp) {
    fijo ke = k * nEmp + e
    si activa[ke] == 1 {
      suma = suma + precioAcc[ke]
      n = n + 1
    }
  }
  si n > 0 { indiceBolsa[k] = suma // n }
  nActivas[k] = n
  si paro[k] > paroMax[k] { paroMax[k] = paro[k] }
  si indiceHace1h[k] > 0 {
    fijo caida = (indiceHace1h[k] - indiceBolsa[k]) * 100 // indiceHace1h[k]
    si caida > caidaMax[k] { caidaMax[k] = caida }
  }
}
# euforia y pánico: el azar de la bolsa se sesga según cómo fue la última hora
fn guardarIndice(k: entero, indiceBolsa, indiceHace1h, sesgo) {
  fijo antes: entero = indiceHace1h[k]
  fijo ahora: entero = indiceBolsa[k]
  sesgo[k] = 0
  si antes > 0 {
    si ahora * 100 > antes * 110 { sesgo[k] = 20 }
    si ahora * 100 < antes * 90 { sesgo[k] = -20 }
  }
  indiceHace1h[k] = ahora
}
fn guardarPrecioAcc(h: entero, precioAcc, precioAccH) { precioAccH[h] = precioAcc[h] }

# ─────────────────────────────────────────────── el programa
imprimir("ECOSIM-G v2 · {N_ECO} economías × {N_AG} compradores · {N_INI} empresas al empezar (hasta {N_EMP}) · {N_INV} inversores · {N_BANCO} bancos · crédito {CREDITO} · {TICKS} ticks · semilla {SEMILLA}")
imprimir("dispositivo: {dispositivo()}")
fijo t0 = reloj()
paralelo(TOTAL_H, iniciarAgente, saldo, hambre, aburr, curio, empleo, voluntad, clubDe, partic, SEMILLA, N_AG, N_INI, DINERO_AG)
paralelo(TOTAL_I, iniciarInversor, saldoInv, SEMILLA, N_INV, DINERO_INV)
paralelo(TOTAL_B, iniciarBanco, capBanco, CAPITAL_BANCO)
paralelo(TOTAL_E, iniciarEmpresa, activa, sector, caja, precio, inv, trab, precioAcc, calidad, estrellas, resenas, nacida, objetivoClub, SEMILLA, N_EMP, N_INI, POR_SECTOR, N_AG, DINERO_EMP)
paralelo(TOTAL_E * ACC, repartirAcciones, tenencia, activa, SEMILLA, N_EMP, ACC, TEN, N_INV)
# el inventario inicial cuenta como producido
fn contarInicial(h: entero, activa, inv, producido, nEmp: entero) { si activa[h] == 1 { sumarAtomico(producido, h // nEmp, inv[h]) } }
paralelo(TOTAL_E, contarInicial, activa, inv, producido, N_EMP)
# la base monetaria: todo el dinero del arranque (no hay préstamos todavía)
paralelo(N_ECO, aCero, sumaDinero)
paralelo(TOTAL_B, aCero, sumaDepBanco)
paralelo(N_ECO, aCero, prestamosVivos)
paralelo(TOTAL_H, sumarDineroAg, saldo, sumaDinero, sumaDepBanco, N_AG, N_BANCO)
paralelo(TOTAL_I, sumarDineroInv, saldoInv, deudaInv, sumaDinero, sumaDeuda, sumaDepBanco, N_INV, N_BANCO)
paralelo(TOTAL_E, sumarDineroEmp, caja, deudaEmp, saldoClub, deudaClub, sumaDinero, sumaDeuda, sumaDepBanco, N_EMP, N_BANCO)
paralelo(TOTAL_B, sumarDineroBanco, capBanco, prestamos, sumaDinero, sumaDepBanco, prestamosVivos, N_BANCO)
fn fijarDinero0(k: entero, sumaDinero, dinero0, accVivas, nIni: entero, acc: entero) {
  dinero0[k] = sumaDinero[k]
  accVivas[k] = nIni * acc
}
paralelo(N_ECO, fijarDinero0, sumaDinero, dinero0, accVivas, N_INI, ACC)
paralelo(TOTAL_B, cerrarBanco, reservasB, sumaDepBanco, prestamos, cupo, iliquidez, N_BANCO, ENCAJE, CREDITO)
paralelo(N_ECO, aCero, iliquidez)
imprimir("arranque: {entero(reloj() - t0)} ms · base monetaria por economía: {elemento(dinero0, 0) // 100} monedas")

var csv = "tick,economia,paro,indiceBolsa,activas,quiebras,fundadas,fundadasClub,producido,consumido,prestamosVivos,clubs,socios,llamadasMargen,castigos,iliquidez,corridas\n"
fn filaCsv(t: entero) {
  para k en rango(N_ECO) {
    var act = 0
    para e en rango(N_EMP) { si elemento(activa, k * N_EMP + e) == 1 { act = act + 1 } }
    csv = csv + "{t},{k},{elemento(paro, k)},{elemento(indiceBolsa, k)},{act},{elemento(quiebras, k)},{elemento(fundadas, k)},{elemento(fundadasClub, k)},{elemento(producido, k)},{elemento(consumido, k)},{elemento(prestamosVivos, k)},{elemento(nClubs, k)},{elemento(socios, k)},{elemento(llamadas, k)},{elemento(castigos, k)},{elemento(iliquidez, k)},{elemento(corridas, k)}\n"
  }
}

fijo t1 = reloj()
para t en rango(TICKS) {
  paralelo(TOTAL_H, elegir, hambre, aburr, curio, eleccion, saldo, activa, precio, estrellas, resenas, sector, demanda, t, SEMILLA, N_AG, N_EMP, POR_SECTOR)
  paralelo(TOTAL_H, comprar, eleccion, saldo, caja, inv, demanda, ventas, compro, precio, hambre, aburr, curio, sector, estrellas, resenas, calidad, consumido, t, SEMILLA, N_AG)
  paralelo(TOTAL_E, cerrarVentas, inv, ventas, ventasHora, ingresosHora, precio, demanda, activa)
  paralelo(TOTAL_E, aCero, ventas)
  paralelo(TOTAL_E, producir, activa, progreso, trab, inv, maquinas, producido, N_EMP)
  si t % 60 == 59 {
    paralelo(TOTAL_E, bolsa, activa, precioAcc, precioAccH, tenencia, saldoInv, deudaInv, carteraInv, forzadoInv, divPorAcc, ganHora, caja, trab, clubExiste, saldoClub, objetivoClub, forzadoClub, cupo, sesgo, nActivas, t, SEMILLA, N_EMP, N_INV, N_BANCO, TEN, ACC, SALARIO, MARGEN_PRESTAMO, CREDITO)
    paralelo(TOTAL_I, sobregirar, saldoInv, deudaInv, prestamos, sobregiros, N_INV, N_BANCO)
    paralelo(TOTAL_E, sobregirarClub, saldoClub, deudaClub, prestamos, sobregiros, clubExiste, N_EMP, N_BANCO)
  }
  si t % 600 == 599 {
    paralelo(TOTAL_E, dividendos, activa, caja, ganHora, tenencia, trab, divPorAcc, deudaEmp, N_EMP, TEN, ACC, SALARIO)
    paralelo(TOTAL_I, cobrarDividendos, saldoInv, tenencia, divPorAcc, N_INV, N_EMP, TEN)
    paralelo(TOTAL_E, cobrarDividendosClub, saldoClub, clubExiste, tenencia, divPorAcc, N_INV, N_EMP, TEN)
  }
  si t % 3600 == 3599 {
    paralelo(TOTAL_I, consumirInv, saldoInv, activa, sector, inv, caja, precio, ventasHora, ingresosHora, consumido, t, SEMILLA, N_INV, N_EMP)
    paralelo(TOTAL_E, aCero, salariosHora)
    paralelo(TOTAL_E, pagarSalarios, activa, empleo, saldo, caja, salariosHora, deudaEmp, prestamos, cupo, sinNomina, trab, N_AG, N_EMP, N_BANCO, SALARIO, CREDITO)
    paralelo(TOTAL_E, cerrarHora, activa, ventasHora, ingresosHora, salariosHora, ganHora, ganMax, horasMalas, inv, precio, trab, caja, deudaEmp, prestamos, nacida, t, GRACIA, N_EMP, N_BANCO, SALARIO)
    paralelo(TOTAL_E, invertirMaquinas, activa, sector, caja, deudaEmp, trab, inv, precio, maquinas, ventasHora, ingresosHora, enMaquinas, t, SEMILLA, N_EMP, SALARIO)
    # quiebras → liquidación → despidos → cancelación
    paralelo(TOTAL_E, quebrar, activa, horasMalas, sinNomina, inv, maquinas, destruido, enMaquinas, caja, deudaEmp, prestamos, capBanco, castigos, tenencia, divPorAcc, precioAcc, trab, quiebras, accVivas, N_EMP, N_BANCO, TEN, ACC)
    paralelo(TOTAL_I, cobrarDividendos, saldoInv, tenencia, divPorAcc, N_INV, N_EMP, TEN)
    paralelo(TOTAL_E, cobrarDividendosClub, saldoClub, clubExiste, tenencia, divPorAcc, N_INV, N_EMP, TEN)
    paralelo(TOTAL_E * TEN, cancelarAcciones, tenencia, activa, precioAcc, TEN)
    paralelo(TOTAL_H, despedir, empleo, activa, N_AG, N_EMP)
    # deudores: cartera, intereses, pagos, llamadas de margen, castigos
    paralelo(TOTAL_I, cerrarDeudorInv, saldoInv, deudaInv, carteraInv, forzadoInv, tenencia, precioAcc, activa, prestamos, capBanco, reservasB, llamadas, castigos, N_INV, N_EMP, N_BANCO, TEN, INTERES, MARGEN_LLAMADA)
    paralelo(TOTAL_E, cerrarDeudorClub, clubExiste, saldoClub, deudaClub, carteraClub, forzadoClub, tenencia, precioAcc, activa, prestamos, capBanco, reservasB, llamadas, castigos, N_INV, N_EMP, N_BANCO, TEN, INTERES, MARGEN_LLAMADA)
    # clubes: valor, nacimientos, aportes, retiros
    paralelo(TOTAL_E, valorarClub, clubExiste, saldoClub, carteraClub, deudaClub, particTotal, valorPart, objetivoClub, activa, ganHora, precioAcc, N_EMP)
    paralelo(TOTAL_H, candidatosClub, empleo, clubDe, voluntad, clubExiste, activa, candidatos, N_AG, N_EMP)
    paralelo(TOTAL_E, nacerClub, candidatos, clubExiste, activa, saldoClub, deudaClub, particTotal, valorPart, nClubs, N_EMP)
    paralelo(TOTAL_H, aportarClub, empleo, clubDe, partic, saldo, voluntad, clubExiste, saldoClub, particTotal, valorPart, socios, t, SEMILLA, N_AG, N_EMP, SALARIO)
    paralelo(TOTAL_H, pedirRetiro, clubDe, partic, saldo, valorPart, demandaRetiro, retira, SALARIO)
    paralelo(TOTAL_E, atenderRetiros, clubExiste, saldoClub, demandaRetiro, factorRetiro, corridas, N_EMP)
    paralelo(TOTAL_H, cobrarRetiro, clubDe, partic, saldo, retira, saldoClub, particTotal, factorRetiro, socios, N_AG)
    # fundaciones (un hilo por economía) y contrataciones
    paralelo(N_ECO, fundarInversores, saldoInv, activa, sector, ganHora, caja, precioAcc, nacida, fundadaPor, tenencia, fundadas, accVivas, aporte, t, SEMILLA, N_INV, N_EMP, N_INI, N_SECTOR, TEN, ACC, FUNDAR, N_FUNDADORES)
    paralelo(N_ECO, fundarClub, clubExiste, saldoClub, deudaClub, carteraClub, cupo, prestamos, activa, sector, ganHora, caja, precioAcc, nacida, fundadaPor, tenencia, fundadas, fundadasClub, clubFundadas, accVivas, t, SEMILLA, N_INV, N_EMP, N_INI, N_SECTOR, N_BANCO, TEN, ACC, FUNDAR, FUNDAR_ACC, CREDITO)
    paralelo(TOTAL_E, nacer, activa, nacida, sector, precio, inv, trab, maquinas, calidad, estrellas, resenas, horasMalas, sinNomina, ganMax, t, SEMILLA, N_EMP)
    paralelo(TOTAL_E, aCero, trab)
    paralelo(N_ECO, aCero, paro)
    paralelo(TOTAL_H, recontar, empleo, trab, paro, N_AG, N_EMP)
    paralelo(TOTAL_H, contratar, empleo, activa, caja, trab, t, SEMILLA, N_AG, N_EMP, SALARIO)
    paralelo(TOTAL_E, aCero, trab)
    paralelo(N_ECO, aCero, paro)
    paralelo(TOTAL_H, recontar, empleo, trab, paro, N_AG, N_EMP)
    paralelo(N_ECO, medir, activa, precioAcc, indiceBolsa, nActivas, indiceHace1h, caidaMax, paro, paroMax, N_EMP)
    paralelo(N_ECO, guardarIndice, indiceBolsa, indiceHace1h, sesgo)
    paralelo(TOTAL_E, guardarPrecioAcc, precioAcc, precioAccH)
  }
  si t % 60 == 0 {
    # invariantes en todas las economías, y las reservas de los bancos
    paralelo(N_ECO, aCero, sumaDinero)
    paralelo(N_ECO, aCero, sumaDeuda)
    paralelo(N_ECO, aCero, prestamosVivos)
    paralelo(TOTAL_B, aCero, sumaDepBanco)
    paralelo(TOTAL_H, sumarDineroAg, saldo, sumaDinero, sumaDepBanco, N_AG, N_BANCO)
    paralelo(TOTAL_I, sumarDineroInv, saldoInv, deudaInv, sumaDinero, sumaDeuda, sumaDepBanco, N_INV, N_BANCO)
    paralelo(TOTAL_E, sumarDineroEmp, caja, deudaEmp, saldoClub, deudaClub, sumaDinero, sumaDeuda, sumaDepBanco, N_EMP, N_BANCO)
    paralelo(TOTAL_B, sumarDineroBanco, capBanco, prestamos, sumaDinero, sumaDepBanco, prestamosVivos, N_BANCO)
    paralelo(TOTAL_E, aCero, sumaAcc)
    paralelo(TOTAL_E * TEN, sumarTenencia, tenencia, sumaAcc, TEN)
    paralelo(TOTAL_E, aCero, sumaPart)
    paralelo(TOTAL_H, sumarPartic, clubDe, partic, sumaPart)
    paralelo(N_ECO, verificar, sumaDinero, sumaDeuda, prestamosVivos, dinero0, sumaAcc, activa, accVivas, inv, producido, consumido, destruido, enMaquinas, sumaPart, particTotal, clubExiste, fallo, N_EMP, ACC)
    para k en rango(N_ECO) {
      fijo f = elemento(fallo, k)
      si f == 2 { lanzar error("tick {t}, economía {k}: dinero fantasma (depósitos − préstamos − base = {elemento(sumaDinero, k) - elemento(prestamosVivos, k) - elemento(dinero0, k)} centavos)") }
      si f == 3 { lanzar error("tick {t}, economía {k}: las deudas ({elemento(sumaDeuda, k)}) no cuadran con los préstamos ({elemento(prestamosVivos, k)})") }
      si f == 4 { lanzar error("tick {t}, economía {k}: las acciones no cuadran") }
      si f == 5 { lanzar error("tick {t}, economía {k}: bienes que no cuadran") }
      si f == 6 { lanzar error("tick {t}, economía {k}: las participaciones de un club no cuadran") }
    }
    si t % 3600 == 0 y t > 0 {
      paralelo(TOTAL_B, cerrarBanco, reservasB, sumaDepBanco, prestamos, cupo, iliquidez, N_BANCO, ENCAJE, CREDITO)
    }
    paralelo(N_ECO, medir, activa, precioAcc, indiceBolsa, nActivas, indiceHace1h, caidaMax, paro, paroMax, N_EMP)
    si t % 600 == 0 { filaCsv(t) }
  }
}
fijo ms = reloj() - t1
escribirTexto(RUTA_CSV, csv)

# ─────────────────────────────────────────────── el resumen Monte Carlo
imprimir("{TICKS} ticks × {N_ECO} economías en {entero(ms)} ms · {ms / TICKS} ms por tick (todas las economías a la vez) · {ms / TICKS / N_ECO} ms por tick y economía")
imprimir("invariantes ✓ en las {N_ECO} economías: dinero (depósitos − préstamos = base), deudas = préstamos, acciones, bienes, participaciones")
var conCrisisParo = 0
var conCaida = 0
var conBurbuja = 0
var conIliquidez = 0
var conLlamadas = 0
var conCorridas = 0
var totQ = 0.0
var totF = 0.0
var totFC = 0.0
var totClubs = 0.0
var totSocios = 0.0
var paroFinal = 0.0
var totPrest = 0.0
var totCastigo = 0.0
para k en rango(N_ECO) {
  si elemento(paroMax, k) * 20 > N_AG { conCrisisParo = conCrisisParo + 1 }     # más del 5 % de paro en algún momento
  si elemento(caidaMax, k) >= 20 { conCaida = conCaida + 1 }                    # el índice cayó un 20 % o más en una hora
  si elemento(indiceBolsa, k) >= 2 * PRECIO_ACC0 { conBurbuja = conBurbuja + 1 }  # el índice acabó al doble o más de la salida
  si elemento(iliquidez, k) > 0 { conIliquidez = conIliquidez + 1 }
  si elemento(llamadas, k) > 0 { conLlamadas = conLlamadas + 1 }
  si elemento(corridas, k) > 0 { conCorridas = conCorridas + 1 }
  totQ = totQ + elemento(quiebras, k)
  totF = totF + elemento(fundadas, k)
  totFC = totFC + elemento(fundadasClub, k)
  totClubs = totClubs + elemento(nClubs, k)
  totSocios = totSocios + elemento(socios, k)
  paroFinal = paroFinal + elemento(paro, k)
  totPrest = totPrest + elemento(prestamosVivos, k)
  totCastigo = totCastigo + elemento(castigos, k)
}
imprimir("mundos con crisis de empleo (paro > 5 %): {conCrisisParo} de {N_ECO} ({conCrisisParo * 100 // N_ECO} %)")
imprimir("mundos con caída de bolsa (≥ 20 % en una hora): {conCaida} de {N_ECO} ({conCaida * 100 // N_ECO} %)")
imprimir("mundos con burbuja (índice final ≥ 2× la salida): {conBurbuja} de {N_ECO} ({conBurbuja * 100 // N_ECO} %)")
imprimir("mundos con crisis de liquidez bancaria: {conIliquidez} de {N_ECO} · con llamadas de margen: {conLlamadas} · con corridas contra un club: {conCorridas}")
imprimir("quiebras en total: {totQ} ({totQ / N_ECO} por mundo) · empresas fundadas: {totF} ({totF / N_ECO} por mundo), de ellas por clubes: {totFC}")
imprimir("clubes: {totClubs / N_ECO} por mundo con {totSocios / N_ECO} socios · préstamos vivos al final: {entero(totPrest / N_ECO / 100)} monedas por mundo · castigados: {entero(totCastigo / N_ECO / 100)} monedas por mundo")
imprimir("desempleo medio al final: {paroFinal * 100 / (N_ECO * N_AG)} %")
imprimir("primeras economías:")
para k en rango(minimo(5, N_ECO)) {
  var act = 0
  para e en rango(N_EMP) { si elemento(activa, k * N_EMP + e) == 1 { act = act + 1 } }
  imprimir("  mundo {k}: paro {elemento(paro, k)} (máx {elemento(paroMax, k)}) · índice {elemento(indiceBolsa, k) / 100} · {act} empresas activas · {elemento(quiebras, k)} quiebras · {elemento(fundadas, k)} fundadas ({elemento(fundadasClub, k)} por clubes) · {elemento(nClubs, k)} clubes con {elemento(socios, k)} socios · préstamos {elemento(prestamosVivos, k) // 100} · llamadas {elemento(llamadas, k)} · corridas {elemento(corridas, k)} · mayor caída {elemento(caidaMax, k)} %")
}
# dónde quedó el dinero del mundo 0, y los 5 clubes y 5 inversores más ricos
var dAg = 0.0
var dInv = 0.0
var dEmp = 0.0
var dClub = 0.0
var dBanco = 0.0
para i en rango(N_AG) { dAg = dAg + elemento(saldo, i) }
para q en rango(N_INV) { dInv = dInv + elemento(saldoInv, q) }
para e en rango(N_EMP) {
  dEmp = dEmp + elemento(caja, e)
  dClub = dClub + elemento(saldoClub, e)
}
para b en rango(N_BANCO) { dBanco = dBanco + elemento(capBanco, b) }
imprimir("mundo 0, dónde quedó el dinero: compradores {entero(dAg / 100)} · inversores {entero(dInv / 100)} · empresas {entero(dEmp / 100)} · clubes {entero(dClub / 100)} · capital de los bancos {entero(dBanco / 100)} monedas (base {elemento(dinero0, 0) // 100} + préstamos {elemento(prestamosVivos, 0) // 100})")
fn patrimonioInv(q: entero): real {
  var p = 0.0 + elemento(saldoInv, q) - elemento(deudaInv, q)
  para e en rango(N_EMP) { si elemento(activa, e) == 1 { p = p + elemento(tenencia, e * TEN + 1 + q) * elemento(precioAcc, e) } }
  devolver p
}
fn patrimonioClub(c: entero): real {
  var p = 0.0 + elemento(saldoClub, c) - elemento(deudaClub, c)
  para e en rango(N_EMP) { si elemento(activa, e) == 1 { p = p + elemento(tenencia, e * TEN + 1 + N_INV + c) * elemento(precioAcc, e) } }
  devolver p
}
var ranking = ""
var listaInv: lista<real> = []
para q en rango(N_INV) { agregar(listaInv, patrimonioInv(q)) }
var listaClub: lista<real> = []
para c en rango(N_EMP) { si elemento(clubExiste, c) == 1 { agregar(listaClub, patrimonioClub(c)) } }
fn top5(l: lista<real>): texto {
  fijo o = ordenar(l)
  var s = ""
  var n = longitud(o)
  var i = 0
  mientras i < 5 y n - 1 - i >= 0 {
    s = s + "{entero(o[n - 1 - i] / 100)} "
    i = i + 1
  }
  devolver s
}
imprimir("mundo 0, top 5 inversores (patrimonio, monedas): {top5(listaInv)}")
imprimir("mundo 0, top 5 clubes (patrimonio, monedas):     {top5(listaClub)} ({longitud(listaClub)} clubes)")
imprimir("serie por mundo cada 10 min en {RUTA_CSV}")
