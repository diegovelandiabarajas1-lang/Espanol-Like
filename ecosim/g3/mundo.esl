# ECOSIM-G v3 · EL MUNDO Y LA ECOLOGÍA (mecánicas 91–100, añadidas para llegar a 100)
#
# La lista de Diego tenía 90. Faltaba lo que no decide nadie: el clima y la tierra.
# Sin esto la temperatura [6], la cosecha [28], la sed [2] y las epidemias [95] no
# tendrían de dónde salir.
#
# clima (kt·16): 0 temperatura · 1 llovió hoy · 2 días sin lluvia · 3 acuífero ·
#   4 suelo · 5 bosque · 6 contaminación · 7 días de plaga · 8 plaga nueva hoy ·
#   9 desastre hoy · 10 desastre este año · 11 agua sacada · 12 comida cosechada ·
#   13 emisiones · 14 casas construidas (tala)
#
# Un hilo por territorio, una vez al día (cada 600 ticks: seis días por año):
# [91] estaciones: el año se parte en cuatro (primavera, verano, otoño, invierno).
# [92] clima: la temperatura del día = la de la estación ± 4 °C, más 1 °C por cada
#      1000 de contaminación (el calentamiento).
# [93] lluvia y sequía: llueve según la estación y el bosque; tres días sin lluvia
#      son sequía (la cosecha baja a la mitad).
# [99] acuífero: la lluvia lo llena, el agua que se produce lo vacía; casi vacío,
#      las empresas de agua producen menos.
# [98] suelo: la cosecha lo agota; en invierno descansa. La comida depende de él.
# [94] plaga: en verano, a veces; destruye un 30 % de la comida almacenada en las
#      empresas del territorio y baja la cosecha 3 días.
# [96] desastre: raro, más probable sin bosque (inundaciones): destruye inventario,
#      rompe casas y rutas, y hiere.
# [97] contaminación: la emiten la tecnología y el lujo al producir; el bosque la
#      absorbe; enferma [4] y calienta [92].
# [100] bosque: crece solo; las casas [13] se hacen con su madera (la tala); sin
#      bosque hay más desastres y más contaminación.
publico fn tiempoDia(h: entero, clima, terrP, cuenta, s: entero, t: entero, nTerr: entero, ano: entero) {
  fijo k = h // nTerr
  fijo tt = h % nTerr
  fijo q = h * 16
  fijo est = (t % ano) * 4 // ano
  fijo diaN = t // 600
  var base = 18
  si est == 1 { base = 28 }
  si est == 2 { base = 14 }
  si est == 3 { base = 3 }
  fijo ruido = entero(piso(azarHilo(s + k, 9300 + tt, 600 + diaN % 97) * 9)) - 4
  clima[q] = base + ruido + clima[q + 6] // 1000
  # lluvia y acuífero
  var pLluvia = 0.55
  si est == 1 { pLluvia = 0.3 }
  si est == 2 { pLluvia = 0.5 }
  si est == 3 { pLluvia = 0.4 }
  pLluvia = pLluvia * (0.6 + clima[q + 5] / 25000.0)
  var ac = clima[q + 3] - clima[q + 11]
  clima[q + 11] = 0
  si azarHilo(s + k, 9310 + tt, 601 + diaN % 97) < pLluvia {
    clima[q + 1] = 1
    clima[q + 2] = 0
    ac = ac + 3000
  } sino {
    clima[q + 1] = 0
    clima[q + 2] = clima[q + 2] + 1
    si clima[q + 2] == 3 { sumarAtomico(cuenta, k * 48 + 33, 1) }
  }
  clima[q + 3] = minimo(30000, maximo(0, ac))
  # suelo
  var su = clima[q + 4] - clima[q + 12] * 4 + 300
  si est == 3 { su = su + 600 }
  clima[q + 12] = 0
  clima[q + 4] = minimo(10000, maximo(500, su))
  # bosque y contaminación
  fijo bo = minimo(10000, maximo(0, clima[q + 5] + 60 - clima[q + 14] * 20))
  clima[q + 14] = 0
  clima[q + 5] = bo
  clima[q + 6] = maximo(0, clima[q + 6] + clima[q + 13] // 5 - bo // 200 - 50)
  clima[q + 13] = 0
  # plaga
  clima[q + 8] = 0
  si clima[q + 7] > 0 { clima[q + 7] = clima[q + 7] - 1 }
  sino si est == 1 y azarHilo(s + k, 9320 + tt, 602 + diaN % 97) < 0.08 {
    clima[q + 7] = 3
    clima[q + 8] = 1
    sumarAtomico(cuenta, k * 48 + 34, 1)
  }
  # desastre
  clima[q + 9] = 0
  fijo pDes = 0.004 * (1.0 + (10000 - bo) / 5000.0)
  si azarHilo(s + k, 9330 + tt, 603 + diaN % 97) < pDes {
    clima[q + 9] = 1
    clima[q + 10] = 1
    sumarAtomico(cuenta, k * 48 + 35, 1)
    terrP[q + 1] = maximo(0, terrP[q + 1] - 40)
  }
}

# El desastre en las personas: una de cada tres sale herida, y la casa pierde un nivel.
publico fn sufrirDesastre(h: entero, vivo, cuerpo, civil, clima, s: entero, t: entero, nAg: entero, nTerr: entero) {
  si vivo[h] == 1 {
    fijo k = h // nAg
    fijo p = h * 16
    si clima[(k * nTerr + civil[p]) * 16 + 9] > 0 {
      si azarHilo(s + k, h % nAg, 610 + t // 600 % 97) < 0.33 { cuerpo[p + 7] = maximo(0, cuerpo[p + 7] - 3000) }
      si cuerpo[p + 13] > 0 { cuerpo[p + 13] = cuerpo[p + 13] - 1 }
    }
  }
}
