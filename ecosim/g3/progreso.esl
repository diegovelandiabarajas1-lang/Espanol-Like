# ECOSIM-G v3.1 · EL PROGRESO: sueldos, emprendedores, investigación y riqueza
#
# Por qué existe este módulo. Con la v3 todos los mundos acababan igual: la
# tecnología apenas pasaba de 100, casi nadie fundaba empresas, los ricos seguían
# ricos y los pobres pobres, y el comercio no se movía. El diagnóstico (un mundo,
# año por año) fue:
#   · todos cobraban el mismo salario, y el salario de un año era una veintena
#     de lo que una persona tenía ahorrado: nadie podía ascender ahorrando;
#   · las empresas guardaban el 60 % de todo el dinero en su caja y no lo
#     soltaban: el dinero de las personas bajaba año tras año;
#   · las personas no podían ser dueñas de nada: solo los 100 inversores y los
#     clubes fundaban, y las plazas de las empresas cerradas no se volvían a usar;
#   · la tecnología solo subía por la ciencia del Estado, una o dos veces en
#     seis años, y no se contagiaba de un Estado a otro.
#
# El dinero se sigue conservando al centavo (la idea de Diego): la riqueza nueva
# sale de producir más con la misma gente (tecnología), de las casas, las
# máquinas y las empresas que se construyen, y del crédito de los bancos, que crea
# depósitos contra préstamos dentro de las invariantes de la v2.
#
# Lo nuevo (el número de mecánica al que mejora, entre corchetes):
#   [16][22] SUELDO POR EMPRESA Y POR PERSONA: cada empresa tiene su sueldo y cada
#        persona su rendimiento (energía, salud, oficio, estudios). Se cobra
#        sueldo × rendimiento / 80: estudiar y aprender el oficio paga.
#   [16][25] PRIMA: la empresa con más de 30 nóminas en caja reparte cada año el
#        5 % de lo que le sobra entre su plantilla, según el rendimiento.
#   [21] MERCADO DE TRABAJO CON SUELDOS: la empresa con caja de sobra sube el
#        sueldo; la que pierde, lo baja. El que busca trabajo prefiere la que
#        paga más entre las que necesitan manos, y el que trabaja se cambia si
#        otra le paga un 10 % más. Cada año: con ganancias y más de 12 nóminas en
#        caja, sube del 1 % al 8 % según lo que gana por cada peso de nómina; sin
#        ganancias pero con más de 40 nóminas, un 3 %; con pérdidas y menos de 4
#        nóminas, baja un 4 %. La empresa nueva paga el sueldo medio del mercado.
#   [39][40][44] EMPRENDEDORES: una persona creativa o curiosa con ahorros funda
#        su empresa (con un préstamo del banco si le falta) en su territorio, la
#        dirige, se lleva la mitad de la ganancia, la hereda su familia o la
#        pierde si quiebra. Las plazas de las empresas cerradas se reutilizan.
#   [78][79][88] INVESTIGACIÓN: la empresa con caja de sobra (más de 16 nóminas)
#        paga cada año el 2 % de lo que le sobra a una tecnológica; con suerte (más
#        si su Estado tiene ciencia, y más si ella misma es tecnológica) mejora un
#        12 % su productividad, y le deja 2 puntos de tecnología a su Estado.
#   [78] DIFUSIÓN: cada Estado aprende cada año un 5 % de lo que le saca de
#        ventaja el más avanzado de los demás (1 % si son enemigos).
#   [16][17] RIQUEZA = dinero + lo que vale la empresa propia + la parte del club:
#        así la desigualdad y la movilidad cuentan a los emprendedores.
#
# Nuevas casillas en «cuenta» (k·48): 39 fundadas por personas · 40 quiebras de
# empresas de personas · 41 créditos a emprendedores · 42 innovaciones de empresas
# · 43 empresas heredadas · 44 cambios de trabajo por sueldo.
# En «medida» (k·20): 17 unidades vendidas el último año · 18 las del segundo año ·
# 19 sueldo medio (centavos por hora, ponderado por plantilla).
# En «estado» (kf·24): 23 foto de la tecnología (para la difusión).

# ── el sueldo de cada empresa, una vez al año, después de cerrar la hora
publico fn ajustarSueldo(h: entero, activa, sueldo, caja, trab, ganHora, salario: entero) {
  si activa[h] == 1 {
    fijo n = maximo(1, trab[h])
    fijo su = sueldo[h]
    fijo nom = n * 1.0 * su                      # en reales: n × sueldo × 40 no cabe en 32 bits
    var nuevo = su
    si ganHora[h] > 0 y caja[h] > nom * 12 {
      # sube más cuanto más gana por cada peso de nómina (1 % a 8 %)
      fijo margen = ganHora[h] / nom
      nuevo = su * (101 + minimo(7, entero(margen * 10))) // 100
    }
    sino si caja[h] > nom * 40 { nuevo = su * 103 // 100 }
    sino si ganHora[h] < 0 y caja[h] < nom * 4 { nuevo = su * 96 // 100 }
    sueldo[h] = minimo(salario * 50, maximo(salario // 2, nuevo))
  }
}

# ── el dueño se lleva la mitad de la ganancia del año, si la caja deja 6 nóminas
publico fn pagarDueno(h: entero, activa, dueno, caja, ganHora, trab, sueldo, saldo) {
  si activa[h] == 1 y dueno[h] >= 0 y ganHora[h] > 0 {
    fijo reserva = maximo(1, trab[h]) * 1.0 * sueldo[h] * 6
    var r = ganHora[h] // 2
    si r > caja[h] - reserva { r = entero(maximo(0.0, caja[h] - reserva)) }
    si r > 0 {
      caja[h] = caja[h] - r
      sumarAtomico(saldo, dueno[h], r)
    }
  }
}

# ── investigación: decide con la foto de la caja (cajaF), porque a una tecnológica
# le pueden estar pagando otras en esta misma fase
publico fn investigar(h: entero, activa, sector, caja, cajaF, ganHora, trab, sueldo, tecE, terrEmp, terrP, estado, ingresosHora, cuenta, lista, iniSec, s: entero, t: entero, nEmp: entero, nTerr: entero, nFac: entero, nSector: entero) {
  si activa[h] == 1 {
    fijo k = h // nEmp
    fijo reserva = maximo(1, trab[h]) * 1.0 * sueldo[h] * 8
    si cajaF[h] > reserva * 2 {
      fijo gasto = entero((cajaF[h] - reserva) / 50)
      var te = -1
      fijo i0 = iniSec[k * (nSector + 1) + 2]
      fijo ns = iniSec[k * (nSector + 1) + 3] - i0
      si ns > 0 {
        para intento en rango(4) {
          fijo e2 = k * nEmp + lista[k * nEmp + i0 + minimo(ns - 1, entero(piso(azarHilo(s + k, 7000 + h % nEmp, 130 + intento + t // 3600 % 7) * ns)))]
          si te < 0 y e2 != h y activa[e2] == 1 y sector[e2] == 2 { te = e2 }
        }
      }
      si te >= 0 y gasto > 0 {
        sumarAtomico(caja, h, 0 - gasto)
        sumarAtomico(caja, te, gasto)
        sumarAtomico(ingresosHora, te, gasto)
        fijo r = (k * nFac + terrP[(k * nTerr + terrEmp[h]) * 16]) * 24
        fijo cie = estado[r + 15]
        var p = 0.2 + 0.4 * cie / (cie + 20000.0)
        si sector[h] == 2 { p = p + 0.15 }
        si azarHilo(s + k, 7100 + h % nEmp, 140 + t // 3600 % 97) < p {
          tecE[h] = minimo(2000, tecE[h] + tecE[h] * 12 // 100)
          sumarAtomico(estado, r + 14, 2)
          sumarAtomico(cuenta, k * 48 + 42, 1)
        }
      }
    }
  }
}

# ── emprender: un hilo por economía, en orden (cuatro fundaciones por año como mucho)
# El candidato: adulto de 22 a 59 años, libre, sin empresa, con al menos 20
# sueldos base ahorrados y ganas (creatividad, curiosidad y carisma). Pone la mitad
# de su dinero; si no llega al capital mínimo (40 sueldos base), el banco le presta
# hasta el doble de lo que pone, si tiene cupo. El sector: el de más ganancia por
# empresa, o (3 de cada 10 veces) uno al azar: un nicho nuevo.
publico fn emprender(k: entero, vivo, saldo, cuerpo, civil, rasgo, empresaDe, empleo, activa, nacida, precioAcc, caja, deudaEmp, prestamos, cupo, sector, ganHora, tenencia, accVivas, fundadaPor, dueno, cuenta, fundadas, t: entero, s: entero, nAg: entero, nEmp: entero, nBanco: entero, nSector: entero, ten: entero, acc: entero, salario: entero, credito: entero) {
  var hechas = 0
  fijo inicio = (t // 3600 * 37) % nAg
  para j en rango(nAg) {
    fijo i = (inicio + j) % nAg
    fijo h = k * nAg + i
    fijo p = h * 16
    si hechas < 4 y vivo[h] == 1 y empresaDe[h] < 0 y cuerpo[p] >= 22 y cuerpo[p] < 60 y cuerpo[p + 14] == 0 y saldo[h] >= salario * 20 {
      fijo ganas = (rasgo[p + 5] + rasgo[p + 6]) // 2 + rasgo[p] // 4
      si ganas > 50 y azarHilo(s + k, i, 150 + t // 3600 % 97) < (ganas - 50) * 0.002 {
        var hueco = -1
        para e en rango(nEmp) {
          fijo ke = k * nEmp + e
          si hueco < 0 y activa[ke] == 0 y precioAcc[ke] == 0 { hueco = ke }
        }
        si hueco >= 0 {
          fijo aporte = minimo(saldo[h] // 2, salario * 200)
          fijo capital = salario * 40
          var prestamo = 0
          fijo kb = k * nBanco + (hueco % nEmp) % nBanco
          si aporte < capital y credito == 1 {
            prestamo = minimo(capital - aporte, aporte * 2)
            si cupo[kb] < prestamo { prestamo = 0 }
          }
          si aporte + prestamo >= capital {
            var mejorS = -1
            var mejorG = 0
            para sec en rango(nSector) {
              var g = 0
              var n = 0
              para e en rango(nEmp) {
                fijo ke = k * nEmp + e
                si activa[ke] == 1 y sector[ke] == sec {
                  g = g + ganHora[ke]
                  n = n + 1
                }
              }
              var media = 1000000000
              si n > 0 { media = g // n }
              si mejorS < 0 o media > mejorG {
                mejorG = media
                mejorS = sec
              }
            }
            si azarHilo(s + k, i, 151 + t // 3600 % 97) < 0.3 {
              mejorS = entero(piso(azarHilo(s + k, i, 152 + t // 3600 % 97) * nSector))
            }
            saldo[h] = saldo[h] - aporte
            caja[hueco] = caja[hueco] + aporte + prestamo
            si prestamo > 0 {
              deudaEmp[hueco] = deudaEmp[hueco] + prestamo
              prestamos[kb] = prestamos[kb] + prestamo
              cupo[kb] = cupo[kb] - prestamo
              cuenta[k * 48 + 41] = cuenta[k * 48 + 41] + 1
            }
            tenencia[hueco * ten] = acc
            activa[hueco] = 1
            sector[hueco] = mejorS
            nacida[hueco] = t
            precioAcc[hueco] = maximo(1, (aporte + prestamo) // acc)
            fundadaPor[hueco] = 3
            dueno[hueco] = h
            empresaDe[h] = hueco
            empleo[h] = hueco % nEmp
            fundadas[k] = fundadas[k] + 1
            accVivas[k] = accVivas[k] + acc
            cuenta[k * 48 + 39] = cuenta[k * 48 + 39] + 1
            hechas = hechas + 1
          }
        }
      }
    }
  }
}

# ── lo que «nacer» no sabe de la v3.1: el sueldo y la productividad de la empresa
# nueva, y que la de una persona abre en el territorio de su dueño
publico fn nacerDePersona(h: entero, activa, nacida, fundadaPor, dueno, civil, terrEmp, sueldo, tecE, ganHora, precioAcc, precioAccH, medida, t: entero, salario: entero, nEmp: entero) {
  si activa[h] == 1 y nacida[h] == t y t > 0 {
    sueldo[h] = maximo(salario, medida[(h // nEmp) * 20 + 19])
    tecE[h] = 100
    ganHora[h] = 0
    precioAccH[h] = precioAcc[h]
    si fundadaPor[h] == 3 y dueno[h] >= 0 { terrEmp[h] = civil[dueno[h] * 16] }
  }
}

# ── la empresa del que murió: la hereda quien heredó su dinero (heredar lo dejó en
# pedido[10], más uno), si vive y no tiene ya una; si no, se queda sin dueño.
# Un hilo por economía, en orden.
publico fn heredarEmpresas(k: entero, vivo, pedido, dueno, empresaDe, cuenta, nAg: entero, nEmp: entero) {
  para e en rango(nEmp) {
    fijo ke = k * nEmp + e
    fijo o = dueno[ke]
    si o >= 0 {
      si vivo[o] != 1 {
        fijo he = pedido[o * 16 + 10] - 1
        dueno[ke] = -1
        empresaDe[o] = -1
        si he >= 0 {
          si vivo[he] == 1 y empresaDe[he] < 0 {
            dueno[ke] = he
            empresaDe[he] = ke
            cuenta[k * 48 + 43] = cuenta[k * 48 + 43] + 1
          }
        }
      }
    }
  }
}

# ── la riqueza de cada persona: su dinero, lo que vale su empresa (caja − deuda) y
# su parte del club. En reales para que no se desborde el entero de 32 bits.
publico fn valorar(h: entero, vivo, saldo, empresaDe, caja, deudaEmp, clubDe, partic, valorPart, riqueza) {
  var r = saldo[h] * 1.0
  si vivo[h] == 1 {
    fijo e = empresaDe[h]
    si e >= 0 { r = r + maximo(0, caja[e] - deudaEmp[e]) * 1.0 }
    fijo c = clubDe[h]
    si c >= 0 { r = r + partic[h] * 1.0 * valorPart[c] }
  }
  riqueza[h] = entero(minimo(2000000000.0, maximo(0.0, r)))
}

# ── lo que se vendió en el año (unidades: la producción real) y el sueldo medio.
# Va antes de cerrar la hora, que pone las ventas a cero.
publico fn medirPib(k: entero, activa, ventasHora, sueldo, trab, medida, t: entero, nEmp: entero) {
  var u = 0
  var sumS = 0.0
  var n = 0
  para e en rango(nEmp) {
    fijo ke = k * nEmp + e
    si activa[ke] == 1 {
      u = u + ventasHora[ke]
      sumS = sumS + sueldo[ke] * 1.0 * trab[ke]
      n = n + trab[ke]
    }
  }
  medida[k * 20 + 17] = u
  si t // 3600 == 1 { medida[k * 20 + 18] = maximo(1, u) }      # la base: el segundo año (en el primero se llenan las despensas)
  si n > 0 { medida[k * 20 + 19] = entero(sumS / n) }
}

# ── la lista de empresas abiertas, por sector (una vez al año, después de fundar y
# quebrar). Con 90 plazas y la mitad vacías, buscar al azar entre las 90 dejaba a
# la gente sin encontrar dónde comprar comida: ahora se busca entre las abiertas
# del sector que se necesita. lista (k·nEmp): índices de empresa, ordenados por
# sector; iniSec (k·(nSector+1)): dónde empieza cada sector (el último, el total).
publico fn listar(k: entero, activa, sector, lista, iniSec, nEmp: entero, nSector: entero) {
  fijo b = k * (nSector + 1)
  var n = 0
  para sec en rango(nSector) {
    iniSec[b + sec] = n
    para e en rango(nEmp) {
      fijo ke = k * nEmp + e
      si activa[ke] == 1 y sector[ke] == sec {
        lista[k * nEmp + n] = e
        n = n + 1
      }
    }
  }
  iniSec[b + nSector] = n
}

publico fn copiarTec(h: entero, estado) { estado[h * 24 + 23] = estado[h * 24 + 14] }

publico fn llenar(h: entero, a, v: entero) { a[h] = v }
