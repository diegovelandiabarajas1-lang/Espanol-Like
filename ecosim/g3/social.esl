# ECOSIM-G v3 · LO SOCIAL (mecánicas 31–45) y el censo que lo alimenta
#
# Cada hora, en este orden: se ponen a cero los contadores, el CENSO cuenta a todos
# (por territorio, facción, religión y economía) y saca la FOTO de lo que los demás
# leerán (saldo, moral, facción…), las ESTADÍSTICAS de cada economía sacan de ahí
# la desigualdad, los quintiles, las mayorías y la cohesión, y después cada persona
# decide mirando la foto, no a los demás mientras cambian: así una corrida sale
# igual al bit en la CPU y en la GPU.
#
# Índices: persona p = h·16 · territorio kt (paquetes kt·16) · facción kf (estado
# kf·24, censoF kf·16) · religión kr (relig kr·4) · economía k (medida k·20, cuenta
# k·48). Cada persona tiene KV vínculos con peso −100..100: positivo es amistad
# [35], negativo enemistad [36]. La tabla de casillas está en ecosim-g3.esl.

publico fn ceroT(h: entero, censoT, lengT, relT, rebFacT, nLeng: entero, nRel: entero, nFac: entero) {
  para j en rango(16) { censoT[h * 16 + j] = 0 }
  para j en rango(nLeng) { lengT[h * nLeng + j] = 0 }
  para j en rango(nRel) { relT[h * nRel + j] = 0 }
  para j en rango(nFac) { rebFacT[h * nFac + j] = 0 }
}
publico fn ceroF(h: entero, censoF) { para j en rango(16) { censoF[h * 16 + j] = 0 } }
publico fn ceroE(k: entero, medida, histo, nCub: entero) {
  medida[k * 20] = 0
  medida[k * 20 + 1] = 0
  medida[k * 20 + 2] = 0
  para j en rango(5) { medida[k * 20 + 8 + j] = 0 }
  medida[k * 20 + 13] = 0
  para j en rango(nCub) { histo[k * nCub + j] = 0 }
}

# ── el censo, un hilo por persona
publico fn censar(h: entero, vivo, saldo, empleo, cuerpo, civil, animo, rasgo, memo, foto, sector, censoT, lengT, relT, rebFacT, terrP, censoF, relig, rumorE, histo, medida, nAg: entero, nTerr: entero, nFac: entero, nRel: entero, nLeng: entero, nEmp: entero, nCub: entero) {
  fijo p = h * 16
  # la foto: lo que los demás leerán de esta persona durante la hora
  foto[p] = saldo[h]
  foto[p + 1] = civil[p]
  foto[p + 2] = animo[p]
  foto[p + 3] = civil[p + 6]
  foto[p + 4] = civil[p + 5]
  foto[p + 5] = animo[p + 8]
  foto[p + 6] = animo[p + 11]
  foto[p + 7] = memo[p + 3]
  foto[p + 8] = civil[p + 3]
  foto[p + 9] = civil[p + 4]
  si vivo[h] == 1 {
    fijo k = h // nAg
    fijo kt = k * nTerr + civil[p]
    fijo q = kt * 16
    fijo f = terrP[q]
    fijo kf = k * nFac + f
    fijo w = kf * 16
    fijo ed = cuerpo[p]
    sumarAtomico(censoT, q, 1)
    sumarAtomico(censoF, w, 1)
    sumarAtomico(medida, k * 20, 1)
    sumarAtomico(medida, k * 20 + 1, ed)
    sumarAtomico(censoT, q + 3, animo[p + 10])
    sumarAtomico(censoT, q + 5, rasgo[p + 4])
    sumarAtomico(lengT, kt * nLeng + civil[p + 3], 1)
    fijo rel = civil[p + 5]
    si rel >= 0 {
      sumarAtomico(relT, kt * nRel + rel, 1)
      sumarAtomico(relig, (k * nRel + rel) * 4, 1)
    }
    si cuerpo[p + 10] > 0 {
      sumarAtomico(censoT, q + 1, 1)
      sumarAtomico(medida, k * 20 + 8, 1)
    }
    si cuerpo[p + 15] == 1 {
      sumarAtomico(censoT, q + 2, 1)
      sumarAtomico(rebFacT, kt * nFac + civil[p + 6], 1)
      sumarAtomico(medida, k * 20 + 10, 1)
    }
    si animo[p + 12] == 1 {
      sumarAtomico(censoT, q + 4, 1)
      sumarAtomico(medida, k * 20 + 9, 1)
    }
    si cuerpo[p + 14] > 0 { sumarAtomico(medida, k * 20 + 11, 1) }
    si ed < 16 { sumarAtomico(censoF, w + 3, 1) }
    fijo ro = civil[p + 10]
    si ed >= 16 y ed < 65 {
      sumarAtomico(censoT, q + 7, 1)
      si empleo[h] < 0 y ro == 0 y cuerpo[p + 14] == 0 { sumarAtomico(censoT, q + 6, 1) }
    }
    si civil[p + 1] == 1 {
      sumarAtomico(censoF, w + 1, 1)
      si civil[p + 6] == f { sumarAtomico(censoF, w + 2, 1) }     # [61] ciudadanos que son de la facción que gobierna
    }
    si ro > 0 {
      sumarAtomico(censoF, w + 12, 1)
      sumarAtomico(censoF, w + 3 + ro, 1)        # 4 policías · 5 maestros · 6 médicos · 7 soldados · 8 espías
    }
    # [79] quien hace ciencia: estudios y trabajo en tecnología, o maestro o médico
    fijo e = empleo[h]
    si civil[p + 7] >= 4000 {
      si e >= 0 { si sector[k * nEmp + e] == 2 { sumarAtomico(censoF, w + 9, 1) } }
      si ro == 2 o ro == 3 { sumarAtomico(censoF, w + 9, 1) }       # maestros y médicos también estudian
    }
    sumarAtomico(censoF, w + 10, rasgo[p + 5])
    sumarAtomico(censoF, w + 11, rasgo[p + 4])
    # [85] los mayores que cuentan lo que saben
    si ed >= 50 y civil[p + 7] > 3000 { sumarAtomico(censoT, q + 8, 1) }
    # [37] cuántos creen el rumor sobre cada empresa
    fijo re = memo[p + 3]
    si re >= 0 { sumarAtomico(rumorE, k * nEmp + re, 1) }
    # [16] la riqueza, en cubetas logarítmicas (para quintiles y desigualdad)
    fijo sal = saldo[h]
    var b = 0
    si sal > 0 { b = entero(piso(log(1.0 + sal) * 4.0)) }
    si b >= nCub { b = nCub - 1 }
    sumarAtomico(histo, k * nCub + b, 1)
    sumarAtomico(medida, k * 20 + 2, sal // 100)
  }
}

# ── las estadísticas de cada economía, un hilo por economía
# [17] desigualdad: el índice de Hoover (la fracción de la riqueza que habría que
#      mover para que todos tuvieran lo mismo) y la parte del 10 % más rico.
# [19] precios: el IPC de agua y comida, y la inflación de la hora.
# [42] cohesión de cada territorio; [41] mayorías de lengua y religión (de ahí la
#      exclusión); el atractivo de cada territorio para migrar [71].
# [84] la moda: un producto de ocio o de lujo que todos quieren, hasta que deja
#      de ser distinto y aparece otra.
publico fn estadisticas(k: entero, vivo, saldo, medida, histo, qB, censoT, terrP, lengT, relT, activa, sector, precio, cuenta, s: entero, t: entero, nAg: entero, nTerr: entero, nLeng: entero, nRel: entero, nEmp: entero, nCub: entero) {
  fijo md = k * 20
  fijo n = medida[md]
  # quintiles por cubetas
  var acum = 0
  var qq = 0
  para b en rango(nCub) {
    acum = acum + histo[k * nCub + b]
    mientras qq < 4 y acum * 5 >= n * (qq + 1) {
      qB[k * 4 + qq] = b
      qq = qq + 1
    }
  }
  # el umbral del 10 % más rico
  var arriba = 0
  var bTop = nCub - 1
  mientras bTop > 0 y (arriba + histo[k * nCub + bTop]) * 10 <= n {
    arriba = arriba + histo[k * nCub + bTop]
    bTop = bTop - 1
  }
  # Hoover y la parte del 10 % (en monedas para no desbordar)
  fijo total = medida[md + 2]
  var media = 0
  si n > 0 { media = entero(total // n) }
  var desv = 0
  var deTop = 0
  fijo base = k * nAg
  para i en rango(nAg) {
    fijo h = base + i
    si vivo[h] == 1 {
      fijo x = saldo[h] // 100
      desv = desv + absoluto(x - media)
      var b = 0
      si saldo[h] > 0 { b = entero(piso(log(1.0 + saldo[h]) * 4.0)) }
      si b > bTop { deTop = entero(deTop + x) }
    }
  }
  si total > 0 {
    medida[md + 3] = desv * 5000 // total
    medida[md + 4] = deTop * 10000 // total
  }
  # territorios
  para tt en rango(nTerr) {
    fijo kt = k * nTerr + tt
    fijo q = kt * 16
    fijo pob = censoT[q]
    var ml = 0
    var mlN = -1
    para j en rango(nLeng) {
      si lengT[kt * nLeng + j] > mlN {
        mlN = lengT[kt * nLeng + j]
        ml = j
      }
    }
    terrP[q + 12] = ml
    var mr = -1
    var mrN = 0
    para j en rango(nRel) {
      si relT[kt * nRel + j] > mrN {
        mrN = relT[kt * nRel + j]
        mr = j
      }
    }
    terrP[q + 13] = mr
    terrP[q + 7] = terrP[q + 6]                        # delitos de la hora → de la hora pasada
    terrP[q + 6] = 0
    terrP[q + 9] = terrP[q + 9] * 8 // 10 + terrP[q + 8] * 100     # el arte que queda
    terrP[q + 8] = 0
    terrP[q + 11] = terrP[q + 10] // 6                 # rituales por día
    terrP[q + 10] = 0
    si pob > 0 {
      fijo ad = maximo(1, censoT[q + 7])
      fijo empleoR = (ad - censoT[q + 6]) * 10000 // ad
      fijo seguridad = maximo(0, 10000 - terrP[q + 7] * 100000 // pob)
      var paz = 10000
      si terrP[q + 4] > 0 { paz = 0 }
      terrP[q + 14] = (empleoR * 4 + seguridad * 3 + paz * 3) // 10
      fijo conf = censoT[q + 3] // pob
      fijo incl = (pob - censoT[q + 4]) * 10000 // pob
      fijo rit = minimo(10000, terrP[q + 11] * 10000 // pob)
      terrP[q + 15] = (conf * 4 + incl * 3 + rit * 2 + seguridad) // 10
    }
  }
  # IPC de agua y comida (media de precios de las activas)
  var sp = 0
  var np = 0
  para e en rango(nEmp) {
    fijo ke = k * nEmp + e
    si activa[ke] == 1 y sector[ke] <= 1 {
      sp = sp + precio[ke]
      np = np + 1
    }
  }
  si np > 0 {
    fijo nuevo = sp // np
    fijo viejo = medida[md + 5]
    si viejo > 0 { medida[md + 6] = (nuevo - viejo) * 10000 // viejo }
    medida[md + 5] = nuevo
  }
  # la moda: cambia si su empresa cerró, o cada año con probabilidad 1/4
  fijo me = medida[md + 7]
  var cambia = 0
  si me < 0 { cambia = 1 } sino si activa[k * nEmp + me] == 0 { cambia = 1 }
  si azarHilo(s + k, 8000, 300 + t // 3600 % 19) < 0.25 { cambia = 1 }
  si cambia == 1 {
    var intento = 0
    var nueva = -1
    mientras intento < 12 y nueva < 0 {
      fijo e = entero(piso(azarHilo(s + k, 8001 + intento, 301 + t // 3600 % 19) * nEmp))
      si activa[k * nEmp + e] == 1 y sector[k * nEmp + e] >= 3 { nueva = e }
      intento = intento + 1
    }
    si nueva >= 0 y nueva != me {
      medida[md + 7] = nueva
      cuenta[k * 48 + 38] = cuenta[k * 48 + 38] + 1
    }
  }
  # los extremos de la población y de la epidemia
  si medida[md] > medida[md + 14] { medida[md + 14] = medida[md] }
  si medida[md] < medida[md + 15] { medida[md + 15] = medida[md] }
  si medida[md + 8] > medida[md + 16] { medida[md + 16] = medida[md + 8] }
}

# ── [40] movilidad social: el quintil de cada uno, y si cambió desde el principio
publico fn cuantil(h: entero, vivo, saldo, civil, qB, medida, nAg: entero) {
  si vivo[h] == 1 {
    fijo k = h // nAg
    fijo p = h * 16
    var b = 0
    si saldo[h] > 0 { b = entero(piso(log(1.0 + saldo[h]) * 4.0)) }
    var qq = 0
    mientras qq < 4 y b > qB[k * 4 + qq] { qq = qq + 1 }
    civil[p + 14] = qq
    si civil[p + 15] == -2 { civil[p + 15] = qq }
    si civil[p + 15] >= 0 {
      sumarAtomico(medida, k * 20 + 13, 1)
      si qq != civil[p + 15] { sumarAtomico(medida, k * 20 + 12, 1) }
    }
  }
}

# ── [35] amistad y [36] enemistad
# Cada hora la persona conoce a alguien (un vecino o un compañero de trabajo). Si
# comparten una lengua [76] se mide la afinidad: la empatía [51] acerca; la misma
# religión [81] y la misma facción [43] acercan; la religión distinta aleja a los
# tradicionalistas [54]; una moral muy distinta aleja; si sus territorios están en
# guerra [65], aleja mucho. Afinidad alta suma amistad; muy baja, enemistad. Los
# vínculos se gastan solos un punto por año.
publico fn vincular(h: entero, vivo, empleo, civil, rasgo, foto, vinculo, peso, terrP, guerraFF, s: entero, t: entero, nAg: entero, nTerr: entero, nFac: entero, kv: entero) {
  si vivo[h] == 1 {
    fijo k = h // nAg
    fijo base = k * nAg
    fijo p = h * 16
    para j en rango(kv) {
      fijo x = h * kv + j
      fijo o = vinculo[x]
      si o >= 0 {
        si vivo[o] != 1 {
          vinculo[x] = -1
          peso[x] = 0
        } sino {
          var w = peso[x]
          si w > 0 { w = w - 1 } sino si w < 0 { w = w + 1 }
          peso[x] = w
          si w == 0 { vinculo[x] = -1 }
        }
      }
    }
    var cand = -1
    var intento = 0
    mientras intento < 3 y cand < 0 {
      fijo o = base + entero(piso(azarHilo(s + k, h % nAg, 310 + intento + t // 3600 % 13) * nAg))
      si o != h y vivo[o] == 1 {
        si civil[o * 16] == civil[p] o (empleo[o] >= 0 y empleo[o] == empleo[h]) { cand = o }
      }
      intento = intento + 1
    }
    si cand >= 0 {
      fijo pc = cand * 16
      var habla = 0
      si foto[pc + 8] == foto[p + 8] o foto[pc + 8] == foto[p + 9] { habla = 1 }
      si foto[pc + 9] >= 0 y foto[pc + 9] == foto[p + 8] { habla = 1 }
      si habla == 1 {
        var af = rasgo[p + 1] * 30
        si foto[pc + 4] == foto[p + 4] { af = af + 1500 } sino { af = af - rasgo[p + 4] * 20 }
        si foto[pc + 3] == foto[p + 3] { af = af + 1000 }
        fijo fa = terrP[(k * nTerr + civil[p]) * 16]
        fijo fb = terrP[(k * nTerr + civil[pc]) * 16]
        si fa != fb y guerraFF[(k * nFac + fa) * nFac + fb] > 0 { af = af - 4000 }
        af = af - absoluto(foto[pc + 2] - foto[p + 2]) // 4
        af = af + entero(piso(azarHilo(s + k, h % nAg, 320 + t // 3600 % 13) * 3000)) - 1500
        var delta = 0
        si af > 1500 { delta = 10 } sino si af < -1500 { delta = -10 }
        si delta > 0 { delta = 15 }
        si delta > 0 y empleo[h] >= 0 y empleo[cand] == empleo[h] { delta = 25 }   # compañeros de trabajo
        si delta != 0 {
          var slot = -1
          para j en rango(kv) { si vinculo[h * kv + j] == cand { slot = j } }
          si slot >= 0 {
            fijo x = h * kv + slot
            peso[x] = minimo(100, maximo(-100, peso[x] + delta))
          } sino {
            # un hueco; si no hay, el vínculo más débil, si es más débil que 10
            var hueco = -1
            para j en rango(kv) {
              si hueco < 0 y vinculo[h * kv + j] < 0 { hueco = j }
            }
            si hueco < 0 {
              var debil = 10
              para j en rango(kv) {
                fijo w = absoluto(peso[h * kv + j])
                si w < debil {
                  debil = w
                  hueco = j
                }
              }
            }
            si hueco >= 0 {
              vinculo[h * kv + hueco] = cand
              peso[h * kv + hueco] = delta
            }
          }
        }
      }
    }
  }
}
