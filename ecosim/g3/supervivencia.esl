# ECOSIM-G v3 · SUPERVIVENCIA (mecánicas 1–15) y la vida y la muerte
#
# Núcleos de C1EÑ: cada función es el cuerpo de un «paralelo». No pueden llamar a
# otras funciones de Ñ ni crear objetos: todo entra como argumento y todo sale
# escrito en arreglos. El índice h es la persona (economía k = h // nAg).
#
# LOS DATOS VAN EMPAQUETADOS (la tabla completa está en ecosim-g3.esl): una persona
# tiene 16 casillas seguidas en cada paquete, así que todo empieza con
# «fijo p = h * 16» y cuerpo[p + 7] es su salud. Hay que empaquetar porque el C
# nativo de C1EÑ llama a cada núcleo por koffi, y koffi no acepta más de 64
# parámetros (cada arreglo cuenta dos).
#
# Escalas: las barras van de 0 a 10000 (como el hambre de la v2). Los rasgos de
# carácter van de 0 a 100. El dinero en centavos.
#
# EL TIEMPO: el cuerpo va por ticks (un tick = 1 segundo: el hambre, la sed, el
# sueño). La vida va más rápido: UN AÑO ES UNA HORA del reloj de la economía, y
# un día son 10 minutos (600 ticks: 400 de luz y 200 de noche). Si no, en las
# horas de una corrida nadie nacería ni envejecería.

# ── [1] hambre · [2] sed · [3] sueño · [7] higiene · [8] nutrición · [15] energía
# Cada tick. Se come y se bebe DE LA DESPENSA (lo que se compró y se guardó, [27]):
# comprar y comer son dos cosas distintas, y por eso existe el acaparamiento.
publico fn vivir(h: entero, vivo, hambre, empleo, cuerpo, civil, animo, clima, consumido, t: entero, nAg: entero, nTerr: entero, dia: entero) {
  si vivo[h] == 1 {
    fijo k = h // nAg
    fijo p = h * 16
    fijo q = (k * nTerr + civil[p]) * 16
    fijo temp = clima[q]
    var noche = 0
    si (t % dia) * 3 >= dia * 2 { noche = 1 }
    var hh = hambre[h] + 2
    var ss = cuerpo[p + 2] + 2
    si temp > 30 y t % 2 == 0 { ss = ss + 1 }                # con calor se suda
    fijo ref = cuerpo[p + 13]
    var su = cuerpo[p + 3]
    var ener = cuerpo[p + 4]
    si noche == 1 y animo[p + 1] < 8000 {
      # dormir: mejor con techo; con mucho miedo no se duerme (insomnio)
      su = su - 6 - 2 * ref
      si hh < 8000 { ener = ener + 4 + 2 * ref }
    } sino {
      su = su + 2
      si empleo[h] >= 0 y noche == 0 y cuerpo[p + 14] == 0 { ener = ener - 2 } sino { ener = ener - 1 }
    }
    var hi = cuerpo[p + 5] - t % 2
    var nu = cuerpo[p + 6] - 1
    # beber, comer y lavarse, de lo guardado
    si ss >= 4000 y cuerpo[p + 11] > 0 {
      cuerpo[p + 11] = cuerpo[p + 11] - 1
      ss = ss - 5000
      sumarAtomico(consumido, k, 1)
    }
    si hh >= 4000 y cuerpo[p + 12] > 0 {
      cuerpo[p + 12] = cuerpo[p + 12] - 1
      hh = hh - 5000
      nu = nu + 2500
      sumarAtomico(consumido, k, 1)
    }
    si hi < 2000 y cuerpo[p + 11] > 1 {
      cuerpo[p + 11] = cuerpo[p + 11] - 1
      hi = 10000
      sumarAtomico(consumido, k, 1)
    }
    hambre[h] = minimo(10000, maximo(0, hh))
    cuerpo[p + 2] = minimo(10000, maximo(0, ss))
    cuerpo[p + 3] = minimo(10000, maximo(0, su))
    cuerpo[p + 4] = minimo(10000, maximo(0, ener))
    cuerpo[p + 5] = maximo(0, hi)
    cuerpo[p + 6] = minimo(10000, maximo(0, nu))
  }
}

# ── [10] edad · [4] salud física · [6] temperatura · [9] inmunidad · [12] mortalidad infantil
# Cada año (cada hora). La muerte es la ley de Gompertz (el riesgo se duplica cada
# ~8 años) más lo que añade una salud rota, el frío sin techo, la contaminación
# [97], la enfermedad [95] y, para los soldados, la guerra [65]. Los médicos (que
# paga el Estado) bajan la mortalidad infantil y la de los enfermos.
publico fn envejecer(h: entero, vivo, hambre, empleo, cuerpo, civil, clima, terrP, estado, censoF, cuenta, s: entero, t: entero, nAg: entero, nTerr: entero, nFac: entero) {
  si vivo[h] == 1 {
    fijo k = h // nAg
    fijo p = h * 16
    fijo kt = k * nTerr + civil[p]
    fijo kf = k * nFac + terrP[kt * 16]
    fijo ed = cuerpo[p] + 1
    cuerpo[p] = ed
    # [9] la inmunidad va hacia lo que permiten la nutrición y la edad; las vacunas
    #     llegan con la tecnología
    var obj = cuerpo[p + 6] // 2 + 3000
    si ed < 5 { obj = obj - 2000 }
    si ed > 65 { obj = obj - (ed - 65) * 100 }
    si estado[kf * 24 + 14] >= 150 { obj = obj + 1500 }
    var im = cuerpo[p + 9]
    im = im + (obj - im) // 3
    cuerpo[p + 9] = minimo(10000, maximo(0, im))
    # médicos por cada mil habitantes de su facción (hasta 20)
    var med = 0
    fijo pf = censoF[kf * 16]
    si pf > 0 { med = entero(censoF[kf * 16 + 6] * 1000 // pf) }
    si med > 20 { med = 20 }
    # [4] salud
    var sa = cuerpo[p + 7]
    fijo hh = hambre[h]
    fijo ss = cuerpo[p + 2]
    si hh < 8000 y ss < 8000 y cuerpo[p + 3] < 8000 { sa = sa + 800 }
    si hh >= 9000 { sa = sa - 2500 }
    si ss >= 9000 { sa = sa - 3000 }
    si cuerpo[p + 3] >= 9000 { sa = sa - 1000 }
    # [6] el frío y el calor, peor sin techo ([13]: cada nivel de refugio protege un tercio)
    fijo temp = clima[kt * 16]
    fijo ref = cuerpo[p + 13]
    si temp < 10 { sa = sa - (10 - temp) * 150 * (3 - ref) // 3 }
    si temp > 32 { sa = sa - (temp - 32) * 150 * (3 - ref) // 3 }
    sa = sa - clima[kt * 16 + 6] // 20
    si cuerpo[p + 10] > 0 { sa = sa - 1800 + med * 50 }
    si ed > 60 { sa = sa - (ed - 60) * 40 }
    sa = minimo(10000, maximo(0, sa))
    cuerpo[p + 7] = sa
    # la muerte
    var q = 0.0004 * exp(0.085 * ed)
    si ed < 5 { q = q + 0.04 * (20 - med) / 20.0 }
    si sa < 2000 { q = q + (2000 - sa) / 4000.0 }
    si sa <= 0 { q = 1.0 }
    var enGuerra = 0
    fijo sold = censoF[kf * 16 + 7]
    si civil[p + 10] == 4 y sold > 0 {
      q = q + real(estado[kf * 24 + 20]) / real(sold)
      enGuerra = 1
    }
    si azarHilo(s + k, h % nAg, 200 + t // 3600 % 31) < q {
      vivo[h] = 2
      empleo[h] = -1
      civil[p + 10] = 0
      sumarAtomico(cuenta, k * 48 + 2, 1)
      si ed < 5 { sumarAtomico(cuenta, k * 48 + 3, 1) }
      si hh >= 9000 o ss >= 9000 { sumarAtomico(cuenta, k * 48 + 4, 1) }
      si enGuerra == 1 { sumarAtomico(cuenta, k * 48 + 5, 1) }
    }
  }
}

# ── [95] epidemias e [9] inmunidad adquirida
# El contagio depende de cuántos enfermos hay en el territorio (la hora anterior),
# de la inmunidad, de la higiene [7] y de los médicos. Una chispa al azar —una
# zoonosis— puede empezar un brote, más probable con contaminación.
publico fn contagiar(h: entero, vivo, cuerpo, civil, censoT, clima, terrP, censoF, cuenta, s: entero, t: entero, nAg: entero, nTerr: entero, nFac: entero) {
  si vivo[h] == 1 {
    fijo k = h // nAg
    fijo p = h * 16
    fijo kt = k * nTerr + civil[p]
    fijo kf = k * nFac + terrP[kt * 16]
    fijo e = cuerpo[p + 10]
    si e > 0 {
      cuerpo[p + 10] = e - 1
      si e == 1 { cuerpo[p + 9] = minimo(10000, cuerpo[p + 9] + 3000) }
    } sino {
      var med = 0
      fijo pf = censoF[kf * 16]
      si pf > 0 { med = entero(censoF[kf * 16 + 6] * 1000 // pf) }
      si med > 20 { med = 20 }
      fijo p0 = censoT[kt * 16]
      var frac = 0.0
      si p0 > 0 { frac = real(censoT[kt * 16 + 1]) / real(p0) }
      var pr = 2.5 * frac * (1.0 - cuerpo[p + 9] / 12000.0) * (1.5 - cuerpo[p + 5] / 10000.0) * (1.0 - med / 40.0)
      pr = pr + 0.0005 * (1.0 + clima[kt * 16 + 6] / 2000.0)
      si azarHilo(s + k, h % nAg, 230 + t // 3600 % 29) < pr {
        cuerpo[p + 10] = 2
        sumarAtomico(cuenta, k * 48 + 6, 1)
      }
    }
  }
}

# ── [34] parentesco: la herencia. El que muere (vivo = 2) deja su despensa a la
# pareja, si no al primer hijo vivo, si no a un padre vivo. El DINERO (v3.1): el
# Estado de su territorio cobra un 10 % y el resto se reparte: la mitad a la pareja
# viva y la otra mitad, a partes iguales, entre los hijos vivos (sin hijos, todo a
# quien hereda). Así las fortunas se dividen al pasar de una generación a otra. Si
# no hay nadie, todo al Estado y la despensa se pierde. De paso borra su rastro en
# los demás (hijos, pareja, deudores, vínculos), porque su plaza la puede ocupar un
# recién nacido. Quién hereda su EMPRESA lo deja apuntado en pedido[10]
# (heredarEmpresas, en progreso.esl).
publico fn heredar(h: entero, vivo, saldo, cuerpo, civil, pedido, vinculo, peso, terrP, estado, destruido, cuenta, nAg: entero, nTerr: entero, nFac: entero, kv: entero) {
  si vivo[h] == 2 {
    fijo k = h // nAg
    fijo base = k * nAg
    fijo p = h * 16
    var heredero = -1
    fijo pj = civil[p + 13]
    var parejaViva = 0
    si pj >= 0 {
      si vivo[pj] == 1 {
        heredero = pj
        parejaViva = 1
      }
      civil[pj * 16 + 13] = -1
    }
    # cuántos hijos vivos hay, para repartir
    var nHijos = 0
    para i en rango(nAg) {
      fijo o = base + i
      si o != h y vivo[o] == 1 {
        si civil[o * 16 + 11] == h o civil[o * 16 + 12] == h { nHijos = nHijos + 1 }
      }
    }
    fijo dinero = saldo[h]
    saldo[h] = 0
    fijo rT = (k * nFac + terrP[(k * nTerr + civil[p]) * 16]) * 24
    var impuesto = 0
    var paraHijo = 0
    var paraPareja = 0
    si parejaViva == 1 o nHijos > 0 {
      impuesto = entero(dinero // 10)
      fijo resto = dinero - impuesto
      si nHijos > 0 {
        si parejaViva == 1 { paraPareja = entero(resto // 2) }
        paraHijo = entero((resto - paraPareja) // nHijos)
        paraPareja = resto - paraHijo * nHijos
      } sino { paraPareja = resto }
    }
    para i en rango(nAg) {
      fijo o = base + i
      si o != h {
        fijo po = o * 16
        si civil[po + 11] == h o civil[po + 12] == h {
          si heredero < 0 y vivo[o] == 1 { heredero = o }
          si vivo[o] == 1 y paraHijo > 0 { sumarAtomico(saldo, o, paraHijo) }
          si civil[po + 11] == h { civil[po + 11] = -1 }
          si civil[po + 12] == h { civil[po + 12] = -1 }
        }
        si pedido[po + 1] == h {
          pedido[po + 1] = -1
          pedido[po] = 0
        }
        para j en rango(kv) {
          si vinculo[o * kv + j] == h {
            vinculo[o * kv + j] = -1
            peso[o * kv + j] = 0
          }
        }
      }
    }
    fijo pa = civil[p + 11]
    fijo ma = civil[p + 12]
    si heredero < 0 y ma >= 0 { si vivo[ma] == 1 { heredero = ma } }
    si heredero < 0 y pa >= 0 { si vivo[pa] == 1 { heredero = pa } }
    pedido[p + 10] = heredero + 1                # v3.1: quién hereda la empresa (heredarEmpresas)
    fijo agua = cuerpo[p + 11]
    fijo comida = cuerpo[p + 12]
    si heredero >= 0 {
      # sin pareja ni hijos hereda un padre: todo, sin impuesto (paraPareja es 0)
      si parejaViva == 0 y nHijos == 0 { paraPareja = dinero }
      sumarAtomico(saldo, heredero, paraPareja)
      si impuesto > 0 {
        sumarAtomico(estado, rT, impuesto)
        sumarAtomico(estado, rT + 17, impuesto)
      }
      sumarAtomico(cuerpo, heredero * 16 + 11, agua)
      sumarAtomico(cuerpo, heredero * 16 + 12, comida)
      sumarAtomico(cuenta, k * 48 + 7, 1)
    } sino {
      sumarAtomico(estado, rT, dinero)
      sumarAtomico(destruido, k, agua + comida)
    }
    cuerpo[p + 11] = 0
    cuerpo[p + 12] = 0
    si pedido[p] > 0 { sumarAtomico(cuenta, k * 48 + 10, 1) }
    pedido[p] = 0
    pedido[p + 1] = -1
  }
}

# ── [11] fertilidad: parejas y nacimientos. Un hilo por economía (es secuencial:
# dos personas no pueden emparejarse con la misma, y dos niños no pueden nacer en la
# misma plaza libre). La pareja sale de un amigo de verdad [35] (peso ≥ 20), del
# otro sexo, soltero y del mismo territorio; si no hay, a veces una cita con alguien
# de edad parecida. Nace un niño si la madre tiene entre
# 16 y 45 años, pareja viva y buena salud; con estudios hay menos hijos (la
# transición demográfica). El niño hereda la lengua, la religión, la facción y,
# con ruido, el carácter de los padres, y la madre le da el 10 % de su dinero.
publico fn nacimientos(k: entero, vivo, saldo, hambre, voluntad, cuerpo, civil, animo, rasgo, vinculo, peso, cuenta, s: entero, t: entero, nAg: entero, kv: entero, salario: entero) {
  fijo base = k * nAg
  # las parejas
  para i en rango(nAg) {
    fijo h = base + i
    fijo p = h * 16
    si vivo[h] == 1 y civil[p + 13] < 0 y cuerpo[p] >= 18 y cuerpo[p] <= 55 {
      para j en rango(kv) {
        fijo o = vinculo[h * kv + j]
        si civil[p + 13] < 0 y o >= 0 y peso[h * kv + j] >= 20 {
          fijo po = o * 16
          si vivo[o] == 1 y civil[po + 13] < 0 y cuerpo[po + 1] != cuerpo[p + 1] y cuerpo[po] >= 18 y cuerpo[po] <= 55 y civil[po] == civil[p] {
            civil[p + 13] = o
            civil[po + 13] = h
            cuenta[k * 48 + 1] = cuenta[k * 48 + 1] + 1
          }
        }
      }
      # si no hay amigo que sirva, a veces se conoce a alguien (una cita): soltero,
      # del otro sexo, del mismo territorio y de edad parecida
      si civil[p + 13] < 0 y azarHilo(s + k, h % nAg, 250 + t // 3600 % 37) < 0.4 {
        fijo inicio = entero(piso(azarHilo(s + k, h % nAg, 251 + t // 3600 % 37) * nAg))
        var j = 0
        mientras j < 40 y civil[p + 13] < 0 {
          fijo o = base + (inicio + j) % nAg
          fijo po = o * 16
          si o != h y vivo[o] == 1 y civil[po + 13] < 0 y cuerpo[po + 1] != cuerpo[p + 1] y civil[po] == civil[p] y cuerpo[po] >= 18 y cuerpo[po] <= 55 y absoluto(cuerpo[po] - cuerpo[p]) <= 10 {
            civil[p + 13] = o
            civil[po + 13] = h
            cuenta[k * 48 + 1] = cuenta[k * 48 + 1] + 1
          }
          j = j + 1
        }
      }
    }
  }
  # los nacimientos: el puntero «libre» recorre las plazas vacías
  var libre = 0
  mientras libre < nAg y vivo[base + libre] != 0 { libre = libre + 1 }
  para i en rango(nAg) {
    fijo m = base + i
    fijo pm = m * 16
    si libre < nAg y vivo[m] == 1 y cuerpo[pm + 1] == 1 y cuerpo[pm] >= 16 y cuerpo[pm] <= 45 {
      fijo pj = civil[pm + 13]
      si pj >= 0 {
        si vivo[pj] == 1 y cuerpo[pm + 7] > 5000 y hambre[m] < 7000 {
          var pr = 0.32 * cuerpo[pm + 7] / 10000.0
          si saldo[m] > 20 * salario { pr = pr * 1.3 }
          si civil[pm + 7] > 7000 { pr = pr * 0.6 }
          si azarHilo(s + k, m % nAg, 260 + t // 3600 % 37) < pr {
            fijo c = base + libre
            fijo pc = c * 16
            fijo pp = pj * 16
            vivo[c] = 1
            cuerpo[pc] = 0
            cuerpo[pc + 1] = entero(piso(azarHilo(s + k, c % nAg, 261 + t // 3600 % 37) * 2))
            cuerpo[pc + 13] = cuerpo[pm + 13]        # vive en la casa de la madre
            civil[pc] = civil[pm]
            civil[pc + 1] = 1
            civil[pc + 3] = civil[pm + 3]
            civil[pc + 5] = civil[pm + 5]
            civil[pc + 6] = civil[pm + 6]
            civil[pc + 11] = pj
            civil[pc + 12] = m
            animo[pc + 8] = animo[pm + 8] // 2        # fe
            animo[pc + 6] = animo[pm + 6] // 2        # superstición
            animo[pc + 11] = animo[pm + 11]           # estatus
            # el carácter: la media de los padres más un poco de azar (−10..+10)
            fijo ruido = entero(piso(azarHilo(s + k, c % nAg, 262 + t // 3600 % 37) * 21)) - 10
            para j en rango(9) {
              var x = (rasgo[pm + j] + rasgo[pp + j]) // 2
              si j % 2 == 0 { x = x + ruido } sino { x = x - ruido }
              rasgo[pc + j] = minimo(100, maximo(0, x))
            }
            voluntad[c] = minimo(99, maximo(0, (voluntad[m] + voluntad[pj]) // 2 - ruido))
            # los primeros vínculos: la madre y el padre
            vinculo[c * kv] = m
            peso[c * kv] = 80
            vinculo[c * kv + 1] = pj
            peso[c * kv + 1] = 80
            # el dinero del niño: el 10 % de lo de la madre
            fijo regalo = saldo[m] // 10
            saldo[m] = saldo[m] - regalo
            saldo[c] = saldo[c] + regalo
            cuenta[k * 48] = cuenta[k * 48] + 1
            libre = libre + 1
            mientras libre < nAg y vivo[base + libre] != 0 { libre = libre + 1 }
          }
        }
      }
    }
  }
}
