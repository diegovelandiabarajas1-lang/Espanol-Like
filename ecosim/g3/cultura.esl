# ECOSIM-G v3 · CULTURA Y CONOCIMIENTO (mecánicas 76–90)
#
# Lo que vive en cada persona —la lengua [76], la educación [77], la superstición
# [89], el arte que hace [80], si sigue la moda [84], su religión [81] y el tabú
# que la frena al comprar [83]— está en «sentir» (psicologia.esl) y al elegir qué
# comprar (ecosim-g3.esl). Aquí está lo colectivo: los rituales de cada día, la
# ciencia, la escritura y la tecnología de cada Estado, y los mitos de cada religión.
#
# Tres religiones, y cada una tiene un tabú: la 0 no compra lujo, la 1 no compra
# ocio, la 2 no quiere tecnología (y frena la innovación si es la del Estado).
#
# relig (kr·4): 0 fieles · 1 mitos · 2 rituales del año.

# ── [82] ritual: cada día, al amanecer, el creyente va a su rito. Gasta un poco de
# energía y gana fe, salud mental y comunidad (la cohesión [42] de su territorio).
publico fn rezar(h: entero, vivo, cuerpo, civil, animo, terrP, relig, cuenta, nAg: entero, nTerr: entero, nRel: entero) {
  fijo p = h * 16
  si vivo[h] == 1 y civil[p + 5] >= 0 y animo[p + 8] > 3000 y cuerpo[p + 14] == 0 {
    fijo k = h // nAg
    cuerpo[p + 4] = maximo(0, cuerpo[p + 4] - 300)
    animo[p + 8] = minimo(10000, animo[p + 8] + 150)
    cuerpo[p + 8] = minimo(10000, cuerpo[p + 8] + 200)
    sumarAtomico(terrP, (k * nTerr + civil[p]) * 16 + 10, 1)
    sumarAtomico(relig, (k * nRel + civil[p + 5]) * 4 + 2, 1)
    sumarAtomico(cuenta, k * 48 + 20, 1)
  }
}

# ── un hilo por facción: el saber de cada Estado
# [79] ciencia: la hacen los que estudiaron y trabajan en tecnología, los maestros y
#      los médicos, más con
#      bibliotecas [87]. Sin escritura [86] se olvida un 5 % cada año (solo hay
#      tradición oral [85]).
# [86] escritura: se inventa al pasar de 2000 de ciencia; desde entonces no se olvida
#      y la burocracia [74] baja.
# [88] innovación: la probabilidad crece con la ciencia y con la creatividad [55]
#      media; cada una sube la tecnología [78] un 10 %, menos cuanto más
#      tradicionalista [54] es la población. El tabú de la religión 2 la frena.
publico fn saber(kf: entero, estado, censoF, terrP, animo, cuenta, s: entero, t: entero, nTerr: entero, nFac: entero) {
  fijo k = kf // nFac
  fijo f = kf % nFac
  fijo r = kf * 24
  fijo w = kf * 16
  var bib = 0
  para tt en rango(nTerr) {
    fijo q = (k * nTerr + tt) * 16
    si terrP[q] == f { bib = bib + terrP[q + 5] }
  }
  var cie = estado[r + 15] + censoF[w + 9] * 80 * (1 + bib)
  si estado[r + 16] == 0 { cie = cie - cie // 20 }
  estado[r + 15] = cie
  si estado[r + 16] == 0 y cie > 2000 {
    estado[r + 16] = 1
    sumarAtomico(cuenta, k * 48 + 32, 1)
  }
  fijo pf = maximo(1, censoF[w])
  fijo creatMedia = censoF[w + 10] // pf
  fijo tradMedia = censoF[w + 11] // pf
  var pr = cie / (cie + 20000.0) * creatMedia / 100.0
  fijo li = estado[r + 1]
  si estado[r + 10] == 2 y li >= 0 { si animo[li * 16 + 8] > 6000 { pr = pr / 2.0 } }
  si azarHilo(s + k, 9200 + f, 540 + t // 3600 % 19) < pr {
    fijo te = estado[r + 14]
    estado[r + 14] = minimo(400, te + te * (100 - tradMedia // 2) // 1000)
    sumarAtomico(cuenta, k * 48 + 31, 1)
  }
}

# ── [90] mitología: un hilo por economía. Los mitos de cada religión crecen con
# sus rituales y con sus fieles, y se gastan si no se escriben (la escritura de
# cualquier Estado los fija). Alimentan la fe [59] de los creyentes.
publico fn creer(k: entero, relig, estado, nRel: entero, nFac: entero) {
  var escrito = 0
  para f en rango(nFac) { si estado[(k * nFac + f) * 24 + 16] == 1 { escrito = 1 } }
  para r en rango(nRel) {
    fijo x = (k * nRel + r) * 4
    var m = relig[x + 1]
    si escrito == 1 { m = m * 97 // 100 } sino { m = m * 9 // 10 }
    m = m + relig[x + 2] // 10 + relig[x] * 5
    relig[x + 1] = m
    relig[x + 2] = 0
    relig[x] = 0
  }
}
