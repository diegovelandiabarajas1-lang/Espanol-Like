# ECOSIM-G v3 · POLÍTICA Y PODER (mecánicas 61–75), el delito y el castigo
#
# Cada economía tiene N_TERR territorios en anillo (cada uno vecino del anterior y
# del siguiente, unidos por una ruta [29]) y N_FAC facciones. Cada facción es un
# ESTADO: tiene un tesoro (dinero de verdad, en un banco, que cuenta en la base
# monetaria), un líder [44], leyes [62] que salen del carácter del líder, y
# funcionarios a los que paga: policías (rol 1), maestros (2), médicos (3),
# soldados (4) y espías (5). El dueño de un territorio [69] es la facción que lo
# gobierna; quien vive allí es ciudadano [72] de ese Estado si nació allí o se
# naturalizó.
#
# estado (kf·24): 0 tesoro · 1 líder · 2 autoridad · 3 impuesto % · 4 años de cárcel
#   · 5 antimonopolio · 6 libertad de culto · 7 frontera abierta · 8 subsidio ·
#   9 policías por mil · 10 religión del Estado · 11 años para naturalizarse ·
#   12 burocracia % · 13 corrupción · 14 tecnología (100 = 1×) · 15 ciencia ·
#   16 escritura · 17 recaudado esta hora · 18 escándalos · 19 en guerra · 20 bajas
# censoF (kf·16): 0 población · 1 ciudadanos · 2 apoyan al gobierno · 3 niños ·
#   4 policías · 5 maestros · 6 médicos · 7 soldados · 8 espías · 9 científicos ·
#   10 suma de creatividad · 11 suma de tradicionalismo · 12 funcionarios
# terrP (kt·16): 0 dueño · 1 ruta a tt+1 · 2 saqueo % · 3 victoria rebelde ·
#   4 frente de guerra · 5 biblioteca · 6 delitos de la hora · 7 de la hora pasada
# cuenta (k·48): 14 robos · 15 castigados · 21 guerras · 22 conquistas ·
#   23 rebeliones · 24 revoluciones · 25 espionajes · 26 corrupción (monedas) ·
#   27 escándalos · 28 obras · 29 bibliotecas · 30 subsidios

# ── [14] seguridad física y [63] castigo: el robo, en dos pasos más
# (el primero, decidir y elegir víctima, lo hace «sentir»).
# Paso 2, la víctima: pierde una décima parte de lo suyo (una vigésima si vive en
# una casa buena [13]) repartida entre todos los que le robaron; a veces con
# violencia. Cuenta como delito en su territorio.
publico fn robarVictima(h: entero, vivo, saldo, cuerpo, animo, pedido, civil, terrP, cuenta, s: entero, t: entero, nAg: entero, nTerr: entero) {
  fijo p = h * 16
  pedido[p + 8] = 0
  fijo n = pedido[p + 7]
  si vivo[h] == 1 y n > 0 {
    fijo k = h // nAg
    var parte = saldo[h] // 10
    si cuerpo[p + 13] >= 2 { parte = saldo[h] // 20 }
    fijo cada = parte // n
    pedido[p + 8] = cada
    saldo[h] = saldo[h] - cada * n
    animo[p + 1] = minimo(10000, animo[p + 1] + 1500)
    animo[p + 10] = maximo(0, animo[p + 10] - 1000)
    si azarHilo(s + k, h % nAg, 500 + t // 3600 % 11) < 0.2 { cuerpo[p + 7] = maximo(0, cuerpo[p + 7] - 800) }
    sumarAtomico(terrP, (k * nTerr + civil[p]) * 16 + 6, n)
    sumarAtomico(cuenta, k * 48 + 14, n)
  }
  pedido[p + 7] = 0
}
# Paso 3, el ladrón: la policía de su territorio lo atrapa con una probabilidad
# que sube con los policías por habitante, baja con la burocracia [74] y con la
# corrupción [73]. Atrapado: lo robado vuelve a la víctima, va preso los años que
# dice la ley [62] y pierde reputación. Si no, se queda el botín.
publico fn robarCobrar(h: entero, saldo, empleo, pedido, cuerpo, animo, civil, terrP, estado, censoF, cuenta, s: entero, t: entero, nAg: entero, nTerr: entero, nFac: entero) {
  fijo p = h * 16
  fijo v = pedido[p + 6]
  si v >= 0 {
    fijo k = h // nAg
    fijo kf = k * nFac + terrP[(k * nTerr + civil[p]) * 16]
    fijo r = kf * 24
    fijo b = pedido[v * 16 + 8]
    var pol = 0
    si censoF[kf * 16] > 0 { pol = entero(censoF[kf * 16 + 4] * 1000 // censoF[kf * 16]) }
    var pr = pol * 0.06 * (100 - estado[r + 12]) / 100.0 * (100 - minimo(90, estado[r + 13])) / 100.0
    si pr > 0.9 { pr = 0.9 }
    si azarHilo(s + k, h % nAg, 510 + t // 3600 % 11) < pr {
      sumarAtomico(saldo, v, b)
      cuerpo[p + 14] = estado[r + 4]
      empleo[h] = -1
      animo[p + 9] = maximo(0, animo[p + 9] - 3000)
      sumarAtomico(cuenta, k * 48 + 15, 1)
    } sino {
      sumarAtomico(saldo, h, b)
    }
    pedido[p + 6] = -1
  }
}
publico fn cumplirCondena(h: entero, cuerpo) { si cuerpo[h * 16 + 14] > 0 { cuerpo[h * 16 + 14] = cuerpo[h * 16 + 14] - 1 } }

# ── el Estado: un hilo por facción
# [44] liderazgo: si no hay líder (murió, lo derrocaron), lo es quien tiene más
#      carisma [45], estatus y reputación entre los adultos de su facción que viven
#      en sus territorios.
# [62] ley: impuesto, castigo, antimonopolio, libertad de culto, frontera abierta,
#      subsidio, policías por cada mil, años para naturalizarse y religión del
#      Estado; salen del carácter del líder (egoísmo, agresividad, empatía,
#      tradicionalismo).
# [74] burocracia: la parte del gasto que no llega a nada; sube con el tamaño del
#      Estado, baja con la escritura [86] y la tecnología [78].
# [61] autoridad: el apoyo de los ciudadanos, el orden y el empleo.
# [73] corrupción: el líder sin moral se queda con parte de lo recaudado; a veces
#      se descubre (escándalo: cae la autoridad y puede caer él).
# Paga a sus funcionarios, contrata o despide según lo que tiene y lo que hace
# falta (en guerra, soldados), paga subsidios a los ciudadanos pobres y viejos, y
# hace obras: arregla rutas y, con escritura, bibliotecas [87]. Las obras se
# compran a la primera empresa de tecnología activa (elegirla por su inventario
# dependería del orden de los hilos); si no tiene, queda como pedido pendiente.
publico fn gobernar(kf: entero, vivo, saldo, empleo, cuerpo, civil, animo, rasgo, estado, censoF, terrP, censoT, activa, sector, inv, caja, precio, ventasHora, ingresosHora, consumido, cuenta, s: entero, t: entero, nAg: entero, nTerr: entero, nFac: entero, nEmp: entero, salario: entero) {
  fijo k = kf // nFac
  fijo f = kf % nFac
  fijo base = k * nAg
  fijo r = kf * 24
  fijo w = kf * 16
  var propios = 0
  para tt en rango(nTerr) { si terrP[(k * nTerr + tt) * 16] == f { propios = propios + 1 } }
  si propios > 0 {
    # ── el líder
    var li = estado[r + 1]
    var valido = 0
    si li >= 0 {
      fijo pl = li * 16
      si vivo[li] == 1 y cuerpo[pl] >= 25 y civil[pl + 6] == f y terrP[(k * nTerr + civil[pl]) * 16] == f { valido = 1 }
    }
    si valido == 0 {
      var mejor = -1
      var mejorP = -1
      para i en rango(nAg) {
        fijo h = base + i
        fijo p = h * 16
        si vivo[h] == 1 y cuerpo[p] >= 25 y civil[p + 6] == f y cuerpo[p + 14] == 0 y terrP[(k * nTerr + civil[p]) * 16] == f {
          fijo pt = rasgo[p] * 100 + animo[p + 11] + animo[p + 9] // 2
          si pt > mejorP {
            mejorP = pt
            mejor = h
          }
        }
      }
      li = mejor
      estado[r + 1] = li
    }
    si li >= 0 {
      fijo pl = li * 16
      # ── las leyes, del carácter del líder
      estado[r + 3] = 5 + (100 - rasgo[pl + 2]) // 5
      estado[r + 4] = 1 + rasgo[pl + 3] // 25
      estado[r + 5] = 0
      si rasgo[pl + 1] > 50 { estado[r + 5] = 1 }
      estado[r + 6] = 0
      si rasgo[pl + 4] < 60 { estado[r + 6] = 1 }
      estado[r + 7] = 0
      si rasgo[pl + 4] < 50 y rasgo[pl + 3] < 60 { estado[r + 7] = 1 }
      estado[r + 8] = 0
      si rasgo[pl + 1] > 40 { estado[r + 8] = 1 }
      estado[r + 9] = 5 + rasgo[pl + 3] // 10
      estado[r + 11] = 2 + rasgo[pl + 4] // 25
      estado[r + 10] = civil[pl + 5]
    }
    # ── la burocracia
    fijo pf = maximo(1, censoF[w])
    var bu = 10 + censoF[w + 12] * 1000 // pf // 2 - estado[r + 16] * 15 - (estado[r + 14] - 100) // 10
    estado[r + 12] = minimo(80, maximo(5, bu))
    # ── la autoridad
    var ad = 0
    var pa = 0
    var del = 0
    para tt en rango(nTerr) {
      fijo q = (k * nTerr + tt) * 16
      si terrP[q] == f {
        ad = ad + censoT[q + 7]
        pa = pa + censoT[q + 6]
        del = del + terrP[q + 7]
      }
    }
    fijo ciu = maximo(1, censoF[w + 1])
    fijo apoyo = censoF[w + 2] * 10000 // ciu
    fijo orden = maximo(0, 10000 - del * 100000 // pf)
    var empleoR = 10000
    si ad > 0 { empleoR = (ad - pa) * 10000 // ad }
    fijo au = (apoyo * 5 + orden * 2 + empleoR * 3) // 10 - estado[r + 18] * 1000
    estado[r + 18] = maximo(0, estado[r + 18] - 1)
    estado[r + 2] = minimo(10000, maximo(0, au))
    # ── la corrupción
    si li >= 0 {
      fijo moralL = animo[li * 16]
      si moralL < 4000 {
        var robado = estado[r + 17] * (4000 - moralL) // 8000
        si robado > estado[r] // 10 { robado = estado[r] // 10 }
        si robado > 0 {
          estado[r] = estado[r] - robado
          saldo[li] = saldo[li] + robado
          sumarAtomico(cuenta, k * 48 + 26, robado // 100)
          estado[r + 13] = minimo(90, estado[r + 13] + 5)
          si azarHilo(s + k, 9000 + f, 520 + t // 3600 % 13) < 0.15 {
            estado[r + 18] = estado[r + 18] + 3
            sumarAtomico(cuenta, k * 48 + 27, 1)
            si azarHilo(s + k, 9010 + f, 521 + t // 3600 % 13) < 0.5 { estado[r + 1] = -1 }
          }
        }
      } sino {
        estado[r + 13] = maximo(0, estado[r + 13] - 3)
      }
    }
    estado[r + 17] = 0
    # ── cuántos funcionarios hacen falta
    fijo objPol = pf * estado[r + 9] // 1000
    fijo objMae = censoF[w + 3] // 20
    fijo objMed = pf // 80
    var objSol = pf // 200
    si estado[r + 19] > 0 { objSol = pf * 4 // 100 }
    var objEsp = 1
    si estado[r + 19] > 0 { objEsp = 3 }
    # lo que se puede pagar: que queden en el tesoro dos años de nómina
    var cabe = estado[r] // (3 * salario)
    var nPol = 0
    var nMae = 0
    var nMed = 0
    var nSol = 0
    var nEsp = 0
    # pagar a los que hay (y despedir a los que sobran o no se pueden pagar)
    para i en rango(nAg) {
      fijo h = base + i
      fijo p = h * 16
      fijo ro = civil[p + 10]
      si ro > 0 y terrP[(k * nTerr + civil[p]) * 16] == f {
        var sigue = 0
        si vivo[h] == 1 y cuerpo[p + 14] == 0 y cabe > 0 {
          si ro == 1 y nPol < objPol {
            sigue = 1
            nPol = nPol + 1
          }
          si ro == 2 y nMae < objMae {
            sigue = 1
            nMae = nMae + 1
          }
          si ro == 3 y nMed < objMed {
            sigue = 1
            nMed = nMed + 1
          }
          si ro == 4 y nSol < objSol {
            sigue = 1
            nSol = nSol + 1
          }
          si ro == 5 y nEsp < objEsp {
            sigue = 1
            nEsp = nEsp + 1
          }
        }
        si sigue == 1 y estado[r] >= salario {
          estado[r] = estado[r] - salario
          saldo[h] = saldo[h] + salario
          cabe = cabe - 1
        } sino {
          civil[p + 10] = 0
        }
      }
    }
    # contratar a los que faltan: primero entre los ciudadanos adultos en paro; si
    # no alcanza, entre los que trabajan en una empresa (dejan el puesto)
    para vuelta en rango(2) {
    para i en rango(nAg) {
      fijo h = base + i
      fijo p = h * 16
      fijo ed = cuerpo[p]
      si cabe > 0 y vivo[h] == 1 y civil[p + 10] == 0 y (empleo[h] < 0 o vuelta == 1) y cuerpo[p + 14] == 0 y cuerpo[p + 15] == 0 y civil[p + 1] == 1 y ed >= 18 y ed < 60 y terrP[(k * nTerr + civil[p]) * 16] == f {
        var nuevo = 0
        si nSol < objSol y ed < 35 {
          nuevo = 4
          nSol = nSol + 1
        } sino si nPol < objPol {
          nuevo = 1
          nPol = nPol + 1
        } sino si nMed < objMed {
          nuevo = 3
          nMed = nMed + 1
        } sino si nMae < objMae {
          nuevo = 2
          nMae = nMae + 1
        } sino si nEsp < objEsp {
          nuevo = 5
          nEsp = nEsp + 1
        }
        si nuevo > 0 {
          civil[p + 10] = nuevo
          empleo[h] = -1
          cabe = cabe - 1
        }
      }
    }
    }
    # ── subsidios: a los ciudadanos pobres que no pueden trabajar (niños y viejos)
    #    o no encuentran trabajo, si la ley lo dice y el tesoro da (un 10 % por año)
    si estado[r + 8] == 1 {
      var bolsa = estado[r] // 10
      para i en rango(nAg) {
        fijo h = base + i
        fijo p = h * 16
        si bolsa >= salario // 2 y vivo[h] == 1 y civil[p + 1] == 1 y saldo[h] < salario // 2 y terrP[(k * nTerr + civil[p]) * 16] == f {
          si cuerpo[p] >= 65 o cuerpo[p] < 16 o (empleo[h] < 0 y civil[p + 10] == 0) {
            estado[r] = estado[r] - salario // 2
            saldo[h] = saldo[h] + salario // 2
            bolsa = bolsa - salario // 2
            sumarAtomico(cuenta, k * 48 + 30, 1)
          }
        }
      }
    }
    # ── obras: rutas y bibliotecas
    var proveedor = -1
    para e en rango(nEmp) {
      fijo ke = k * nEmp + e
      si proveedor < 0 y activa[ke] == 1 y sector[ke] == 2 { proveedor = ke }
    }
    si proveedor >= 0 {
      para tt en rango(nTerr) {
        fijo q = (k * nTerr + tt) * 16
        si terrP[q] == f {
          var unidades = 0
          si terrP[q + 1] < 70 { unidades = 20 }
          si estado[r + 16] == 1 y terrP[q + 5] == 0 { unidades = unidades + 30 }
          fijo coste = precio[proveedor] * unidades
          si unidades > 0 y estado[r] > coste + 20 * salario {
            estado[r] = estado[r] - coste
            sumarAtomico(caja, proveedor, coste)
            sumarAtomico(inv, proveedor, 0 - unidades)
            sumarAtomico(ventasHora, proveedor, unidades)
            sumarAtomico(ingresosHora, proveedor, coste)
            sumarAtomico(consumido, k, unidades)
            si terrP[q + 1] < 70 { terrP[q + 1] = minimo(100, terrP[q + 1] + 25) }
            si unidades >= 30 y terrP[q + 5] == 0 {
              terrP[q + 5] = 1
              sumarAtomico(cuenta, k * 48 + 29, 1)
            }
            sumarAtomico(cuenta, k * 48 + 28, 1)
          }
        }
      }
    }
  }
}

# ── las relaciones entre facciones, un hilo por economía
# [67] diplomacia: la relación (−100..100) sube con el comercio entre sus
#      territorios y con líderes carismáticos; baja con religiones de Estado
#      distintas, con líderes agresivos, con la guerra y con espías descubiertos.
#      Se va hacia 0 sola.
# [66] alianza: relación > 60. Los aliados no cobran aranceles, se abren la
#      frontera y suman la mitad de sus soldados en las guerras del otro.
# [68] espionaje: cada espía puede robar tecnología a quien va por delante; si lo
#      descubren, la relación cae 25 puntos.
# [65] guerra: dos facciones vecinas con relación < −50 y un líder agresivo. Cada
#      año hay batalla en la frontera: el poder es soldados × tecnología × suerte
#      (±30 %), más los aliados.
#      Las bajas las decide la batalla (mueren en «envejecer»). Con vez y media el
#      poder del otro, el territorio fronterizo cambia de dueño y se saquea. A los 8 años,
#      o sin frontera común, hay paz.
# [64] rebelión y [75] revolución: si los rebeldes pasan del 10 % hay disturbios
#      (saqueo); si pasan del 25 % hay revolución: el territorio pasa a la facción
#      que quieren los rebeldes o, si es la misma, cae el líder.
# [69] territorio y [70] frontera: quién es dueño de qué, y el frente de guerra.
publico fn relaciones(k: entero, relacion, guerraFF, comercioFF, terrP, estado, rasgo, civil, censoT, censoF, rebFacT, cuenta, s: entero, t: entero, nTerr: entero, nFac: entero) {
  fijo canal = t // 3600 % 23
  fijo c = k * 48
  para tt en rango(nTerr) {
    fijo q = (k * nTerr + tt) * 16
    terrP[q + 2] = 0
    terrP[q + 3] = 0
    terrP[q + 4] = 0
  }
  para f en rango(nFac) {
    estado[(k * nFac + f) * 24 + 19] = 0
    estado[(k * nFac + f) * 24 + 20] = 0
  }
  # diplomacia
  para f en rango(nFac) {
    para g en rango(nFac) {
      si f != g {
        fijo x = (k * nFac + f) * nFac + g
        var re = relacion[x]
        re = re + minimo(5, (comercioFF[x] + comercioFF[(k * nFac + g) * nFac + f]) // 200)
        si re > 0 { re = re - 2 } sino si re < 0 { re = re + 1 }
        fijo lf = estado[(k * nFac + f) * 24 + 1]
        fijo lg = estado[(k * nFac + g) * 24 + 1]
        si lf >= 0 y lg >= 0 {
          re = re + (rasgo[lf * 16] + rasgo[lg * 16] - 100) // 20
          si civil[lf * 16 + 5] != civil[lg * 16 + 5] { re = re - 3 }
          si rasgo[lf * 16 + 3] > 60 { re = re - 4 }
        }
        si guerraFF[x] > 0 { re = re - 5 }
        relacion[x] = minimo(100, maximo(-100, re))
      }
    }
  }
  para x en rango(nFac * nFac) { comercioFF[k * nFac * nFac + x] = 0 }
  # espionaje
  para f en rango(nFac) {
    fijo rf = (k * nFac + f) * 24
    fijo es = censoF[(k * nFac + f) * 16 + 8]
    si es > 0 {
      var mejor = -1
      para g en rango(nFac) { si g != f y estado[(k * nFac + g) * 24 + 14] > estado[rf + 14] { mejor = g } }
      si mejor >= 0 {
        fijo rg = (k * nFac + mejor) * 24
        si azarHilo(s + k, 9100 + f, 530 + canal) < minimo(5, es) * 0.1 {
          estado[rf + 14] = estado[rf + 14] + (estado[rg + 14] - estado[rf + 14]) // 5
          cuenta[c + 25] = cuenta[c + 25] + 1
        }
        si azarHilo(s + k, 9110 + f, 531 + canal) < 0.3 {
          fijo y = (k * nFac + mejor) * nFac + f
          relacion[y] = maximo(-100, relacion[y] - 25)
        }
      }
    }
  }
  # guerras: declarar, pelear, conquistar, hacer la paz
  para f en rango(nFac) {
    para g en rango(nFac) {
      si f < g {
        fijo x = (k * nFac + f) * nFac + g
        fijo y = (k * nFac + g) * nFac + f
        # ¿hay frontera común? (a de f junto a b de g, en cualquier orden)
        var a = -1
        var b = -1
        para tt en rango(nTerr) {
          fijo sig = (tt + 1) % nTerr
          fijo d1 = terrP[(k * nTerr + tt) * 16]
          fijo d2 = terrP[(k * nTerr + sig) * 16]
          si a < 0 y d1 == f y d2 == g {
            a = tt
            b = sig
          }
          si a < 0 y d1 == g y d2 == f {
            a = sig
            b = tt
          }
        }
        var gu = guerraFF[x]
        si gu == 0 y a >= 0 y relacion[x] < -50 y relacion[y] < -50 {
          fijo lf = estado[(k * nFac + f) * 24 + 1]
          fijo lg = estado[(k * nFac + g) * 24 + 1]
          var agresivo = 0
          si lf >= 0 { si rasgo[lf * 16 + 3] > 60 { agresivo = 1 } }
          si lg >= 0 { si rasgo[lg * 16 + 3] > 60 { agresivo = 1 } }
          si agresivo == 1 {
            gu = 1
            cuenta[c + 21] = cuenta[c + 21] + 1
          }
        }
        si gu > 0 {
          si a < 0 o gu > 8 {
            gu = 0
            relacion[x] = -20
            relacion[y] = -20
          } sino {
            gu = gu + 1
            fijo rf = (k * nFac + f) * 24
            fijo rg = (k * nFac + g) * 24
            estado[rf + 19] = 1
            estado[rg + 19] = 1
            terrP[(k * nTerr + a) * 16 + 4] = 1
            terrP[(k * nTerr + b) * 16 + 4] = 1
            fijo sf = censoF[(k * nFac + f) * 16 + 7]
            fijo sg = censoF[(k * nFac + g) * 16 + 7]
            # la suerte de la batalla: ±30 %
            var pf = entero(sf * estado[rf + 14] * (70 + piso(azarHilo(s + k, 9120 + f * 7 + g, 532 + canal) * 61)) // 10000)
            var pg = entero(sg * estado[rg + 14] * (70 + piso(azarHilo(s + k, 9130 + f * 7 + g, 533 + canal) * 61)) // 10000)
            # los aliados de cada uno (relación > 60 con uno y < 0 con el otro)
            para o en rango(nFac) {
              si o != f y o != g {
                fijo ko = k * nFac + o
                fijo so = censoF[ko * 16 + 7] * estado[ko * 24 + 14] // 200
                si relacion[ko * nFac + f] > 60 y relacion[ko * nFac + g] < 0 { pf = entero(pf + so) }
                si relacion[ko * nFac + g] > 60 y relacion[ko * nFac + f] < 0 { pg = entero(pg + so) }
              }
            }
            fijo tot = maximo(1, pf + pg)
            estado[rf + 20] = estado[rf + 20] + sf * pg // tot // 5
            estado[rg + 20] = estado[rg + 20] + sg * pf // tot // 5
            # la ruta de la frontera sufre
            fijo ruta = (k * nTerr + minimo(a, b)) * 16 + 1
            terrP[ruta] = maximo(0, terrP[ruta] - 30)
            si pf * 2 > pg * 3 y pf > 0 {
              terrP[(k * nTerr + b) * 16] = f
              terrP[(k * nTerr + b) * 16 + 2] = 20
              cuenta[c + 22] = cuenta[c + 22] + 1
            } sino si pg * 2 > pf * 3 y pg > 0 {
              terrP[(k * nTerr + a) * 16] = g
              terrP[(k * nTerr + a) * 16 + 2] = 20
              cuenta[c + 22] = cuenta[c + 22] + 1
            }
          }
        }
        guerraFF[x] = gu
        guerraFF[y] = gu
      }
    }
  }
  # rebeliones y revoluciones
  para tt en rango(nTerr) {
    fijo kt = k * nTerr + tt
    fijo q = kt * 16
    fijo pob = censoT[q]
    fijo reb = censoT[q + 2]
    si pob > 20 y reb * 10 > pob {
      cuenta[c + 23] = cuenta[c + 23] + 1
      terrP[q + 2] = maximo(terrP[q + 2], 5)
      si reb * 4 > pob {
        var quiere = 0
        var qn = -1
        para f en rango(nFac) {
          si rebFacT[kt * nFac + f] > qn {
            qn = rebFacT[kt * nFac + f]
            quiere = f
          }
        }
        fijo dueno = terrP[q]
        si quiere != dueno {
          terrP[q] = quiere
        } sino {
          estado[(k * nFac + dueno) * 24 + 1] = -1
          estado[(k * nFac + dueno) * 24 + 2] = 6000
        }
        terrP[q + 3] = 1
        cuenta[c + 24] = cuenta[c + 24] + 1
      }
    }
  }
}

# ── lo que se pierde de los inventarios. Modo 0, cada día: la plaga en la comida
# [94] y el desastre [96]. Modo 1, cada año: el saqueo de la guerra o de los
# disturbios [65][64]. Un hilo por empresa; lo perdido cuenta como bien destruido.
publico fn perderInventario(h: entero, activa, sector, inv, terrEmp, terrP, clima, destruido, modo: entero, nEmp: entero, nTerr: entero) {
  si activa[h] == 1 y inv[h] > 0 {
    fijo k = h // nEmp
    fijo q = (k * nTerr + terrEmp[h]) * 16
    var pct = 0
    si modo == 1 { pct = terrP[q + 2] }
    sino {
      si sector[h] == 1 y clima[q + 8] > 0 { pct = pct + 30 }
      si clima[q + 9] > 0 { pct = pct + 20 }
    }
    si pct > 90 { pct = 90 }
    si pct > 0 {
      fijo x = inv[h] * pct // 100
      inv[h] = inv[h] - x
      sumarAtomico(destruido, k, x)
    }
  }
}
