fn mochila_run() {
  var n = 1500.0
  var cap = 20000.0
  var w = nuevaM(n)
  var v = nuevaM(n)
  var x = 31.0
  {
    var i = 0.0
    fijo fin_i = n
    mientras i < fin_i {
      x = mochila_lcg(x)
      w[i] = (1 + (x % 50))
      x = mochila_lcg(x)
      v[i] = (x % 100)
      i = i + 1
    }
  }
  var dp = nuevaM((cap + 1))
  {
    var i = 0.0
    fijo fin_i = n
    mientras i < fin_i {
      var c = cap + 0.0
      mientras c >= w[i] {
        var cand = (dp[(c - w[i])] + v[i]) + 0.0
        si cand > dp[c] {
          dp[c] = cand
        }
        c = (c - 1)
      }
      i = i + 1
    }
  }
  devolver dp[cap]
}
fn floyd_lcg(x) {
  devolver ((x * 16807) % 2147483647)
}
fn floyd_run() {
  var n = 350.0
  var d = nueva((n * n))
  var x = 11.0
  {
    var i = 0.0
    fijo fin_i = n
    mientras i < fin_i {
      {
        var j = 0.0
        fijo fin_j = n
        mientras j < fin_j {
          x = floyd_lcg(x)
          d[((i * n) + j)] = (1 + (x % 1000))
          si i == j {
            d[((i * n) + j)] = 0
          }
          j = j + 1
        }
      }
      i = i + 1
    }
  }
  {
    var k = 0.0
    fijo fin_k = n
    mientras k < fin_k {
      {
        var i = 0.0
        fijo fin_i = n
        mientras i < fin_i {
          {
            var j = 0.0
            fijo fin_j = n
            mientras j < fin_j {
              var cand = (d[((i * n) + k)] + d[((k * n) + j)]) + 0.0
              si cand < d[((i * n) + j)] {
                d[((i * n) + j)] = cand
              }
              j = j + 1
            }
          }
          i = i + 1
        }
      }
      k = k + 1
    }
  }
  var c = 0.0
  {
    var i = 0.0
    fijo fin_i = (n * n)
    mientras i < fin_i {
      c = ((c + d[i]) % 1000000007)
      i = i + 1
    }
  }
  devolver c
}
fn tak_tak(a, b, c) {
  si b < a {
    devolver tak_tak(tak_tak((a - 1), b, c), tak_tak((b - 1), c, a), tak_tak((c - 1), a, b))
  }
  devolver c
}
fn tak_run() {
  devolver tak_tak(30, 20, 10)
}
fn hanoi_mueve(n, a) {
  si n == 0 {
    devolver (a % 2)
  }
  devolver ((hanoi_mueve((n - 1), (a + 1)) + hanoi_mueve((n - 1), (a + 2))) + 1)
}
fn hanoi_run() {
  devolver hanoi_mueve(25, 0)
}
fn medir(nombre, f) {
  fijo t0 = reloj()
  fijo r = f()
  imprimir(nombre + " = " + texto(r) + " en " + texto(redondear(reloj() - t0, 0)) + " ms")
}
medir("matmul", funcion() { devolver matmul_run() })
medir("nbody", funcion() { devolver nbody_run() })
