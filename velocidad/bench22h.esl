fn quicksort_qsort(a, lo, hi) {
  si lo < hi {
    var p = a[(((lo + hi)) // (2))] + 0.0
    var i = lo + 0.0
    var j = hi + 0.0
    mientras i <= j {
      mientras a[i] < p {
        i = (i + 1)
      }
      mientras a[j] > p {
        j = (j - 1)
      }
      si i <= j {
        var t = a[i] + 0.0
        a[i] = a[j]
        a[j] = t
        i = (i + 1)
        j = (j - 1)
      }
    }
    quicksort_qsort(a, lo, j)
    quicksort_qsort(a, i, hi)
  }
}
