usar redondear, ceros, suma de "numerico"
usar paralelo, usarDispositivo, dispositivo de "nen"

# Un hilo por píxel: el mismo Mandelbrot 400×300×200 del benchmark.
fn mandel(i, ancho, alto, maxIter, r) {
  fijo px = i % ancho
  fijo py = i // ancho
  fijo cr = (px / ancho) * 3.5 - 2.5
  fijo ci = (py / alto) * 2.0 - 1.0
  var zr = 0.0
  var zi = 0.0
  var k = 0
  mientras k < maxIter y zr * zr + zi * zi <= 4.0 {
    fijo t = zr * zr - zi * zi + cr
    zi = 2.0 * zr * zi + ci
    zr = t
    k = k + 1
  }
  si k == maxIter { r[i] = 1 } sino { r[i] = 0 }
}

fn medirEn(d) {
  usarDispositivo(d)
  var r = ceros(400 * 300, "entero")
  paralelo(400 * 300, mandel, 400, 300, 200, r)      # primera: compila
  fijo t0 = reloj()
  paralelo(400 * 300, mandel, 400, 300, 200, r)
  fijo ms = reloj() - t0
  imprimir(dispositivo(), "→", suma(r), "en", redondear(ms), "ms")
}
medirEn("jit")
medirEn("nativo")
